<?xml version="1.0"?>
<!-- A titlebar with no borders, in rows: 2 wholly clear, 2 opaque, the rest half see-through. Test data only (ADR 0048): see tests/themes/README.md. -->
<metacity_theme>
  <info>
    <name>EsmerilSeeThrough</name>
    <author>The Caminito authors</author>
    <copyright>GPL-3.0-or-later</copyright>
    <date>2026</date>
    <description>A titlebar with no borders, in rows: 2 wholly clear, 2 opaque, the rest half see-through.</description>
  </info>

  <frame_geometry name="normal">
    <distance name="left_width" value="0"/>
    <distance name="right_width" value="0"/>
    <distance name="bottom_height" value="0"/>
    <distance name="left_titlebar_edge" value="4"/>
    <distance name="right_titlebar_edge" value="4"/>
    <distance name="title_vertical_pad" value="3"/>
    <aspect_ratio name="button" value="1.0"/>
    <border name="title_border" left="6" right="6" top="4" bottom="3"/>
    <border name="button_border" left="1" right="1" top="3" bottom="3"/>
  </frame_geometry>

  <frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false">
    <distance name="left_width" value="0"/>
    <distance name="right_width" value="0"/>
    <distance name="bottom_height" value="0"/>
    <distance name="left_titlebar_edge" value="0"/>
    <distance name="right_titlebar_edge" value="0"/>
  </frame_geometry>

  <frame_geometry name="utility" parent="normal" title_scale="small"/>

  <frame_geometry name="border" has_title="false">
    <distance name="left_width" value="4"/>
    <distance name="right_width" value="4"/>
    <distance name="bottom_height" value="4"/>
    <distance name="left_titlebar_edge" value="0"/>
    <distance name="right_titlebar_edge" value="0"/>
    <distance name="title_vertical_pad" value="4"/>
    <distance name="button_width" value="0"/>
    <distance name="button_height" value="0"/>
    <border name="title_border" left="0" right="0" top="0" bottom="0"/>
    <border name="button_border" left="0" right="0" top="0" bottom="0"/>
  </frame_geometry>

  <constant name="Outline" value="blend/gtk:bg[NORMAL]/gtk:fg[NORMAL]/0.4"/>
  <constant name="GlyphInset" value="5"/>

  <!-- The frame and its titlebar. -->

  <draw_ops name="frame">
    <rectangle color="#204060" filled="true" x="0" y="2" width="width" height="2"/>
    <tint color="#000000" alpha="0.5" x="0" y="4" width="width" height="height - 4"/>
  </draw_ops>

  <draw_ops name="titlebar_focused">
    <rectangle color="shade/gtk:bg[NORMAL]/0.9" filled="true" x="1" y="1" width="width - 2" height="height - 1"/>
  </draw_ops>

  <draw_ops name="title_focused">
    <title color="gtk:fg[NORMAL]" x="0" y="(height - title_height) / 2"/>
  </draw_ops>

  <draw_ops name="title_unfocused">
    <title color="gtk:fg[INSENSITIVE]" x="0" y="(height - title_height) / 2"/>
  </draw_ops>

  <!-- Buttons: a glyph, over a background when hovered or pressed. -->

  <draw_ops name="prelight_bg">
    <rectangle color="shade/gtk:bg[NORMAL]/1.1" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <draw_ops name="pressed_bg">
    <rectangle color="shade/gtk:bg[NORMAL]/0.75" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <draw_ops name="close_glyph">
    <line color="gtk:fg[NORMAL]" width="2" x1="GlyphInset" y1="GlyphInset" x2="width - GlyphInset" y2="height - GlyphInset"/>
    <line color="gtk:fg[NORMAL]" width="2" x1="width - GlyphInset" y1="GlyphInset" x2="GlyphInset" y2="height - GlyphInset"/>
  </draw_ops>

  <draw_ops name="maximize_glyph">
    <rectangle color="gtk:fg[NORMAL]" x="GlyphInset" y="GlyphInset" width="width - GlyphInset * 2 - 1" height="height - GlyphInset * 2 - 1"/>
    <line color="gtk:fg[NORMAL]" x1="GlyphInset" y1="GlyphInset + 1" x2="width - GlyphInset - 1" y2="GlyphInset + 1"/>
  </draw_ops>

  <draw_ops name="minimize_glyph">
    <line color="gtk:fg[NORMAL]" width="2" x1="GlyphInset" y1="height - GlyphInset - 1" x2="width - GlyphInset" y2="height - GlyphInset - 1"/>
  </draw_ops>

  <draw_ops name="menu_glyph">
    <line color="gtk:fg[NORMAL]" x1="GlyphInset" y1="height / 2 - 2" x2="width - GlyphInset" y2="height / 2 - 2"/>
    <line color="gtk:fg[NORMAL]" x1="GlyphInset" y1="height / 2" x2="width - GlyphInset" y2="height / 2"/>
    <line color="gtk:fg[NORMAL]" x1="GlyphInset" y1="height / 2 + 2" x2="width - GlyphInset" y2="height / 2 + 2"/>
  </draw_ops>

  <!-- Shade, above and stick, and their opposites, share one glyph. -->
  <draw_ops name="toggle_glyph">
    <rectangle color="gtk:fg[NORMAL]" filled="true" x="width / 2 - 2" y="height / 2 - 2" width="4" height="4"/>
  </draw_ops>

  <draw_ops name="close_prelight"><include name="prelight_bg"/><include name="close_glyph"/></draw_ops>
  <draw_ops name="close_pressed"><include name="pressed_bg"/><include name="close_glyph"/></draw_ops>
  <draw_ops name="maximize_prelight"><include name="prelight_bg"/><include name="maximize_glyph"/></draw_ops>
  <draw_ops name="maximize_pressed"><include name="pressed_bg"/><include name="maximize_glyph"/></draw_ops>
  <draw_ops name="minimize_prelight"><include name="prelight_bg"/><include name="minimize_glyph"/></draw_ops>
  <draw_ops name="minimize_pressed"><include name="pressed_bg"/><include name="minimize_glyph"/></draw_ops>
  <draw_ops name="menu_prelight"><include name="prelight_bg"/><include name="menu_glyph"/></draw_ops>
  <draw_ops name="menu_pressed"><include name="pressed_bg"/><include name="menu_glyph"/></draw_ops>
  <draw_ops name="toggle_prelight"><include name="prelight_bg"/><include name="toggle_glyph"/></draw_ops>
  <draw_ops name="toggle_pressed"><include name="pressed_bg"/><include name="toggle_glyph"/></draw_ops>

  <!-- Styles. -->

  <frame_style name="focused" geometry="normal">
    <piece position="entire_background" draw_ops="frame"/>
    <button function="close" state="normal" draw_ops="close_glyph"/>
    <button function="close" state="prelight" draw_ops="close_prelight"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="maximize" state="normal" draw_ops="maximize_glyph"/>
    <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
    <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
    <button function="minimize" state="normal" draw_ops="minimize_glyph"/>
    <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="menu" state="normal" draw_ops="menu_glyph"/>
    <button function="menu" state="prelight" draw_ops="menu_prelight"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="shade" state="normal" draw_ops="toggle_glyph"/>
    <button function="shade" state="prelight" draw_ops="toggle_prelight"/>
    <button function="shade" state="pressed" draw_ops="toggle_pressed"/>
    <button function="unshade" state="normal" draw_ops="toggle_glyph"/>
    <button function="unshade" state="prelight" draw_ops="toggle_prelight"/>
    <button function="unshade" state="pressed" draw_ops="toggle_pressed"/>
    <button function="above" state="normal" draw_ops="toggle_glyph"/>
    <button function="above" state="prelight" draw_ops="toggle_prelight"/>
    <button function="above" state="pressed" draw_ops="toggle_pressed"/>
    <button function="unabove" state="normal" draw_ops="toggle_glyph"/>
    <button function="unabove" state="prelight" draw_ops="toggle_prelight"/>
    <button function="unabove" state="pressed" draw_ops="toggle_pressed"/>
    <button function="stick" state="normal" draw_ops="toggle_glyph"/>
    <button function="stick" state="prelight" draw_ops="toggle_prelight"/>
    <button function="stick" state="pressed" draw_ops="toggle_pressed"/>
    <button function="unstick" state="normal" draw_ops="toggle_glyph"/>
    <button function="unstick" state="prelight" draw_ops="toggle_prelight"/>
    <button function="unstick" state="pressed" draw_ops="toggle_pressed"/>
  </frame_style>

  <frame_style name="unfocused" parent="focused">
  </frame_style>

  <frame_style name="maximized_focused" parent="focused" geometry="maximized"/>
  <frame_style name="maximized_unfocused" parent="unfocused" geometry="maximized"/>
  <frame_style name="utility_focused" parent="focused" geometry="utility"/>
  <frame_style name="utility_unfocused" parent="unfocused" geometry="utility"/>
  <frame_style name="border" parent="focused" geometry="border"/>

  <!-- Style sets. -->

  <frame_style_set name="normal">
    <frame focus="yes" state="normal" resize="both" style="focused"/>
    <frame focus="no" state="normal" resize="both" style="unfocused"/>
    <frame focus="yes" state="maximized" style="maximized_focused"/>
    <frame focus="no" state="maximized" style="maximized_unfocused"/>
    <frame focus="yes" state="shaded" style="focused"/>
    <frame focus="no" state="shaded" style="unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="maximized_focused"/>
    <frame focus="no" state="maximized_and_shaded" style="maximized_unfocused"/>
  </frame_style_set>

  <frame_style_set name="utility">
    <frame focus="yes" state="normal" resize="both" style="utility_focused"/>
    <frame focus="no" state="normal" resize="both" style="utility_unfocused"/>
    <frame focus="yes" state="maximized" style="maximized_focused"/>
    <frame focus="no" state="maximized" style="maximized_unfocused"/>
    <frame focus="yes" state="shaded" style="utility_focused"/>
    <frame focus="no" state="shaded" style="utility_unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="maximized_focused"/>
    <frame focus="no" state="maximized_and_shaded" style="maximized_unfocused"/>
  </frame_style_set>

  <frame_style_set name="border">
    <frame focus="yes" state="normal" resize="both" style="border"/>
    <frame focus="no" state="normal" resize="both" style="border"/>
    <frame focus="yes" state="maximized" style="border"/>
    <frame focus="no" state="maximized" style="border"/>
    <frame focus="yes" state="shaded" style="border"/>
    <frame focus="no" state="shaded" style="border"/>
    <frame focus="yes" state="maximized_and_shaded" style="border"/>
    <frame focus="no" state="maximized_and_shaded" style="border"/>
  </frame_style_set>

  <window type="normal" style_set="normal"/>
  <window type="dialog" style_set="normal"/>
  <window type="modal_dialog" style_set="normal"/>
  <window type="menu" style_set="normal"/>
  <window type="utility" style_set="utility"/>
  <window type="border" style_set="border"/>
</metacity_theme>
