{
  "themes": ["Menta", "ClearlooksRe", "Atlanta", "eOS", "HighContrast", "BlackMATE", "TraditionalOk", "Arc", "Mint-Y", "Yaru"],
  "scales": [1, 2],
  "gtk_theme": "Adwaita",
  "font": "Noto Sans Bold 10",
  "dpi": 96,
  "antialias": "gray",
  "hint_style": "slight",
  "hint_metrics": "on",
  "language": "en-us",
  "title": "Caminito golden window",
  "mini_icon": "icons/mini-icon.png",
  "icon": "icons/icon.png",
  "client_width": 360,
  "client_height": 48,
  "base": {
    "type": "normal",
    "flags": [
      "allows_delete",
      "allows_menu",
      "allows_minimize",
      "allows_maximize",
      "allows_vertical_resize",
      "allows_horizontal_resize",
      "has_focus",
      "allows_shade",
      "allows_move"
    ],
    "button_layout": "menu:minimize,maximize,close",
    "button_states": {}
  },
  "cases": [
    { "name": "normal" },
    { "name": "dialog", "type": "dialog" },
    { "name": "modal-dialog", "type": "modal_dialog" },
    { "name": "utility", "type": "utility" },
    { "name": "border", "type": "border" },
    { "name": "unfocused", "remove_flags": ["has_focus"] },
    { "name": "maximized", "add_flags": ["maximized"] },
    { "name": "shaded", "add_flags": ["shaded"] },
    { "name": "tiled-left", "add_flags": ["tiled_left"] },
    { "name": "tiled-right", "add_flags": ["tiled_right"] },
    { "name": "all-buttons", "button_layout": "menu,shade,above,stick:minimize,maximize,close" },
    { "name": "all-buttons-toggled", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"] },
    { "name": "menu-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "menu": "prelight" } },
    { "name": "menu-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "menu": "pressed" } },
    { "name": "shade-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "shade": "prelight" } },
    { "name": "shade-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "shade": "pressed" } },
    { "name": "above-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "above": "prelight" } },
    { "name": "above-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "above": "pressed" } },
    { "name": "stick-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "stick": "prelight" } },
    { "name": "stick-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "stick": "pressed" } },
    { "name": "minimize-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "minimize": "prelight" } },
    { "name": "minimize-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "minimize": "pressed" } },
    { "name": "maximize-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "maximize": "prelight" } },
    { "name": "maximize-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "maximize": "pressed" } },
    { "name": "close-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "close": "prelight" } },
    { "name": "close-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "button_states": { "close": "pressed" } },
    { "name": "unshade-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unshade": "prelight" } },
    { "name": "unshade-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unshade": "pressed" } },
    { "name": "unabove-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unabove": "prelight" } },
    { "name": "unabove-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unabove": "pressed" } },
    { "name": "unstick-prelight", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unstick": "prelight" } },
    { "name": "unstick-pressed", "button_layout": "menu,shade,above,stick:minimize,maximize,close", "add_flags": ["shaded", "above", "stuck"], "button_states": { "unstick": "pressed" } },
    { "name": "unmaximize-prelight", "add_flags": ["maximized"], "button_states": { "maximize": "prelight" } },
    { "name": "unmaximize-pressed", "add_flags": ["maximized"], "button_states": { "maximize": "pressed" } }
  ]
}
