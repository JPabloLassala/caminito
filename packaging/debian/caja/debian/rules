#!/usr/bin/make -f
# Ubuntu 26.04's caja rules, at 1.28.0 (200). The differences: --enable-wayland, the tests,
# and the apt pin.

include /usr/share/dpkg/pkg-info.mk

DHFLAGS=--parallel

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ $(DHFLAGS) --with gir --without autoreconf

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	rm -fv debian/tmp/usr/lib/*/*.la
	rm -rfv debian/tmp/usr/share/omf/
	rm -rfv debian/tmp/usr/share/help/
	mkdir -p debian/tmp/usr/share/doc/libcaja-extension-doc/
	mv debian/tmp/usr/share/gtk-doc/html/libcaja-extension debian/tmp/usr/share/doc/libcaja-extension-doc/html
	dh_install

# The pin of ADR 0029: every binary package of this source, at a caminito version, before any
# other, and Ubuntu's versions of them at 99: an upgrade keeps the patched package, and asking
# for Ubuntu's by its version still installs it. The version is a regex: apt matches no version
# to the glob `*caminito*`, and the regex gives 1001 to a .deb installed from a file too (195).
# Copied from mate-panel's (196), with this package's name.
execute_after_dh_install:
	mkdir -p debian/caja/etc/apt/preferences.d
	packages="$$(sed -n 's/^Package: //p' debian/control | xargs)"; \
	printf 'Package: %s\nPin: version /caminito/\nPin-Priority: 1001\n\nPackage: %s\nPin: release o=Ubuntu\nPin-Priority: 99\n' \
		"$$packages" "$$packages" > debian/caja/etc/apt/preferences.d/caminito-$(DEB_SOURCE)

# --enable-wayland: Ubuntu's builds without gtk-layer-shell, so its desktop isn't a layer
# surface, and the carried patches change that surface's code.
override_dh_auto_configure:
	# we need libegg from mate-submodules
	cd mate-submodules/; tar xvJf /usr/src/mate-submodules-source.tar.xz
	# upstream tarball is without configure. autogen.sh will create it
	NOCONFIGURE=1 ./autogen.sh
	dh_auto_configure $(DHFLAGS) -- \
		--disable-silent-rules \
		--libexecdir=/usr/lib/caja \
		--includedir=/usr/include/$(dpkg-architecture -qDEB_BUILD_MULTIARCH) \
		--disable-update-mimedb \
		--disable-static \
		--localstatedir=/var \
		--enable-introspection \
		--enable-gtk-doc \
		--enable-wayland

# Ubuntu's skips the tests. They are eel's check program and `caja --check`, which open a
# display, so they run on Xvfb with a session bus of their own, and caja's schemas, which
# aren't installed yet, compiled from the tree.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	rm -rf debian/test-schemas
	install -d debian/test-schemas
	cp libcaja-private/*.gschema.xml debian/test-schemas/
	glib-compile-schemas debian/test-schemas
	GSETTINGS_SCHEMA_DIR=$(CURDIR)/debian/test-schemas GSETTINGS_BACKEND=memory \
		xvfb-run -a dbus-run-session -- dh_auto_test $(DHFLAGS)
endif

override_dh_auto_clean:
	dh_auto_clean
	rm -rf debian/test-schemas

override_dh_installchangelogs:
	dh_installchangelogs NEWS

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
