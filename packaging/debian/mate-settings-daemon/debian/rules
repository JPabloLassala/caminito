#!/usr/bin/make -f
# Ubuntu 26.04's mate-settings-daemon rules, at 1.29.1 (CMN-128). The differences:
# --enable-wayland and the apt pin.

include /usr/share/dpkg/pkg-info.mk

DHFLAGS=--parallel

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

DEB_HOST_ARCH_OS?=$(shell dpkg-architecture -qDEB_HOST_ARCH_OS)
ifeq (,$(filter linux, $(DEB_HOST_ARCH_OS)))
WITHOUT_RFKILL = "--disable-rfkill"
export deb_udevdir =
else
WITHOUT_RFKILL = ""
export deb_udevdir = $(shell pkg-config --variable=udevdir udev | sed s,^/,,)
endif


%:
	dh $@ $(DHFLAGS) --without autoreconf

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	rm -rf debian/tmp/usr/lib/*/mate-settings-daemon/*.la
	dh_install

# The pin of ADR 0029: every binary package of this source, at a caminito version, before any
# other, and Ubuntu's versions of them at 99. Copied from caja's, with this package's name.
execute_after_dh_install:
	mkdir -p debian/mate-settings-daemon/etc/apt/preferences.d
	packages="$$(sed -n 's/^Package: //p' debian/control | xargs)"; \
	printf 'Package: %s\nPin: version /caminito/\nPin-Priority: 1001\n\nPackage: %s\nPin: release o=Ubuntu\nPin-Priority: 99\n' \
		"$$packages" "$$packages" > debian/mate-settings-daemon/etc/apt/preferences.d/caminito-$(DEB_SOURCE)

# --enable-wayland makes a missing Wayland library an error. Without it, configure turns the
# wlrandr plugin and the Wayland background and clipboard off and says nothing.
override_dh_auto_configure:
	# upstream tarball is without configure. autogen.sh will create it
	NOCONFIGURE=1 ./autogen.sh
	dh_auto_configure $(DHFLAGS) -- \
		--disable-silent-rules \
		--libexecdir=/usr/libexec \
		--disable-static \
	        $(WITHOUT_RFKILL) \
		--enable-pulse \
		--enable-wayland

override_dh_makeshlibs:

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
