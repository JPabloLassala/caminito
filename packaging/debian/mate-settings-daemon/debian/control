# Ubuntu 26.04's mate-settings-daemon 1.26.1-1.2build1, at 1.29.1 with Caminito's carried
# patches (ADR 0029). The differences from Ubuntu's: debhelper-compat 13, as the other patched
# packages; libmate-desktop-dev at 1.27.1, what configure.ac asks for once 0004 is in (0004
# goes when Ubuntu's mate-desktop is 1.29);
# libayatana-appindicator3-dev, libgtk-layer-shell-dev, libwayland-dev and wayland-protocols,
# for the Wayland background, clipboard and wlrandr plugin (rules passes --enable-wayland); and
# no libdbus-glib-1-dev, here or in mate-settings-daemon-dev's Depends: since b99fca7, upstream
# uses GDBus, and mate-settings-client.h is gone.
Build-Depends: debhelper-compat (= 13),
               dh-exec,
               dpkg-dev (>= 1.16.1.1),
               intltool,
               libayatana-appindicator3-dev,
               libcanberra-gtk3-dev,
               libdconf-dev,
               libfontconfig-dev,
               libglib2.0-dev,
               libgtk-3-dev,
               libgtk-layer-shell-dev (>= 0.6),
               libmate-desktop-dev (>= 1.27.1),
               libmatekbd-dev (>= 1.24),
               libmatemixer-dev (>= 1.24),
               libnotify-dev,
               libnss3-dev,
               libpolkit-agent-1-dev,
               libpolkit-gobject-1-dev,
               libpulse-dev,
               librda-dev (>= 0.0.3),
               libstartup-notification0-dev,
