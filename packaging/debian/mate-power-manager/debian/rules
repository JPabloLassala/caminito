#!/usr/bin/make -f
# Ubuntu 26.04's mate-power-manager rules, at 1.28.1 (CMN-126). The difference: the apt pin.

include /usr/share/dpkg/pkg-info.mk

DHFLAGS=--parallel

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ $(DHFLAGS) --without autoreconf

override_dh_missing:
	dh_missing --fail-missing

override_dh_install:
	dh_install
	# Ubuntu MATE enables indicators by default which include indicator-power
	# so override mate-power-manager defaults accordingly.
ifeq ($(shell dpkg-vendor --is Ubuntu && echo yes),yes)
	dh_install -pmate-power-manager-common debian/25_mate-power-manager-ubuntu.gschema.override /usr/share/glib-2.0/schemas/
endif

# The pin of ADR 0029: every binary package of this source, at a caminito version, before any
# other, and Ubuntu's versions of them at 99. Copied from caja's, with this package's name.
execute_after_dh_install:
	mkdir -p debian/mate-power-manager/etc/apt/preferences.d
	packages="$$(sed -n 's/^Package: //p' debian/control | xargs)"; \
	printf 'Package: %s\nPin: version /caminito/\nPin-Priority: 1001\n\nPackage: %s\nPin: release o=Ubuntu\nPin-Priority: 99\n' \
		"$$packages" "$$packages" > debian/mate-power-manager/etc/apt/preferences.d/caminito-$(DEB_SOURCE)

override_dh_installchangelogs:
	dh_installchangelogs NEWS

override_dh_auto_configure:
	# Ubuntu MATE enables indicators by default which include indicator-power
	# so patch disable some UI in mate-power-manager that is irrelevant

	# upstream is without configure. autogen.sh will create it
	NOCONFIGURE=1 ./autogen.sh
	dh_auto_configure $(DHFLAGS) -- \
		--disable-silent-rules \
		--libexecdir=/usr/libexec/mate-power-manager \
		--enable-applets \
		--without-keyring \
		--enable-deprecated

get-orig-source:
	uscan --noconf --force-download --rename --download-current-version --destdir=..
