XSBC-Original-Maintainer: Debian+Ubuntu MATE Packaging Team <debian-mate@lists.debian.org>
# Ubuntu 26.04's mate-utils 1.26.1-1build5, at 1.29.1 with Caminito's carried patch
# (ADR 0029). The differences from Ubuntu's: libmate-panel-applet-dev at mate-panel's master
# (196), so the dictionary applet, built into the panel's process, links
# libmate-panel-applet-4.so.2; libmate-desktop-dev at 1.27.1, what configure.ac asks for;
# libgtk-layer-shell-dev, libwayland-dev and wayland-protocols, for mate-screenshot's Wayland
# capture and the applet on a Wayland panel (rules passes --enable-wayland); and no
# mate-submodules-source: the 1.29.1 tarball has libegg.
Build-Depends: debhelper-compat (= 13),
               dpkg-dev (>= 1.16.1.1),
               gtk-doc-tools,
               intltool,
               libcanberra-gtk3-dev,
               libglib2.0-dev,
               libgtk-3-dev,
               libgtk-layer-shell-dev (>= 0.6),
               libgtop2-dev,
