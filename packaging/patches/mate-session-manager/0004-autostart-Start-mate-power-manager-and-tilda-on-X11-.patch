From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Mon, 5 Oct 2026 13:05:51 -0300
Subject: [PATCH] autostart: Start mate-power-manager and tilda on X11 under
 Caminito

Under Caminito, the Wayland compositor for MATE, mate-session unsets
GDK_BACKEND, so what it starts opens GDK on Wayland. mate-power-manager
calls XKeysymToKeycode as it grabs its keys, without checking for an X
display, and dies with SIGSEGV at every login. tilda, the pull-down
terminal that mate-tweak autostarts, calls GDK's X11 functions as it grabs
its key, and does the same.

Caminito has no stand-in for either, so they should run. Give their
autostart entries GDK_BACKEND=x11 when MATE_WM_NAME is Caminito, so they
start on XWayland. Without that variable, nothing changes.
---
 mate-session/gsm-autostart-app.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/mate-session/gsm-autostart-app.c b/mate-session/gsm-autostart-app.c
index b441a4c..5f39593 100644
--- a/mate-session/gsm-autostart-app.c
+++ b/mate-session/gsm-autostart-app.c
@@ -123,6 +123,14 @@ static const char * const caminito_skipped_ids[] = {
         NULL
 };
 
+/* Autostart entries that are X11-only, and that Caminito has no stand-in for.
+ * Under Caminito they start on XWayland. */
+static const char * const caminito_x11_ids[] = {
+        "mate-power-manager.desktop",
+        "tilda.desktop",                  /* mate-tweak's pull-down terminal */
+        NULL
+};
+
 static gboolean
 is_under_caminito (void)
 {
@@ -879,7 +887,7 @@ static gboolean
 autostart_app_start_spawn (GsmAutostartApp *app,
                            GError         **error)
 {
-        char            *env[2] = { NULL, NULL };
+        char            *env[3] = { NULL, NULL, NULL };
         gboolean         success;
         GError          *local_error;
         const char      *startup_id;
@@ -892,6 +900,14 @@ autostart_app_start_spawn (GsmAutostartApp *app,
 
         env[0] = g_strdup_printf ("DESKTOP_AUTOSTART_ID=%s", startup_id);
 
+        /* mate-session unsets GDK_BACKEND under Caminito, so its children open GDK
+         * on Wayland. An X11-only one gets the variable back. */
+        if (is_under_caminito () && priv->desktop_id != NULL &&
+            g_strv_contains (caminito_x11_ids, priv->desktop_id)) {
+                g_debug ("GsmAutostartApp: starting %s on X11 under Caminito", priv->desktop_id);
+                env[1] = g_strdup ("GDK_BACKEND=x11");
+        }
+
         local_error = NULL;
         command = egg_desktop_file_parse_exec (priv->desktop_file,
                                                NULL,
@@ -917,6 +933,7 @@ autostart_app_start_spawn (GsmAutostartApp *app,
                                            EGG_DESKTOP_FILE_LAUNCH_RETURN_STARTUP_ID, &priv->startup_id,
                                            NULL);
         g_free (env[0]);
+        g_free (env[1]);
 
         if (success) {
                 g_debug ("GsmAutostartApp: started pid:%d", priv->pid);
