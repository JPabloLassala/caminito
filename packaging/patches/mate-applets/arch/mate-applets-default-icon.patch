+++ b/mateweather/src/mateweather-applet.c
@@ -343,9 +343,8 @@ void mateweather_applet_create (MateWeatherApplet *gw_applet)
 
 #ifndef ENABLE_IN_PROCESS
     g_set_application_name (_("Weather Report"));
-#endif
-
     gtk_window_set_default_icon_name ("weather-storm");
+#endif
 
     g_signal_connect (gw_applet->applet, "change-orient",
                       G_CALLBACK (change_orient_cb),
diff --git a/multiload/src/main.c b/multiload/src/main.c
index 9439b3200..8ebac7f45 100644
--- a/multiload/src/main.c
+++ b/multiload/src/main.c
@@ -497,9 +497,8 @@ multiload_applet_new(MatePanelApplet *applet, const gchar *iid, gpointer data)
 
 #ifndef ENABLE_IN_PROCESS
     g_set_application_name (_("System Monitor"));
-#endif
-
     gtk_window_set_default_icon_name ("utilities-system-monitor");
+#endif
 
     ma->settings = mate_panel_applet_settings_new (applet, "org.mate.panel.applet.multiload");
     mate_panel_applet_set_flags (applet, MATE_PANEL_APPLET_EXPAND_MINOR);
diff --git a/netspeed/src/netspeed.c b/netspeed/src/netspeed.c
index 73185abd3..d649426da 100644
--- a/netspeed/src/netspeed.c
+++ b/netspeed/src/netspeed.c
@@ -218,9 +218,6 @@ change_icons (NetspeedApplet *netspeed)
                                              OUT_ICON,
                                              16, icon_scale, NULL, 0, NULL);
 
-    /* Set the windowmanager icon for the applet */
-    gtk_window_set_default_icon_name (LOGO_ICON);
-
     gtk_image_set_from_surface (GTK_IMAGE (netspeed->out_pix), out_arrow);
     gtk_image_set_from_surface (GTK_IMAGE (netspeed->in_pix), in_arrow);
     cairo_surface_destroy (in_arrow);
@@ -1577,6 +1574,7 @@ netspeed_applet_factory (MatePanelApplet *applet,
 
 #ifndef ENABLE_IN_PROCESS
     g_set_application_name (_("MATE Netspeed"));
+    gtk_window_set_default_icon_name (LOGO_ICON);
 #endif
 
     netspeed = NETSPEED_APPLET (applet);
diff --git a/stickynotes/stickynotes_applet.c b/stickynotes/stickynotes_applet.c
