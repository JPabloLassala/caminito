 static GtkCellEditable *
 egg_cell_renderer_keys_start_editing (GtkCellRenderer      *cell,
 				      GdkEvent             *event,
@@ -642,14 +763,19 @@ egg_cell_renderer_keys_start_editing (GtkCellRenderer      *cell,
   display = gtk_widget_get_display (widget);
   seat = gdk_display_get_default_seat (display);
 
-  if (gdk_seat_grab (seat,
-                     gtk_widget_get_window (widget),
-                     GDK_SEAT_CAPABILITY_ALL,
-                     FALSE,
-                     NULL,
-                     event,
-                     NULL,
-                     NULL) != GDK_GRAB_SUCCESS)
+  if (wm_common_is_caminito ())
+    {
+      if (!grab_for_caminito (seat, gtk_widget_get_window (widget), event))
+        return NULL;
+    }
+  else if (gdk_seat_grab (seat,
+                          gtk_widget_get_window (widget),
+                          GDK_SEAT_CAPABILITY_ALL,
+                          FALSE,
+                          NULL,
+                          event,
+                          NULL,
+                          NULL) != GDK_GRAB_SUCCESS)
     return NULL;
 
   keys->grab_widget = widget;
@@ -658,6 +784,11 @@ egg_cell_renderer_keys_start_editing (GtkCellRenderer      *cell,
                     G_CALLBACK (grab_key_callback),
                     keys);
 
+  if (wm_common_is_caminito ())
+    g_signal_connect (widget, "button_press_event",
+                      G_CALLBACK (grab_button_callback),
+                      keys);
+
   eventbox = g_object_new (pointless_eventbox_subclass_get_type (),
 			   "tooltip-text", _("Press the keys for the new accelerator, Backspace to clear, or Escape to cancel edition"),
 			   "can-focus", TRUE,
@@ -762,3 +893,15 @@ void egg_cell_renderer_keys_set_accel_mode (EggCellRendererKeys* keys, EggCellRe
 	keys->accel_mode = accel_mode;
 	g_object_notify(G_OBJECT(keys), "accel_mode");
 }
+
+void egg_cell_renderer_keys_set_button (EggCellRendererKeys* keys, guint button)
+{
+	g_return_if_fail(EGG_IS_CELL_RENDERER_KEYS(keys));
+
+	if (button == keys->button)
+		return;
+
+	keys->button = button;
+	g_object_notify(G_OBJECT(keys), "button");
+	update_text (keys);
+}
