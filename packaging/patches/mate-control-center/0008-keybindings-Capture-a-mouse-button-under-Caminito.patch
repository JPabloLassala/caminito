+static gboolean
+grab_for_caminito (GdkSeat        *seat,
+                   GdkWindow      *window,
+                   GdkEvent       *event)
+{
+  if (gdk_seat_grab (seat, window, GDK_SEAT_CAPABILITY_KEYBOARD,
+                     FALSE, NULL, event, NULL, NULL) != GDK_GRAB_SUCCESS)
+    return FALSE;
+
+  if (gdk_seat_grab (seat, window, GDK_SEAT_CAPABILITY_ALL & ~GDK_SEAT_CAPABILITY_KEYBOARD,
+                     FALSE, NULL, event, NULL, NULL) != GDK_GRAB_SUCCESS)
+    {
+      gdk_seat_ungrab (seat);
+      return FALSE;
+    }
+
+  return TRUE;
+}
