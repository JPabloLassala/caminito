+/* The seat's grab while a row captures, under Caminito. The keyboard is
+ * grabbed on its own first, since that's the grab GDK holds a shortcuts
+ * inhibitor for on Wayland, and with one Caminito gives the dialog the
+ * presses its System shortcuts would otherwise take (184). Then the rest
+ * of the seat, as the stock grab has it. */
+static gboolean
+grab_for_caminito (GdkSeat        *seat,
+                   GdkWindow      *window,
+                   GdkEvent       *event)
+{
+  if (gdk_seat_grab (seat, window, GDK_SEAT_CAPABILITY_KEYBOARD,
+                     FALSE, NULL, event, NULL, NULL) != GDK_GRAB_SUCCESS)
+    return FALSE;
+
+  if (gdk_seat_grab (seat, window, GDK_SEAT_CAPABILITY_ALL & ~GDK_SEAT_CAPABILITY_KEYBOARD,
+                     FALSE, NULL, event, NULL, NULL) != GDK_GRAB_SUCCESS)
+    {
+      gdk_seat_ungrab (seat);
+      return FALSE;
+    }
+
+  return TRUE;
+}
