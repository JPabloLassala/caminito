+static gboolean is_modifier_click(guint button, EggVirtualModifierType mask)
+{
+    GSettingsSchemaSource *source;
+    GSettingsSchema *schema;
+    GSettings *settings;
+    gchar *value;
+    guint keyval;
+    EggVirtualModifierType modifier = 0;
+
+    if (button < 1 || button > 3)
+        return FALSE;
+
+    source = g_settings_schema_source_get_default ();
+    schema = source ? g_settings_schema_source_lookup (source, "org.mate.Marco.general", TRUE) : NULL;
+    if (schema == NULL)
+        return FALSE;
+
+    settings = g_settings_new_full (schema, NULL, NULL);
+    value = g_settings_get_string (settings, "mouse-button-modifier");
+    if (value[0] != '\0' && strcmp (value, "disabled") != 0)
+        egg_accelerator_parse_virtual (value, &keyval, NULL, &modifier);
+    modifier = egg_button_modifiers (modifier);
+    g_free (value);
+    g_object_unref (settings);
+    g_settings_schema_unref (schema);
+
+    return modifier != 0 &&
+           (mask == modifier || (button == 1 && mask == (modifier | EGG_VIRTUAL_SHIFT_MASK)));
