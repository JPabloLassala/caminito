diff --git a/capplets/keybindings/eggaccelerators.c b/capplets/keybindings/eggaccelerators.c
index 5816cac..4c7848c 100644
--- a/capplets/keybindings/eggaccelerators.c
+++ b/capplets/keybindings/eggaccelerators.c
@@ -472,6 +472,177 @@ egg_virtual_accelerator_label (guint                  accelerator_key,
 	return gtk_label;
 }
 
+/* The highest button a System shortcut can be: X's number for BTN_SIDE + 12,
+ * the last code before the joystick's, as Caminito reads it (184). */
+#define EGG_LAST_BUTTON 20
+
+/* The modifiers a button is held with, named as Caminito reads them: Super
+ * for Mod4 and Hyper, which a press's state has with it, and Alt for Mod1
+ * and Meta. The locks, and the modifiers Caminito has no name for, go. */
+EggVirtualModifierType
+egg_button_modifiers (EggVirtualModifierType mods)
+{
+  EggVirtualModifierType named = mods & (EGG_VIRTUAL_SHIFT_MASK | EGG_VIRTUAL_CONTROL_MASK);
+
+  if (mods & (EGG_VIRTUAL_ALT_MASK | EGG_VIRTUAL_META_MASK))
+    named |= EGG_VIRTUAL_ALT_MASK;
+  if (mods & (EGG_VIRTUAL_MOD4_MASK | EGG_VIRTUAL_SUPER_MASK | EGG_VIRTUAL_HYPER_MASK))
+    named |= EGG_VIRTUAL_SUPER_MASK;
+
+  return named;
+}
+
+/* Whether a press of @button with @button_mods can be a System shortcut:
+ * the middle button and the side buttons alone or held, and the left and
+ * right ones held. Not the wheel's 4 to 7. */
+gboolean
+egg_button_is_shortcut (guint button, EggVirtualModifierType button_mods)
+{
+  if (button == 1 || button == 3)
+    return egg_button_modifiers (button_mods) != 0;
+
+  return button == 2 || (button >= 8 && button <= EGG_LAST_BUTTON);
+}
+
+/**
+ * egg_accelerator_parse_button:
+ * @accelerator: a setting's value
+ * @button:      return location for X's number of the button
+ * @button_mods: return location for the modifiers, as egg_button_modifiers() names them
+ *
+ * Parses a mouse button as ADR 0028 writes it: GTK's modifiers, then "Button"
+ * in any case and X's number for the button, as X writes it, "&lt;Super&gt;Button8".
+ * It reads what Caminito reads, and no more.
+ *
+ * Returns: %TRUE if @accelerator is a button that can be a System shortcut.
+ */
+gboolean
+egg_accelerator_parse_button (const gchar            *accelerator,
+                              guint                  *button,
+                              EggVirtualModifierType *button_mods)
+{
+  const gchar *rest;
+  const gchar *digit;
+  gchar *held;
+  guint keyval;
+  guint64 number;
+  EggVirtualModifierType mods;
+  gboolean parsed;
+
+  *button = 0;
+  *button_mods = 0;
+
+  if (accelerator == NULL)
+    return FALSE;
+
+  rest = strrchr (accelerator, '>');
+  rest = rest != NULL ? rest + 1 : accelerator;
+  if (g_ascii_strncasecmp (rest, "Button", 6) != 0)
+    return FALSE;
+
+  /* The number as X writes it, 8 and not 08 or +8. */
+  rest += 6;
+  if (*rest < '1' || *rest > '9')
+    return FALSE;
+  for (digit = rest; *digit != '\0'; digit++)
+    if (!g_ascii_isdigit (*digit) || digit - rest > 2)
+      return FALSE;
+  number = g_ascii_strtoull (rest, NULL, 10);
+
+  /* What's before it is modifiers alone, as mouse-button-modifier's value is. */
+  held = g_strndup (accelerator, rest - 6 - accelerator);
+  parsed = egg_accelerator_parse_virtual (held, &keyval, NULL, &mods);
+  g_free (held);
+  if (!parsed || keyval != 0 ||
+      (mods & ~(EGG_VIRTUAL_SHIFT_MASK | EGG_VIRTUAL_CONTROL_MASK | EGG_VIRTUAL_ALT_MASK |
+                EGG_VIRTUAL_MOD4_MASK | EGG_VIRTUAL_SUPER_MASK | EGG_VIRTUAL_HYPER_MASK |
+                EGG_VIRTUAL_META_MASK)))
+    return FALSE;
+
+  mods = egg_button_modifiers (mods);
+  if (!egg_button_is_shortcut (number, mods))
+    return FALSE;
+
+  *button = number;
+  *button_mods = mods;
+  return TRUE;
+}
+
+static GdkModifierType
+button_gdk_modifiers (EggVirtualModifierType button_mods)
+{
+  /* Shift, Control, Alt (Mod1) and Super are the same bits in GDK's mask */
+  return (GdkModifierType) egg_button_modifiers (button_mods);
+}
+
+/* The value ADR 0028 has for a button: "<Super>Button8". */
+gchar *
+egg_virtual_button_name (guint button, EggVirtualModifierType button_mods)
+{
+  gchar *held;
+  gchar *name;
+
+  held = gtk_accelerator_name (0, button_gdk_modifiers (button_mods));
+  name = g_strdup_printf ("%sButton%u", held, button);
+  g_free (held);
+
+  return name;
+}
+
+/* @english, or @spanish where the messages' language is Spanish. Caminito
+ * carries these strings in its patch, as it does its launcher's name, and
+ * no catalogue of upstream's has them. */
+const gchar *
+egg_caminito_text (const gchar *english, const gchar *spanish)
+{
+  const gchar *language = g_get_language_names ()[0];
+
+  if (g_str_has_prefix (language, "es") &&
+      (language[2] == '\0' || strchr ("_.@", language[2]) != NULL))
+    return spanish;
+
+  return english;
+}
+
+/* The Window menu's words for a button (184), joined to the modifiers as a
+ * key's are: "Super+Back Button". */
+gchar *
+egg_virtual_button_label (guint button, EggVirtualModifierType button_mods)
+{
+  gchar *held;
+  gchar *named;
+  gchar *label;
+
+  switch (button)
+    {
+    case 1:
+      named = g_strdup (egg_caminito_text ("Left Button", "Botón izquierdo"));
+      break;
+    case 2:
+      named = g_strdup (egg_caminito_text ("Middle Button", "Botón central"));
+      break;
+    case 3:
+      named = g_strdup (egg_caminito_text ("Right Button", "Botón derecho"));
+      break;
+    case 8:
+      named = g_strdup (egg_caminito_text ("Back Button", "Botón atrás"));
+      break;
+    case 9:
+      named = g_strdup (egg_caminito_text ("Forward Button", "Botón adelante"));
+      break;
+    default:
+      named = g_strdup_printf (egg_caminito_text ("Button %u", "Botón %u"), button);
+      break;
+    }
+
+  held = gtk_accelerator_get_label (0, button_gdk_modifiers (button_mods));
+  label = *held != '\0' ? g_strconcat (held, "+", named, NULL) : g_strdup (named);
+  g_free (held);
+  g_free (named);
+
+  return label;
+}
+
 void egg_keymap_resolve_virtual_modifiers (GdkKeymap* keymap, EggVirtualModifierType virtual_mods, GdkModifierType* concrete_mods)
 {
 	GdkModifierType concrete;
