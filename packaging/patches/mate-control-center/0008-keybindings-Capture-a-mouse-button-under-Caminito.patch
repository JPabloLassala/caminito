+/* Ends a capture: the grab, and the row's editing. Returns the row's path. */
+static char* end_capture(EggCellRendererKeys* keys, GtkWidget* widget)
+{
+	char *path;
+
+	gdk_seat_ungrab (gdk_display_get_default_seat (gtk_widget_get_display (widget)));
+
+	path = g_strdup(g_object_get_data(G_OBJECT(keys->edit_widget), EGG_CELL_RENDERER_TEXT_PATH));
+
+	gtk_cell_editable_editing_done(GTK_CELL_EDITABLE(keys->edit_widget));
+	gtk_cell_editable_remove_widget(GTK_CELL_EDITABLE(keys->edit_widget));
+	keys->edit_widget = NULL;
+	keys->grab_widget = NULL;
+
+	return path;
+}
+
+/* Under Caminito a press of a button that can be a System shortcut becomes
+ * the row's shortcut, with the modifiers held (ADR 0028). A bare left click
+ * ends the capture, as Escape does, and then goes to the list. Any other
+ * press, a bare right click or the wheel, goes to the list as before. */
+static gboolean grab_button_callback(GtkWidget* widget, GdkEventButton* event, void* data)
+{
+	EggCellRendererKeys *keys;
+	EggVirtualModifierType mods;
+	GdkModifierType ignored_modifiers;
+	char *path;
+
+	keys = EGG_CELL_RENDERER_KEYS(data);
+
+	if (event->type != GDK_BUTTON_PRESS)
+	{
+		return FALSE;
+	}
+
+	egg_keymap_resolve_virtual_modifiers (gdk_keymap_get_for_display (gdk_display_get_default ()),
+		EGG_VIRTUAL_NUM_LOCK_MASK |
+		EGG_VIRTUAL_SCROLL_LOCK_MASK |
+		EGG_VIRTUAL_LOCK_MASK,
+		&ignored_modifiers);
+
+	mods = egg_button_modifiers (event->state & GDK_MODIFIER_MASK & ~ignored_modifiers);
+
+	if (!egg_button_is_shortcut (event->button, mods))
+	{
+		if (event->button == GDK_BUTTON_PRIMARY && mods == 0)
+		{
+			g_free (end_capture (keys, widget));
+		}
+		return FALSE;
+	}
+
+	path = end_capture (keys, widget);
+	g_signal_emit_by_name(G_OBJECT(keys), "button_edited", path, event->button, mods);
+	g_free (path);
+
+	return TRUE;
+}
+
