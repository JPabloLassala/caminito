From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Tue, 6 Oct 2026 22:44:54 -0300
Subject: [PATCH] wm-common: Know Caminito from the environment off X11

A Wayland compositor has no window to carry _NET_WM_NAME and
_MATE_WM_KEYBINDINGS, so on a display that isn't X11 wm-common knew no
window manager and no keybindings. Caminito exports MATE_WM_NAME=Caminito and
MATE_WM_KEYBINDINGS into its session in their place. Where MATE_WM_NAME
says Caminito, wm-common answers with it, and with the names in
MATE_WM_KEYBINDINGS.

Under any other Wayland compositor, whatever the variables say, the
answers are what they were: an unknown window manager and no keybindings.
On X11 the variables aren't read.
---
 capplets/common/wm-common.c | 33 +++++++++++++++++++++++++++++----
 capplets/common/wm-common.h |  5 ++++-
 2 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/capplets/common/wm-common.c b/capplets/common/wm-common.c
index 3030c071..291eb20b 100644
--- a/capplets/common/wm-common.c
+++ b/capplets/common/wm-common.c
@@ -64,11 +64,20 @@ wm_common_get_window_manager_property (Atom atom)
   return retval;
 }
 
+/* Caminito, a Wayland compositor, has no window to carry _NET_WM_NAME and
+ * _MATE_WM_KEYBINDINGS. It exports MATE_WM_NAME and MATE_WM_KEYBINDINGS
+ * into its session in their place. */
+static gboolean
+wm_common_is_caminito (void)
+{
+  return g_strcmp0 (g_getenv ("MATE_WM_NAME"), WM_COMMON_CAMINITO) == 0;
+}
+
 char*
 wm_common_get_current_window_manager (void)
 {
   if (!(GDK_IS_X11_DISPLAY (gdk_display_get_default())))
-    return g_strdup (WM_COMMON_UNKNOWN);
+    return g_strdup (wm_common_is_caminito () ? WM_COMMON_CAMINITO : WM_COMMON_UNKNOWN);
 
   Atom atom = gdk_x11_get_xatom_by_name ("_NET_WM_NAME");
   char *result;
@@ -86,10 +95,26 @@ wm_common_get_current_keybindings (void)
 
   if (!(GDK_IS_X11_DISPLAY (gdk_display_get_default())))
   {
-    /*This should never reached in wayland as compositors control
-     *and limit keybindings
+    /* Caminito names its keybindings as a window manager does in
+     * _MATE_WM_KEYBINDINGS, and they are its name's without that.
+     * Any other compositor has none to list, as before.
      */
-    return NULL;
+    const char *names;
+    char **results;
+    char **p;
+
+    if (!wm_common_is_caminito ())
+      return NULL;
+
+    names = g_getenv ("MATE_WM_KEYBINDINGS");
+    if (names == NULL || *names == '\0')
+      names = WM_COMMON_CAMINITO;
+
+    results = g_strsplit (names, ",", -1);
+    for (p = results; *p; p++)
+      g_strstrip (*p);
+
+    return results;
   }
 
   Atom keybindings_atom = gdk_x11_get_xatom_by_name ("_MATE_WM_KEYBINDINGS");
diff --git a/capplets/common/wm-common.h b/capplets/common/wm-common.h
index 96f8cfbf..1c8be2fa 100644
--- a/capplets/common/wm-common.h
+++ b/capplets/common/wm-common.h
@@ -6,11 +6,14 @@
 #define WM_COMMON_METACITY    "Metacity"
 #define WM_COMMON_COMPIZ      "Compiz"
 #define WM_COMMON_COMPIZ_OLD  "compiz"
+#define WM_COMMON_CAMINITO      "Caminito"
 #define WM_COMMON_UNKNOWN     "Unknown"
 
 gchar *wm_common_get_current_window_manager (void);
 /* Returns a strv of keybinding names for the window manager;
- * using _MATE_WM_KEYBINDINGS if available, _NET_WM_NAME otherwise. */
+ * using _MATE_WM_KEYBINDINGS if available, _NET_WM_NAME otherwise.
+ * Off X11 the result is NULL, except under Caminito, where it is the
+ * MATE_WM_KEYBINDINGS environment variable's names. */
 char **wm_common_get_current_keybindings (void);
 
 void   wm_common_register_window_manager_change (GFunc    func,
