 }
 
 static bool get_layout_idle(DBusMenuModel *self)
diff --git a/subprojects/appmenu-glib-translator/utils.c b/subprojects/appmenu-glib-translator/utils.c
index 10be1c7..84620fc 100644
--- a/subprojects/appmenu-glib-translator/utils.c
+++ b/subprojects/appmenu-glib-translator/utils.c
@@ -108,6 +108,42 @@ static GAction *dbus_menu_action_new(DBusMenuXml *xml, u_int32_t id, DBusMenuAct
 //	return true;
 //}
 
+/* How long a submenu that was closed is still open for the application, in milliseconds. */
+#define CLOSED_DELAY 500
+/* The source that will tell the application a submenu was closed, kept on its model. */
+#define PENDING_CLOSED_STR "submenu-pending-closed"
+
+static gboolean submenu_closed_cb(gpointer user_data)
+{
+	DBusMenuModel *model = DBUS_MENU_MODEL(user_data);
+	DBusMenuXml *xml     = NULL;
+	u_int32_t id;
+	g_object_set_data(G_OBJECT(model), PENDING_CLOSED_STR, NULL);
+	g_object_get(model, "parent-id", &id, "xml", &xml, NULL);
+	if (!xml)
+		return G_SOURCE_REMOVE;
+	dbus_menu_xml_call_event_sync(xml,
+	                              id,
+	                              "closed",
+	                              g_variant_new("v", g_variant_new_int32(0)),
+	                              CURRENT_TIME,
+	                              NULL,
+	                              NULL);
+	g_object_unref(xml);
+	return G_SOURCE_REMOVE;
+}
+
+/* Whether the application was about to be told the submenu was closed. If so, it isn't. */
+static bool submenu_cancel_closed(DBusMenuModel *model)
+{
+	guint pending = GPOINTER_TO_UINT(g_object_get_data(G_OBJECT(model), PENDING_CLOSED_STR));
+	if (!pending)
+		return false;
+	g_object_set_data(G_OBJECT(model), PENDING_CLOSED_STR, NULL);
+	g_source_remove(pending);
+	return true;
+}
+
 static void state_submenu_cb(GSimpleAction *action, GVariant *parameter, gpointer user_data)
 {
 	g_return_if_fail(DBUS_MENU_IS_MODEL(user_data));
@@ -120,7 +156,21 @@ static void state_submenu_cb(GSimpleAction *action, GVariant *parameter, gpointe
 	bool opened       = g_variant_get_boolean(statev);
 	g_variant_unref(statev);
 	bool need_update = true;
-	if (request_open && !opened)
+	/* Firefox makes its whole menu again, every item with a new id, when one of its menus
+	 * changes, and some change each time they are told they were opened. Every item of the
+	 * menu on screen is then replaced, which closes the submenu that was just opened, and
+	 * the pointer resting on its item opens it again. Telling Firefox so would make its
+	 * menu change again, and the submenu would open and close without an end. So a submenu
+	 * that is opened again shortly after it was closed was open all along for the
+	 * application.
+	 */
+	if (request_open && !opened && submenu_cancel_closed(model))
+	{
+		g_simple_action_set_state(action, g_variant_new_boolean(true));
+		if (dbus_menu_model_is_layout_update_required(model))
+			dbus_menu_model_update_layout(model);
+	}
+	else if (request_open && !opened)
 	{
 		// Use opened before actual open. For Firefox.
 		dbus_menu_xml_call_event_sync(xml,
@@ -161,13 +211,17 @@ static void state_submenu_cb(GSimpleAction *action, GVariant *parameter, gpointe
 	}
 	else
 	{
-		dbus_menu_xml_call_event_sync(xml,
-		                              id,
-		                              "closed",
-		                              g_variant_new("v", g_variant_new_int32(0)),
-		                              CURRENT_TIME,
-		                              NULL,
-		                              NULL);
+		if (!g_object_get_data(G_OBJECT(model), PENDING_CLOSED_STR))
+		{
+			guint pending = g_timeout_add_full(G_PRIORITY_DEFAULT,
+			                                   CLOSED_DELAY,
+			                                   submenu_closed_cb,
+			                                   g_object_ref(model),
+			                                   g_object_unref);
+			g_object_set_data(G_OBJECT(model),
+			                  PENDING_CLOSED_STR,
+			                  GUINT_TO_POINTER(pending));
+		}
 		g_simple_action_set_state(action, g_variant_new_boolean(false));
 	}
 }
