+/* Makes a submenu the one with the id of src, if both are submenus and differ in nothing
+ * else that cannot change. Returns whether it did.
+ */
+G_GNUC_INTERNAL bool dbus_menu_item_take_id(DBusMenuItem *dst, DBusMenuItem *src)
+{
+	if (dst->action_type != DBUS_MENU_ACTION_SUBMENU ||
+	    src->action_type != DBUS_MENU_ACTION_SUBMENU)
+		return false;
+	if (dst->ref_action_group != src->ref_action_group)
+		return false;
+	DBusMenuModel *submenu =
+	    DBUS_MENU_MODEL(g_hash_table_lookup(dst->links, submenu_str(dst->enabled)));
+	if (!submenu || !DBUS_MENU_IS_MODEL(submenu))
+		return false;
+	dst->id = src->id;
+	g_object_set(submenu, "parent-id", dst->id, NULL);
+	return true;
+}
+
+/* Fetches the layout of a submenu again, where it has to be, and tells the application
+ * nothing: for a submenu that was preloaded already and only has another id.
+ */
+G_GNUC_INTERNAL void dbus_menu_item_reload(DBusMenuItem *item)
+{
+	if (!item_check_magic(item))
+		return;
+	if (item->action_type != DBUS_MENU_ACTION_SUBMENU)
+		return;
+	DBusMenuModel *submenu =
+	    DBUS_MENU_MODEL(g_hash_table_lookup(item->links, submenu_str(item->enabled)));
+	if (!submenu || !DBUS_MENU_IS_MODEL(submenu))
+		return;
+	if (dbus_menu_model_is_layout_update_required(submenu))
+		dbus_menu_model_update_layout(submenu);
+}
+
 G_GNUC_INTERNAL bool dbus_menu_item_copy_attrs(DBusMenuItem *src, DBusMenuItem *dst)
 {
 	GHashTableIter iter;
