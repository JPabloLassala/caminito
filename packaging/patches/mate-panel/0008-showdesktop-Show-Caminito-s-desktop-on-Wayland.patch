From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Tue, 6 Oct 2026 12:00:00 -0300
Subject: [PATCH] showdesktop: Show Caminito's desktop on Wayland

On Wayland the Show Desktop button asks libxfce4windowing, which minimises
every window itself where the compositor has no protocol for showing the
desktop. Nothing but the button knows of that: the compositor's own key
binding for showing the desktop neither sets the button nor brings back
what the button hid.

Caminito, the Wayland compositor, shows the desktop itself, for each
workspace, and has it as the ShowingDesktop property of org.mate.Caminito on
the session bus. While that name has an owner, the button reads, writes and
follows the property, so that it and Caminito's key binding show and bring
back the same desktop.

Without an owner of org.mate.Caminito, which is any other Wayland compositor,
nothing changes.
---
 applets/wncklet/showdesktop.c | 113 ++++++++++++++++++++++++++++++++--
 1 file changed, 108 insertions(+), 5 deletions(-)

diff --git a/applets/wncklet/showdesktop.c b/applets/wncklet/showdesktop.c
index d393d6c3..878e590f 100644
--- a/applets/wncklet/showdesktop.c
+++ b/applets/wncklet/showdesktop.c
@@ -48,6 +48,10 @@
 #ifdef HAVE_WAYLAND
 #include <gdk/gdkwayland.h>
 #include <libxfce4windowing/libxfce4windowing.h>
+
+#define CAMINITO_NAME      "org.mate.Caminito"
+#define CAMINITO_PATH      "/org/mate/Caminito"
+#define CAMINITO_INTERFACE "org.mate.Caminito"
 #endif
 #define TIMEOUT_ACTIVATE_SECONDS 1
 #define SHOW_DESKTOP_ICON "user-desktop"
@@ -67,6 +71,10 @@ typedef struct {
 	WnckScreen* wnck_screen;
 #ifdef HAVE_WAYLAND
 	XfwScreen* xfw_screen;
+	/* Caminito, the Wayland compositor, whose ShowingDesktop is what its own
+	 * key binding shows and hides too. It has no owner under any other
+	 * compositor. */
+	GDBusProxy* caminito;
 #endif
 
 	guint showing_desktop: 1;
@@ -91,6 +99,51 @@ static void show_desktop_changed_callback(WnckScreen* screen, ShowDesktopData* s
 #endif
 #ifdef HAVE_WAYLAND
 static void wayland_show_desktop_changed(XfwScreen* screen, GParamSpec* pspec, ShowDesktopData* sdd);
+static void caminito_changed(GDBusProxy* caminito, GVariant* changed, GStrv invalidated, ShowDesktopData* sdd);
+static void caminito_owner_changed(GDBusProxy* caminito, GParamSpec* pspec, ShowDesktopData* sdd);
+
+/* Whether Caminito is the compositor: its name has an owner. */
+static gboolean caminito_is_running(ShowDesktopData* sdd)
+{
+	char* owner;
+	gboolean running;
+
+	if (sdd->caminito == NULL)
+		return FALSE;
+
+	owner = g_dbus_proxy_get_name_owner(sdd->caminito);
+	running = owner != NULL;
+	g_free(owner);
+
+	return running;
+}
+
+/* Caminito's ShowingDesktop, for the workspace the user is on. */
+static gboolean caminito_get_showing_desktop(ShowDesktopData* sdd)
+{
+	GVariant* value;
+	gboolean showing = FALSE;
+
+	value = g_dbus_proxy_get_cached_property(sdd->caminito, "ShowingDesktop");
+	if (value == NULL)
+		return FALSE;
+
+	if (g_variant_is_of_type(value, G_VARIANT_TYPE_BOOLEAN))
+		showing = g_variant_get_boolean(value);
+	g_variant_unref(value);
+
+	return showing;
+}
+
+/* Caminito signals the change, which is what sets the button. */
+static void caminito_set_showing_desktop(ShowDesktopData* sdd, gboolean showing)
+{
+	g_dbus_proxy_call(sdd->caminito,
+	                  "org.freedesktop.DBus.Properties.Set",
+	                  g_variant_new("(ssv)", CAMINITO_INTERFACE, "ShowingDesktop",
+	                                g_variant_new_boolean(showing)),
+	                  G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+}
 #endif
 
 /* this is when the panel orientation changes */
@@ -332,6 +385,13 @@ static void applet_destroyed(GtkWidget* applet, ShowDesktopData* sdd)
 		g_object_unref (sdd->xfw_screen);
 		sdd->xfw_screen = NULL;
 	}
+
+	if (sdd->caminito != NULL)
+	{
+		g_signal_handlers_disconnect_by_func(sdd->caminito, caminito_changed, sdd);
+		g_signal_handlers_disconnect_by_func(sdd->caminito, caminito_owner_changed, sdd);
+		g_clear_object(&sdd->caminito);
+	}
 #endif
 
 	if (sdd->icon_theme != NULL)
@@ -431,6 +491,28 @@ static void show_desktop_applet_realized(MatePanelApplet* applet, gpointer data)
 		}
 		else
 			g_warning ("Could not get XfwScreen!");
+
+		/* Looked for once. Without an owner of its name, which is any
+		 * other compositor, the button stays libxfce4windowing's. */
+		if (sdd->caminito == NULL)
+		{
+			sdd->caminito = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SESSION,
+			                                             G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+			                                             NULL,
+			                                             CAMINITO_NAME,
+			                                             CAMINITO_PATH,
+			                                             CAMINITO_INTERFACE,
+			                                             NULL, NULL);
+			if (sdd->caminito != NULL)
+			{
+				g_signal_connect (sdd->caminito, "g-properties-changed",
+				                  G_CALLBACK (caminito_changed),
+				                  sdd);
+				g_signal_connect (sdd->caminito, "notify::g-name-owner",
+				                  G_CALLBACK (caminito_owner_changed),
+				                  sdd);
+			}
+		}
 	}
 #endif
 	show_desktop_state_changed (sdd);
@@ -615,10 +697,19 @@ static void button_toggled_callback(GtkWidget* button, ShowDesktopData* sdd)
 	if (GDK_IS_WAYLAND_DISPLAY (gdk_display_get_default ()))
 #endif
 	{
-		can_show_desktop = sdd->xfw_screen != NULL;
-		if (can_show_desktop)
-			xfw_screen_set_show_desktop (sdd->xfw_screen,
-			                             gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (button)));
+		gboolean active = gtk_toggle_button_get_active (GTK_TOGGLE_BUTTON (button));
+
+		if (caminito_is_running (sdd))
+		{
+			can_show_desktop = TRUE;
+			caminito_set_showing_desktop (sdd, active);
+		}
+		else
+		{
+			can_show_desktop = sdd->xfw_screen != NULL;
+			if (can_show_desktop)
+				xfw_screen_set_show_desktop (sdd->xfw_screen, active);
+		}
 	}
 #endif
 
@@ -680,7 +771,9 @@ show_desktop_state_changed (ShowDesktopData* sdd)
 #endif /* HAVE_X11 */
 
 #ifdef HAVE_WAYLAND
-	if (sdd->xfw_screen != NULL)
+	if (caminito_is_running (sdd))
+		sdd->showing_desktop = caminito_get_showing_desktop (sdd);
+	else if (sdd->xfw_screen != NULL)
 		sdd->showing_desktop = xfw_screen_get_show_desktop (sdd->xfw_screen);
 #endif /* HAVE_WAYLAND */
 
@@ -699,4 +792,14 @@ static void wayland_show_desktop_changed(XfwScreen* screen, GParamSpec* pspec, S
 {
 	show_desktop_state_changed (sdd);
 }
+
+static void caminito_changed(GDBusProxy* caminito, GVariant* changed, GStrv invalidated, ShowDesktopData* sdd)
+{
+	show_desktop_state_changed (sdd);
+}
+
+static void caminito_owner_changed(GDBusProxy* caminito, GParamSpec* pspec, ShowDesktopData* sdd)
+{
+	show_desktop_state_changed (sdd);
+}
 #endif /* HAVE_WAYLAND */
