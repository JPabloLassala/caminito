 		panel_toplevel_set_hide_delay (toplevel, g_value_get_int (value));
 		break;
@@ -4493,6 +4501,9 @@ panel_toplevel_get_property (GObject    *object,
 	case PROP_AUTOHIDE:
 		g_value_set_boolean (value, toplevel->priv->auto_hide);
 		break;
+	case PROP_INTELLIHIDE:
+		g_value_set_boolean (value, toplevel->priv->intellihide);
+		break;
 	case PROP_HIDE_DELAY:
 		g_value_set_int (value, toplevel->priv->hide_delay);
 		break;
@@ -4756,6 +4767,16 @@ panel_toplevel_class_init (PanelToplevelClass *klass)
 			FALSE,
 			G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
 
+	g_object_class_install_property (
+		gobject_class,
+		PROP_INTELLIHIDE,
+		g_param_spec_boolean (
+			"intellihide",
+			"Intellihide",
+			"Reserve no space and ask Caminito to hide the panel while a window overlaps it",
+			FALSE,
+			G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
+
 	g_object_class_install_property (
 		gobject_class,
 		PROP_HIDE_DELAY,
@@ -5853,6 +5874,40 @@ panel_toplevel_get_auto_hide (PanelToplevel *toplevel)
 	return toplevel->priv->auto_hide;
 }
 
+void
+panel_toplevel_set_intellihide (PanelToplevel *toplevel,
+				gboolean       intellihide)
+{
+	g_return_if_fail (PANEL_IS_TOPLEVEL (toplevel));
+
+	intellihide = intellihide != FALSE;
+
+	if (toplevel->priv->intellihide == intellihide)
+		return;
+
+	toplevel->priv->intellihide = intellihide;
+
+#ifdef HAVE_WAYLAND
+	/* Nothing changes anywhere but under Caminito, which is the only
+	 * compositor that offers intellihide. */
+	if (GDK_IS_WAYLAND_DISPLAY (gtk_widget_get_display (GTK_WIDGET (toplevel)))) {
+		wayland_panel_toplevel_update_intellihide (toplevel);
+		if (panel_toplevel_update_struts (toplevel, FALSE))
+			gtk_widget_queue_resize (GTK_WIDGET (toplevel));
+	}
+#endif /* HAVE_WAYLAND */
+
+	g_object_notify (G_OBJECT (toplevel), "intellihide");
+}
+
+gboolean
+panel_toplevel_get_intellihide (PanelToplevel *toplevel)
+{
+	g_return_val_if_fail (PANEL_IS_TOPLEVEL (toplevel), FALSE);
+
+	return toplevel->priv->intellihide;
+}
+
 void
 panel_toplevel_set_hide_delay (PanelToplevel *toplevel,
 			       int            hide_delay)
