diff --git a/mate-panel/wayland-intellihide.c b/mate-panel/wayland-intellihide.c
new file mode 100644
index 00000000..05812508
--- /dev/null
+++ b/mate-panel/wayland-intellihide.c
@@ -0,0 +1,217 @@
+/*
+ * wayland-intellihide.c: Ask Caminito, the Wayland compositor, to hide a
+ * panel while a window overlaps it
+ *
+ * Copyright (C) 2026 Juan Pablo Lassala
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of the
+ * License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA
+ * 02110-1301, USA.
+ */
+
+/*
+ * Caminito hides and slides a panel that asks for intellihide, and the panel
+ * is never told. It asks through caminito_intellihide_manager_v1, a private
+ * protocol of Caminito's (caminito/resources/caminito-intellihide-v1.xml in
+ * its source), by making a caminito_intellihide_v1 for the panel's layer
+ * surface: the object's existence is the request.
+ *
+ * The protocol is Caminito's alone, so the global is only there under it, and
+ * a panel anywhere else asks for nothing. The interfaces below are written
+ * out by hand from that XML instead of generated from it, to keep a
+ * dependency on wayland-scanner out of the panel's build; the panel only
+ * makes requests, and the protocol has no events.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <string.h>
+
+#include <gdk/gdkwayland.h>
+#include <gtk-layer-shell.h>
+#include <wayland-client.h>
+
+#include "wayland-intellihide.h"
+
+#define MANAGER_INTERFACE "caminito_intellihide_manager_v1"
+
+/* caminito_intellihide_v1: 0 destroy */
+static const struct wl_interface caminito_intellihide_v1_interface = {
+	"caminito_intellihide_v1", 1,
+	1, (const struct wl_message[]) {
+		{ "destroy", "", NULL },
+	},
+	0, NULL,
+};
+
+/* caminito_intellihide_manager_v1: 0 destroy,
+ * 1 get_intellihide (new caminito_intellihide_v1, zwlr_layer_surface_v1).
+ * The layer surface's interface is gtk-layer-shell's, whose symbol is not
+ * exported, and a request only sends the object's id. */
+static const struct wl_interface *get_intellihide_types[] = {
+	&caminito_intellihide_v1_interface,
+	NULL,
+};
+
+static const struct wl_interface caminito_intellihide_manager_v1_interface = {
+	MANAGER_INTERFACE, 1,
+	2, (const struct wl_message[]) {
+		{ "destroy", "", NULL },
+		{ "get_intellihide", "no", get_intellihide_types },
+	},
+	0, NULL,
+};
+
+enum {
+	MANAGER_DESTROY,
+	MANAGER_GET_INTELLIHIDE,
+};
+
+enum {
+	INTELLIHIDE_DESTROY,
+};
+
+/* The manager, once looked for: NULL where the compositor has none. */
+static struct wl_proxy *manager = NULL;
+static gboolean         manager_looked = FALSE;
+
+/* What a window asked for: the object, and the layer surface it is for. */
+typedef struct {
+	struct wl_proxy *object;
+	struct wl_proxy *layer_surface;
+} Asked;
+
+static void
+registry_global (void               *data,
+		 struct wl_registry *registry,
+		 uint32_t            name,
+		 const char         *interface,
+		 uint32_t            version)
+{
+	if (manager == NULL && strcmp (interface, MANAGER_INTERFACE) == 0)
+		manager = wl_registry_bind (registry, name,
+					    &caminito_intellihide_manager_v1_interface, 1);
+}
+
+static void
+registry_global_remove (void               *data,
+			struct wl_registry *registry,
+			uint32_t            name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+	registry_global,
+	registry_global_remove,
+};
+
+/* Looks for the manager once, with a queue of its own so that GDK's events
+ * are left to GDK. */
+static void
+look_for_manager (void)
+{
+	GdkDisplay             *display;
+	struct wl_display      *wl_display;
+	struct wl_event_queue  *queue;
+	struct wl_proxy        *wrapper;
+	struct wl_registry     *registry;
+
+	if (manager_looked)
+		return;
+	manager_looked = TRUE;
+
+	display = gdk_display_get_default ();
+	if (display == NULL || !GDK_IS_WAYLAND_DISPLAY (display))
+		return;
+
+	wl_display = gdk_wayland_display_get_wl_display (display);
+	queue = wl_display_create_queue (wl_display);
+	wrapper = wl_proxy_create_wrapper (wl_display);
+	wl_proxy_set_queue (wrapper, queue);
+
+	registry = wl_display_get_registry ((struct wl_display *) wrapper);
+	wl_registry_add_listener (registry, &registry_listener, NULL);
+	wl_display_roundtrip_queue (wl_display, queue);
+
+	/* The manager has no events, so it goes to the default queue and the
+	 * private one can go. */
+	if (manager != NULL)
+		wl_proxy_set_queue (manager, NULL);
+	wl_registry_destroy (registry);
+	wl_proxy_wrapper_destroy (wrapper);
+	wl_event_queue_destroy (queue);
+}
+
+/* Whether the compositor offers intellihide: Caminito does. */
+gboolean
+wayland_intellihide_available (void)
+{
+	look_for_manager ();
+
+	return manager != NULL;
+}
+
+static void
+asked_free (gpointer data)
+{
+	Asked *asked = data;
+
+	if (asked->object != NULL)
+		wl_proxy_marshal_flags (asked->object, INTELLIHIDE_DESTROY, NULL,
+					wl_proxy_get_version (asked->object),
+					WL_MARSHAL_FLAG_DESTROY);
+	g_free (asked);
+}
+
+/* Asks for intellihide on the window's layer surface, or stops asking. The
+ * layer surface is made when the window maps, and again when it maps on
+ * another monitor, so this is called at each map, and with FALSE at each
+ * unmap, which ends the request that was for the surface that went. */
+void
+wayland_intellihide_update (GtkWindow *window,
+			    gboolean   wanted)
+{
+	Asked           *asked;
+	struct wl_proxy *layer_surface;
+
+	asked = g_object_get_data (G_OBJECT (window), "wayland-intellihide");
+	if (asked == NULL) {
+		asked = g_new0 (Asked, 1);
+		g_object_set_data_full (G_OBJECT (window), "wayland-intellihide",
+					asked, asked_free);
+	}
+
+	layer_surface = (struct wl_proxy *) gtk_layer_get_zwlr_layer_surface_v1 (window);
+	if (asked->object != NULL &&
+	    (!wanted || asked->layer_surface != layer_surface)) {
+		wl_proxy_marshal_flags (asked->object, INTELLIHIDE_DESTROY, NULL,
+					wl_proxy_get_version (asked->object),
+					WL_MARSHAL_FLAG_DESTROY);
+		asked->object = NULL;
+		asked->layer_surface = NULL;
+	}
+
+	if (!wanted || layer_surface == NULL || asked->object != NULL)
+		return;
+	if (!wayland_intellihide_available ())
+		return;
+
+	asked->object = wl_proxy_marshal_flags (manager, MANAGER_GET_INTELLIHIDE,
+						&caminito_intellihide_v1_interface,
+						wl_proxy_get_version (manager), 0,
+						NULL, layer_surface);
+	asked->layer_surface = layer_surface;
+}
