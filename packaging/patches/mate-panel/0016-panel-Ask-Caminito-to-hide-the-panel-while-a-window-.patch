 static void
 panel_properties_dialog_setup_floating_toggle (PanelPropertiesDialog *dialog)
 {
@@ -454,7 +461,7 @@ panel_properties_dialog_setup_floating_toggle (PanelPropertiesDialog *dialog)
 
 	gtk_box_pack_start (GTK_BOX (dialog->general_vbox), dialog->floating_toggle,
