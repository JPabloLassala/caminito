diff --git a/mate-panel/wayland-backend.c b/mate-panel/wayland-backend.c
index 1d5c8eb8..ee2b93d9 100644
--- a/mate-panel/wayland-backend.c
+++ b/mate-panel/wayland-backend.c
@@ -33,6 +33,7 @@
 #include <gtk-layer-shell.h>
 
 #include "wayland-backend.h"
+#include "wayland-intellihide.h"
 #include "panel-multimonitor.h"
 
 static void
@@ -182,6 +183,41 @@ wayland_panel_toplevel_update_placement (PanelToplevel* toplevel)
 	wayland_panel_toplevel_apply_anchors (toplevel, orientation, expand);
 }
 
+/* Whether the panel asks the compositor to hide it while a window overlaps
+ * it: its Intellihide is on, and the compositor is Caminito, the one that
+ * offers intellihide. With either missing the panel is an ordinary one. */
+gboolean
+wayland_panel_toplevel_has_intellihide (PanelToplevel* toplevel)
+{
+	return panel_toplevel_get_intellihide (toplevel) &&
+	       wayland_intellihide_available ();
+}
+
+/* Asks the compositor for intellihide on the panel's layer surface, or stops
+ * asking. */
+void
+wayland_panel_toplevel_update_intellihide (PanelToplevel* toplevel)
+{
+	wayland_intellihide_update (GTK_WINDOW (toplevel),
+				    wayland_panel_toplevel_has_intellihide (toplevel));
+}
+
+/* The layer surface is made when the panel maps, and again when it maps on
+ * another monitor, and ends when it unmaps. */
+static void
+wayland_panel_toplevel_mapped (GtkWidget* widget,
+			       gpointer   data)
+{
+	wayland_panel_toplevel_update_intellihide (PANEL_TOPLEVEL (widget));
+}
+
+static void
+wayland_panel_toplevel_unmapped (GtkWidget* widget,
+				 gpointer   data)
+{
+	wayland_intellihide_update (GTK_WINDOW (widget), FALSE);
+}
+
 void
 wayland_panel_toplevel_init (PanelToplevel* toplevel)
 {
@@ -192,6 +228,12 @@ wayland_panel_toplevel_init (PanelToplevel* toplevel)
 	gtk_layer_set_layer (window, GTK_LAYER_SHELL_LAYER_TOP);
 	gtk_layer_set_namespace (window, "panel");
 	wayland_panel_toplevel_update_placement (toplevel);
+
+	/* After the class handler, which makes the layer surface. */
+	g_signal_connect_after (toplevel, "map",
+				G_CALLBACK (wayland_panel_toplevel_mapped), NULL);
+	g_signal_connect (toplevel, "unmap",
+			  G_CALLBACK (wayland_panel_toplevel_unmapped), NULL);
 }
 
