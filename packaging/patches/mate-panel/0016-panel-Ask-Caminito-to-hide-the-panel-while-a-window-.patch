-	gtk_box_reorder_child (GTK_BOX (dialog->general_vbox), dialog->floating_toggle, 4);
+	gtk_box_reorder_child (GTK_BOX (dialog->general_vbox), dialog->floating_toggle, 5);
 	gtk_widget_show (dialog->floating_toggle);
 
 	if (! panel_profile_key_is_writable (dialog->toplevel, PANEL_TOPLEVEL_FLOATING_KEY)) {
@@ -573,6 +580,45 @@ panel_properties_dialog_setup_icon_chooser (PanelPropertiesDialog *dialog,
 
 SETUP_TOGGLE_BUTTON ("expand_toggle",      expand_toggle,      expand,           PANEL_TOPLEVEL_EXPAND_KEY)
 SETUP_TOGGLE_BUTTON ("autohide_toggle",    autohide_toggle,    auto_hide,        PANEL_TOPLEVEL_AUTO_HIDE_KEY)
+SETUP_TOGGLE_BUTTON ("intellihide_toggle", intellihide_toggle, intellihide,      PANEL_TOPLEVEL_INTELLIHIDE_KEY)
+/* Intellihide is Caminito's: the toggle is there only where the compositor
+ * offers it, and a panel that hides itself when the pointer leaves doesn't
+ * also hide off the edge for a window, so each turns the other off. */
+static void
+panel_properties_dialog_autohide_turned_on (PanelPropertiesDialog *dialog,
+					    GtkToggleButton       *autohide_toggle)
+{
+	if (gtk_toggle_button_get_active (autohide_toggle) &&
+	    gtk_widget_get_visible (dialog->intellihide_toggle))
+		gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (dialog->intellihide_toggle), FALSE);
+}
+
+static void
+panel_properties_dialog_intellihide_turned_on (PanelPropertiesDialog *dialog,
+					       GtkToggleButton       *intellihide_toggle)
+{
+	if (gtk_toggle_button_get_active (intellihide_toggle))
+		gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (dialog->autohide_toggle), FALSE);
+}
+
+static void
+panel_properties_dialog_setup_intellihide_exclusion (PanelPropertiesDialog *dialog)
+{
+#ifdef HAVE_WAYLAND
+	if (!GDK_IS_WAYLAND_DISPLAY (gdk_display_get_default ()) ||
+	    !wayland_intellihide_available ())
+		return;
+
+	gtk_widget_show (dialog->intellihide_toggle);
+	g_signal_connect_swapped (dialog->intellihide_toggle, "toggled",
+				  G_CALLBACK (panel_properties_dialog_intellihide_turned_on),
+				  dialog);
+	g_signal_connect_swapped (dialog->autohide_toggle, "toggled",
+				  G_CALLBACK (panel_properties_dialog_autohide_turned_on),
+				  dialog);
+#endif /* HAVE_WAYLAND */
+}
+
 SETUP_TOGGLE_BUTTON ("hidebuttons_toggle", hidebuttons_toggle, enable_buttons,   PANEL_TOPLEVEL_ENABLE_BUTTONS_KEY)
 SETUP_TOGGLE_BUTTON ("arrows_toggle",      arrows_toggle,      enable_arrows,    PANEL_TOPLEVEL_ENABLE_ARROWS_KEY)
 
@@ -929,6 +975,7 @@ panel_properties_dialog_toplevel_notify (GSettings             *settings,
 	}
 	else UPDATE_TOGGLE ("expand",         expand_toggle)
 	else UPDATE_TOGGLE ("auto-hide",      autohide_toggle)
+	else UPDATE_TOGGLE ("intellihide",    intellihide_toggle)
 	else UPDATE_TOGGLE ("enable-buttons", hidebuttons_toggle)
 	else UPDATE_TOGGLE ("enable-arrows",  arrows_toggle)
 }
@@ -1086,9 +1133,11 @@ panel_properties_dialog_remove_toggles (PanelPropertiesDialog *dialog)
 	GtkContainer *container = GTK_CONTAINER (dialog->general_vbox);
 
 	gtk_container_remove (container, dialog->autohide_toggle);
