 		 * Wayland desktop wallpaper services size their surfaces to the
 		 * reserved work area, so a reserved strip while hidden shows the
 		 * compositor's native background instead of the wallpaper. */
+		/* A panel that asks Caminito to hide it while a window overlaps
+		 * it can't keep its edge for itself, so it reserves nothing. */
 		if (strut == 0 ||
-		    toplevel->priv->state != PANEL_STATE_NORMAL)
+		    toplevel->priv->state != PANEL_STATE_NORMAL ||
+		    wayland_panel_toplevel_has_intellihide (toplevel))
 			exclusive = 0;
 		else
 			exclusive = strut;
@@ -4411,6 +4416,9 @@ panel_toplevel_set_property (GObject      *object,
 	case PROP_AUTOHIDE:
 		panel_toplevel_set_auto_hide (toplevel, g_value_get_boolean (value));
 		break;
+	case PROP_INTELLIHIDE:
+		panel_toplevel_set_intellihide (toplevel, g_value_get_boolean (value));
+		break;
