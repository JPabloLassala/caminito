 		break;
@@ -4391,6 +4460,9 @@ panel_toplevel_get_property (GObject    *object,
 	case PROP_EXPAND:
 		g_value_set_boolean (value, toplevel->priv->expand);
 		break;
+	case PROP_FLOATING:
+		g_value_set_boolean (value, toplevel->priv->floating_panel);
+		break;
 	case PROP_ORIENTATION:
 		g_value_set_enum (value, toplevel->priv->orientation);
 		break;
@@ -4561,6 +4633,16 @@ panel_toplevel_class_init (PanelToplevelClass *klass)
 			TRUE,
 			G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
 
+	g_object_class_install_property (
+		gobject_class,
+		PROP_FLOATING,
+		g_param_spec_boolean (
+			"floating",
+			"Floating",
+			"Stand off the screen edge, under Caminito",
+			FALSE,
+			G_PARAM_READWRITE | G_PARAM_CONSTRUCT));
+
 	g_object_class_install_property (
 		gobject_class,
 		PROP_ORIENTATION,
@@ -5712,6 +5794,57 @@ panel_toplevel_set_auto_hide (PanelToplevel *toplevel,
 	g_object_notify (G_OBJECT (toplevel), "auto-hide");
 }
 
+void
+panel_toplevel_set_floating (PanelToplevel *toplevel,
+			     gboolean       floating)
+{
+	g_return_if_fail (PANEL_IS_TOPLEVEL (toplevel));
+
+	floating = floating != FALSE;
+
+	if (toplevel->priv->floating_panel == floating)
+		return;
+
+	toplevel->priv->floating_panel = floating;
+
+	if (gtk_widget_get_realized (GTK_WIDGET (toplevel))) {
+		panel_toplevel_move_resize_window (toplevel, TRUE, TRUE);
+		gtk_widget_queue_draw (GTK_WIDGET (toplevel));
+	}
+
+	g_object_notify (G_OBJECT (toplevel), "floating");
+}
+
+gboolean
+panel_toplevel_get_floating (PanelToplevel *toplevel)
+{
+	g_return_val_if_fail (PANEL_IS_TOPLEVEL (toplevel), FALSE);
+
+	return toplevel->priv->floating_panel;
+}
+
+/* The gap between a floating panel and its screen edge, in pixels: 0 for a panel
+ * that isn't floating, a drawer, and anywhere but Caminito's Wayland, where the
+ * property does nothing. 0 too while the panel is autohidden, so that it leaves
+ * its strip at the edge. The panel stands off only the edge it is at, so that a
+ * panel that isn't expanded stays centred along it, as it does lined up. */
+int
+panel_toplevel_get_floating_margin (PanelToplevel *toplevel)
+{
+	g_return_val_if_fail (PANEL_IS_TOPLEVEL (toplevel), 0);
+
+#ifdef HAVE_WAYLAND
+	if (toplevel->priv->floating_panel &&
+	    !toplevel->priv->attached &&
+	    toplevel->priv->state != PANEL_STATE_AUTO_HIDDEN &&
+	    GDK_IS_WAYLAND_DISPLAY (gtk_widget_get_display (GTK_WIDGET (toplevel))) &&
+	    panel_multimonitor_is_caminito ())
+		return PANEL_FLOATING_MARGIN;
+#endif /* HAVE_WAYLAND */
+
+	return 0;
+}
+
 gboolean
 panel_toplevel_get_auto_hide (PanelToplevel *toplevel)
 {
diff --git a/mate-panel/panel-toplevel.h b/mate-panel/panel-toplevel.h
index 2d8961c0..2c6ee4f3 100644
--- a/mate-panel/panel-toplevel.h
+++ b/mate-panel/panel-toplevel.h
@@ -149,6 +149,10 @@ void                 panel_toplevel_pop_autohide_disabler  (PanelToplevel
 void                 panel_toplevel_set_auto_hide          (PanelToplevel       *toplevel,
                                                             gboolean             autohide);
 gboolean             panel_toplevel_get_auto_hide          (PanelToplevel       *toplevel);
+void                 panel_toplevel_set_floating           (PanelToplevel       *toplevel,
+                                                            gboolean             floating);
+gboolean             panel_toplevel_get_floating           (PanelToplevel       *toplevel);
+int                  panel_toplevel_get_floating_margin    (PanelToplevel       *toplevel);
 void                 panel_toplevel_set_hide_delay         (PanelToplevel       *toplevel,
                                                             int                  hide_delay);
 int                  panel_toplevel_get_hide_delay         (PanelToplevel       *toplevel);
diff --git a/mate-panel/wayland-backend.c b/mate-panel/wayland-backend.c
index 4030bacd..1d5c8eb8 100644
--- a/mate-panel/wayland-backend.c
+++ b/mate-panel/wayland-backend.c
@@ -234,6 +234,24 @@ wayland_panel_toplevel_move_resize (PanelToplevel           *toplevel,
 		}
 	}
 
+	/* A floating panel stands off the edge it is anchored to. The other
+	 * axis is as it was: an expanded panel is anchored along it, and one
+	 * that isn't is centred. */
+	switch (panel_toplevel_get_orientation (toplevel)) {
+	case PANEL_ORIENTATION_TOP:
+		margin[GTK_LAYER_SHELL_EDGE_TOP] += panel_toplevel_get_floating_margin (toplevel);
+		break;
+	case PANEL_ORIENTATION_BOTTOM:
+		margin[GTK_LAYER_SHELL_EDGE_BOTTOM] += panel_toplevel_get_floating_margin (toplevel);
+		break;
+	case PANEL_ORIENTATION_LEFT:
+		margin[GTK_LAYER_SHELL_EDGE_LEFT] += panel_toplevel_get_floating_margin (toplevel);
+		break;
+	case PANEL_ORIENTATION_RIGHT:
+		margin[GTK_LAYER_SHELL_EDGE_RIGHT] += panel_toplevel_get_floating_margin (toplevel);
+		break;
+	}
+
 	for (int i = 0; i < GTK_LAYER_SHELL_EDGE_ENTRY_NUMBER; i++)
 		gtk_layer_set_margin (window, i, margin[i]);
 }
