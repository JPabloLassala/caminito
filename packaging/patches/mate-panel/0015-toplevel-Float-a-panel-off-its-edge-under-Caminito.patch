diff --git a/mate-panel/panel-multimonitor.c b/mate-panel/panel-multimonitor.c
index de556bae..7a3fc044 100644
--- a/mate-panel/panel-multimonitor.c
+++ b/mate-panel/panel-multimonitor.c
@@ -94,6 +94,22 @@ panel_multimonitor_get_caminito_primary (void)
 	return connector;
 }
 
+/* Whether Caminito is there: it owns its name and has told its primary output,
+ * as it does from its start. A carried patch's Caminito-only behaviour turns on
+ * for it alone. */
+gboolean
+panel_multimonitor_is_caminito (void)
+{
+	char     *connector;
+	gboolean  owned;
+
+	connector = panel_multimonitor_get_caminito_primary ();
+	owned = connector != NULL;
+	g_free (connector);
+
+	return owned;
+}
