# Arch's mate-session-manager PKGBUILD with the smallest diff (16), so a change there shows
# what to carry over. The differences: the name, the pinned commit and its pkgver(), provides
# and conflicts, and the carried patches (ADR 0011).

pkgname=mate-session-manager-caminito
_pkgname=mate-session-manager
# mate-session-manager has no 1.29 tag, so the baseline is a master commit (16). It's pinned,
# so the package needs no -git suffix. The weekly job builds the patches on master instead.
_commit=57a9178e766cd02176dc1c2d70cc48f963ee9fff
pkgver=1.28.0.r23.g57a9178
pkgrel=7
pkgdesc="The MATE Session Handler, with Caminito's patches"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-session-manager'
license=(GPL-2.0-or-later)
depends=(
  bash
  cairo
  dbus
  dbus-glib
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libepoxy
  libgcc
  libglvnd
  libice
  libsm
  libx11
  libxau
  libxcomposite
  libxext
  libxrender
  libxtst
  mate-desktop
  systemd-libs
)
makedepends=(
  docbook-xsl
  git
  glib2-devel
  mate-common
  xmlto
  xtrans
)
optdepends=(
  'gnome-keyring: keyring support'
  'xdg-user-dirs-gtk: manage user directories'
)
groups=(mate)
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# Every patch is active only when MATE_WM_NAME=Caminito (08, ADR 0004; 78, 206, CMN-195 and
# CMN-214, ADR 0014).
# The patches are kept once for every distribution, in packaging/patches/ (ADR 0030), and
# tools/bootstrap copies them beside the PKGBUILD before makepkg (ADR 0052).
source=(
  "git+https://github.com/mate-desktop/mate-session-manager.git#commit=$_commit"
  git+https://github.com/mate-desktop/mate-submodules.git
  "0001-main-Unset-GDK_BACKEND-under-Caminito.patch"
  "0002-main-Skip-the-windowmanager-required-component-under.patch"
  "0003-autostart-Skip-X11-only-entries-under-Caminito.patch"
  "0004-autostart-Start-mate-power-manager-and-tilda-on-X11-.patch"
)
b2sums=(
  ef165f32eef80783df69906d7054bd51133099b10141a033a269c33086dd66a9f60315b6b10b95c72e1d25662a9d9870aba5c9546cb99865d6ba0b6716efa55b
  SKIP
  79e304146b97b1fcdd07f25aa88afa1f8b09cb692101c8d02fc8c023a0f630b9b1aa5be998fe0079669db8e46073df254e0e2aefbbc607a012420b6608e6db06
  c7425bf55dc429dd784a04ab9b4066db94198d33016b01483ae3193a118cd91d7d0cc6e4b12aa8f3410c074512774d0ce3fc5075d312d793bfecb52c28472d19
  8c81ed3872aa20e30ca7605ce8dbd006453b8c7c9d452ee4b7d6c35b539446345c13fe45b8101270292f1c8a27f2d9562d838d6b7d71a889e4367d84091d169d
  b3c5aeb7ed240d6075245b825e25ef794a959a86c64f654b63af03db0f0fa06a621858f9afdfe97bc13500bf540181059d1730fea2d74001ca87586c7e2d76a7
)

pkgver() {
  cd $_pkgname
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_pkgname

  git submodule init
  git config submodule.mate-submodules.url "$srcdir/mate-submodules"
  git -c protocol.file.allow=always submodule update

  local src
  for src in "${source[@]}"; do
    [[ $src = *.patch ]] || continue
    patch -Np1 -i "$srcdir/${src##*/}"
  done

  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --libexecdir="/usr/lib/$_pkgname" \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
