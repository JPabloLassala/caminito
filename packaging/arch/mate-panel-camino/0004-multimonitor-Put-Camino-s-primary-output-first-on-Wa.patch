From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Mon, 5 Oct 2026 12:00:00 -0300
Subject: [PATCH] multimonitor: Put Camino's primary output first on Wayland

On X11 the panel puts RANDR's primary output first, so that monitor 0, where
the panels are by default, is the primary one. Wayland has no primary
output, so there the monitors were in GDK's order, and the panel never named
its output: the compositor chose one, which need not be the monitor whose
size the panel had laid itself out for.

Camino, the Wayland compositor, has a primary output, the PrimaryOutput
property of org.mate.Camino on the session bus. While that name has an
owner, put its output first, name the panel's output to the compositor, and
do both again when the property changes, so the panel follows the primary
output. gtk-layer-shell maps the surface again on its new output.

Without an owner of org.mate.Camino, which is X11 and any other Wayland
compositor, nothing changes.
---
 mate-panel/panel-multimonitor.c | 127 ++++++++++++++++++++++++++++++++
 mate-panel/panel-multimonitor.h |   2 +
 mate-panel/wayland-backend.c    |  16 +++-
 3 files changed, 144 insertions(+), 1 deletion(-)

diff --git a/mate-panel/panel-multimonitor.c b/mate-panel/panel-multimonitor.c
index ca392d6b..08352272 100644
--- a/mate-panel/panel-multimonitor.c
+++ b/mate-panel/panel-multimonitor.c
@@ -41,6 +41,11 @@
 #include "panel-multimonitor.h"
 
 #include <string.h>
+#include <gio/gio.h>
+
+#define CAMINO_NAME      "org.mate.Camino"
+#define CAMINO_PATH      "/org/mate/Camino"
+#define CAMINO_INTERFACE "org.mate.Camino"
 
 /*
  * The number of logical monitors we are keeping track of
@@ -59,6 +64,36 @@ static gboolean       initialized = FALSE;
 static gboolean       have_randr  = FALSE;
 static guint          reinit_id   = 0;
 
+/*
+ * Camino, the Wayland compositor, which has a primary output where Wayland
+ * has none. NULL on X11, and its PrimaryOutput is unset while nothing owns
+ * its name, which is any other compositor.
+ */
+static GDBusProxy    *camino        = NULL;
+static gboolean       camino_looked = FALSE;
+
+/* The connector of Camino's primary output, or NULL where Camino isn't running. */
+static char *
+panel_multimonitor_get_camino_primary (void)
+{
+	GVariant *value;
+	char     *connector = NULL;
+
+	if (camino == NULL)
+		return NULL;
+
+	value = g_dbus_proxy_get_cached_property (camino, "PrimaryOutput");
+	if (value == NULL)
+		return NULL;
+
+	if (g_variant_is_of_type (value, G_VARIANT_TYPE_STRING) &&
+	    g_variant_get_string (value, NULL)[0] != '\0')
+		connector = g_variant_dup_string (value, NULL);
+	g_variant_unref (value);
+
+	return connector;
+}
+
 #ifdef HAVE_X11
 #ifdef HAVE_RANDR
 static gboolean
@@ -227,6 +262,7 @@ panel_multimonitor_get_gdk_monitors (int           *monitors_ret,
 	GdkDisplay   *display;
 	int           num_monitors;
 	GdkRectangle *geometries_array;
+	char         *primary;
 	int           i;
 
 	display = gdk_display_get_default ();
@@ -236,6 +272,30 @@ panel_multimonitor_get_gdk_monitors (int           *monitors_ret,
 	for (i = 0; i < num_monitors; i++)
 		gdk_monitor_get_geometry (gdk_display_get_monitor (display, i), &(geometries_array[i]));
 
+	/* Camino's primary output goes first, as RANDR's does on X11, so that
+	 * monitor 0, where the panels are by default, is the primary one. */
+	primary = panel_multimonitor_get_camino_primary ();
+	for (i = 1; primary != NULL && i < num_monitors; i++) {
+		GdkRectangle  first;
+		char         *connector;
+		gboolean      is_primary;
+
+		G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+		connector = gdk_screen_get_monitor_plug_name (gdk_display_get_default_screen (display), i);
+		G_GNUC_END_IGNORE_DEPRECATIONS
+		is_primary = g_strcmp0 (connector, primary) == 0;
+		g_free (connector);
+
+		if (is_primary) {
+			first = geometries_array[i];
+			memmove (&geometries_array[1], &geometries_array[0],
+				 sizeof (geometries_array[0]) * i);
+			geometries_array[0] = first;
+			break;
+		}
+	}
+	g_free (primary);
+
 	*monitors_ret = num_monitors;
 	*geometries_ret = geometries_array;
 }
@@ -410,6 +470,40 @@ panel_multimonitor_handle_monitor_invalidate (GdkMonitor *monitor,
 	reinit_id = g_idle_add (panel_multimonitor_reinit_idle, NULL);
 }
 
+static void
+panel_multimonitor_handle_camino_changed (void)
+{
+	if (reinit_id)
+		return;
+
+	reinit_id = g_idle_add (panel_multimonitor_reinit_idle, NULL);
+}
+
+/* Looks for Camino, once. Its primary output, and Camino coming or going,
+ * lay the monitors out again. */
+static void
+panel_multimonitor_init_camino (GdkDisplay *display)
+{
+	if (camino_looked || GDK_IS_X11_DISPLAY (display))
+		return;
+
+	camino_looked = TRUE;
+	camino = g_dbus_proxy_new_for_bus_sync (G_BUS_TYPE_SESSION,
+						G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+						NULL,
+						CAMINO_NAME,
+						CAMINO_PATH,
+						CAMINO_INTERFACE,
+						NULL, NULL);
+	if (camino == NULL)
+		return;
+
+	g_signal_connect (camino, "g-properties-changed",
+			  G_CALLBACK (panel_multimonitor_handle_camino_changed), NULL);
+	g_signal_connect (camino, "notify::g-name-owner",
+			  G_CALLBACK (panel_multimonitor_handle_camino_changed), NULL);
+}
+
 #ifdef HAVE_X11
 #ifdef HAVE_RANDR
 static void
@@ -464,6 +558,8 @@ panel_multimonitor_init (void)
 #endif /* HAVE_RANDR */
 #endif /* HAVE_X11 */
 
+	panel_multimonitor_init_camino (display);
+
 	/*
 	 * The screen signals probably shouldn't be needed, but sometimes on X11 they are
 	 * the only ones that get fired
@@ -549,6 +645,37 @@ panel_multimonitor_height (int monitor)
 	return geometries [monitor].height;
 }
 
+/* The GdkMonitor that is the panel's monitor, where Camino says which output
+ * is the primary one. NULL anywhere else: the panel's monitors are then in
+ * GDK's order, and a Wayland compositor is left to place it, as before. */
+GdkMonitor *
+panel_multimonitor_get_camino_monitor (int monitor)
+{
+	GdkDisplay *display;
+	char       *primary;
+	int         i;
+
+	g_return_val_if_fail (monitor >= 0 && monitor < monitor_count, NULL);
+
+	primary = panel_multimonitor_get_camino_primary ();
+	if (primary == NULL)
+		return NULL;
+	g_free (primary);
+
+	display = gdk_display_get_default ();
+	for (i = 0; i < gdk_display_get_n_monitors (display); i++) {
+		GdkMonitor   *gdk_monitor;
+		GdkRectangle  geometry;
+
+		gdk_monitor = gdk_display_get_monitor (display, i);
+		gdk_monitor_get_geometry (gdk_monitor, &geometry);
+		if (gdk_rectangle_equal (&geometry, &geometries[monitor]))
+			return gdk_monitor;
+	}
+
+	return NULL;
+}
+
 int
 panel_multimonitor_locate_widget_monitor (GtkWidget *widget)
 {
diff --git a/mate-panel/panel-multimonitor.h b/mate-panel/panel-multimonitor.h
index aa10cda3..a70591f1 100644
--- a/mate-panel/panel-multimonitor.h
+++ b/mate-panel/panel-multimonitor.h
@@ -39,6 +39,8 @@ int	panel_multimonitor_y                     (int monitor);
 int	panel_multimonitor_width                 (int monitor);
 int	panel_multimonitor_height                (int monitor);
 
+GdkMonitor *panel_multimonitor_get_camino_monitor (int monitor);
+
 int	panel_multimonitor_locate_widget_monitor (GtkWidget *widget);
 int	panel_multimonitor_get_monitor_at_point  (int x, int y);
 void	panel_multimonitor_is_at_visible_extreme (int        monitor_id,
diff --git a/mate-panel/wayland-backend.c b/mate-panel/wayland-backend.c
index 68cd1cc3..8bba24e1 100644
--- a/mate-panel/wayland-backend.c
+++ b/mate-panel/wayland-backend.c
@@ -33,6 +33,7 @@
 #include <gtk-layer-shell.h>
 
 #include "wayland-backend.h"
+#include "panel-multimonitor.h"
 
 static void
 wayland_panel_toplevel_apply_anchors (PanelToplevel*   toplevel,
@@ -199,10 +200,17 @@ wayland_panel_toplevel_move_resize (PanelToplevel           *toplevel,
                                     const GdkRectangle      *monitor_geom)
 {
 	GtkWindow* window;
+	GdkMonitor *monitor;
 	gint margin[GTK_LAYER_SHELL_EDGE_ENTRY_NUMBER];
 
 	window = GTK_WINDOW (toplevel);
 
+	/* Under Camino the panel names its output, so that it is on the primary
+	 * one and follows it. A change of output maps the surface again. */
+	monitor = panel_multimonitor_get_camino_monitor (panel_toplevel_get_monitor (toplevel));
+	if (monitor != NULL && gtk_layer_get_monitor (window) != monitor)
+		gtk_layer_set_monitor (window, monitor);
+
 	margin[GTK_LAYER_SHELL_EDGE_LEFT] = geometry->x - monitor_geom->x;
 	margin[GTK_LAYER_SHELL_EDGE_TOP]  = geometry->y - monitor_geom->y;
 	margin[GTK_LAYER_SHELL_EDGE_RIGHT] =
@@ -305,6 +313,7 @@ wayland_panel_toplevel_autohide_window_show (GtkWindow          *window,
 					     const GdkRectangle *monitor_geom)
 {
 	GdkDisplay *display;
+	GdkMonitor *camino_monitor;
 	int         monitor;
 	int         n_monitors;
 
@@ -313,8 +322,13 @@ wayland_panel_toplevel_autohide_window_show (GtkWindow          *window,
 	monitor = panel_toplevel_get_monitor (toplevel);
 	if (monitor < 0 || monitor >= n_monitors)
 		monitor = 0;
+	camino_monitor = panel_multimonitor_get_camino_monitor (monitor);
 
-	gtk_layer_set_monitor (window, gdk_display_get_monitor (display, monitor));
+	/* Under Camino the panel's monitors aren't in GDK's order. */
+	if (camino_monitor != NULL)
+		gtk_layer_set_monitor (window, camino_monitor);
+	else
+		gtk_layer_set_monitor (window, gdk_display_get_monitor (display, monitor));
 
 	gtk_widget_set_size_request (GTK_WIDGET (window),
 				     geometry->width, geometry->height);
