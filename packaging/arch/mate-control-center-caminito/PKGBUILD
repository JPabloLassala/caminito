# Arch's mate-control-center PKGBUILD with the smallest diff (16), so a change there shows
# what to carry over. The differences: the name, the 1.29.1 tag, provides and conflicts, the
# carried patches in place of Arch's cherry-pick, which the tag has (ADR 0011), and
# libayatana-appindicator in libappindicator's place: configure takes it first, and the
# patched msd, which is always installed beside this, brings it.

pkgname=mate-control-center-caminito
_pkgname=mate-control-center
pkgver=1.29.1
pkgrel=3
pkgdesc="The Control Center for MATE, with Caminito's carried patches"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-control-center'
license=(GPL-2.0-or-later)
depends=(
  accountsservice
  at-spi2-core
  cairo
  dconf
  fontconfig
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gnome-themes-extra
  gtk3
  hicolor-icon-theme
  libayatana-appindicator
  libcanberra
  libgcc
  libgtop
  libmatekbd
  libx11
  libxcursor
  libxi
  libxklavier
  libxml2
  libxss
  marco
  mate-desktop
  mate-menus
  mate-panel
  mate-settings-daemon
  pango
  polkit
  udisks2
)
makedepends=(
  git
  glib2-devel
  mate-common
  yelp-tools
)
groups=(mate)
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# 0001 and 0002 are active only when MATE_WM_NAME=Caminito, off X11 (ADR 0011): wm-common
# names Caminito and the keybindings in MATE_WM_KEYBINDINGS, and the Windows capplet opens for
# Caminito as it does for Marco (06, 101). 0003 has no gate: it fixes Keyboard Shortcuts
# crashing at start-up on any display that isn't X11, which a gate would only keep for the
# other Wayland sessions. There the capplet opens now, and lists no window manager's
# shortcuts. 0004 and 0005 are gated as 0001 and 0002 are: the Mouse and Keyboard capplets run on
# XWayland, and Mouse always shows its touchpad page, since XWayland's devices aren't the
# machine's (06, 102).
source=(
  "git+https://github.com/mate-desktop/mate-control-center.git#tag=v$pkgver"
  0001-wm-common-Know-Caminito-from-the-environment-off-X11.patch
  0002-windows-Open-under-Caminito.patch
  0003-keybindings-Do-not-crash-on-a-display-that-isn-t-X11.patch
  0004-mouse-keyboard-Run-on-XWayland-under-Caminito.patch
  0005-mouse-Show-the-touchpad-page-under-Caminito.patch
)
b2sums=(
  5125854bee37563c54b9e22b23dc2b6670cc7453e2669b547c577394ea2250959fa76c0c7fe5df656a4b237a201835762ed7be4d49643ae99febe74ca9d7065a
  7969f32ce293e3bde6f4ad2838549cfa147bbd93994b9f748d967ae16f99750fc7a4a918a6c680d44d2830f12524ab8c5914543c20e73fa31f581ce7ad031f40
  2fbab824dc168268dc7e39f8bf145bc7e714447e558906298c7a5d999f10928bdbde8d08ea41b4caf9ab532c7a592e87c46ce8f835159a3783e2f350f3af15c6
  d0d2f81406c957c47aff78181a061473f31a4ddf1813c942be1d96070f25f334ff9d1001bedd7f699bda5cc0d5f806cfb6c57d83adbce4135af5472a1056680f
  c2e1bbc9eca4545f90e90b4601ec574404834108820edb114ae2a7dfe5989deccf4bd0a7c4c342e8939123146d096bc9dbdec5fb75b1bc3a4475c1cc78a6cf0b
  12d7a2018fb7b01327c7daa3134060f7de67752a2f1cc35cb048c4fba55e04b5f13fc037f42017d2d02ea9f3d09a51e1e181640406be084482041a7f73bbf109
)

prepare() {
  cd $_pkgname

  local src
  for src in "${source[@]}"; do
    [[ $src = *.patch ]] || continue
    patch -Np1 -i "$srcdir/$src"
  done

  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-update-mimedb
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
  rm "$pkgdir/usr/share/applications/mimeinfo.cache"
}
