From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Wed, 7 Oct 2026 00:25:32 -0300
Subject: [PATCH] plugin-info: Start an X11Only plugin under Camino when it
 says it can

A plugin with X11Only=true is not loaded on a Wayland display. Under
Camino, the Wayland compositor for MATE, some of these plugins can do
through Camino what they do through X11: the media-keys plugin grabs its
keys over D-Bus there.

Such a plugin keeps X11Only=true and adds Camino=true. When MATE_WM_NAME
is Camino, it is loaded on a Wayland display too. Without that variable,
and for a plugin without the key, nothing changes: on any other Wayland
compositor the plugin is not loaded, as before.
---
 mate-settings-daemon/mate-settings-plugin-info.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/mate-settings-daemon/mate-settings-plugin-info.c b/mate-settings-daemon/mate-settings-plugin-info.c
index 282ffbf..93283f6 100644
--- a/mate-settings-daemon/mate-settings-plugin-info.c
+++ b/mate-settings-daemon/mate-settings-plugin-info.c
@@ -65,6 +65,7 @@ struct MateSettingsPluginInfoPrivate
         guint                    active : 1;
         guint                    x11_only : 1;
         guint                    wayland_only : 1;
+        guint                    camino : 1;
 
         /* A plugin is unavailable if it is not possible to activate it
            due to an error loading the plugin module */
@@ -265,6 +266,10 @@ mate_settings_plugin_info_fill_from_file (MateSettingsPluginInfo *info,
         info->priv->wayland_only =
                 g_key_file_get_boolean (plugin_file, PLUGIN_GROUP, "WaylandOnly", NULL);
 
+        /* Get Camino */
+        info->priv->camino =
+                g_key_file_get_boolean (plugin_file, PLUGIN_GROUP, "Camino", NULL);
+
         g_key_file_free (plugin_file);
 
         debug_info (info);
@@ -428,6 +433,15 @@ mate_settings_plugin_info_activate (MateSettingsPluginInfo *info)
 #else
                 gboolean x11 = FALSE;
 #endif
+                /* An X11Only plugin with Camino=true also runs under Camino,
+                 * the Wayland compositor for MATE, where it does through
+                 * Camino what it does through X11. */
+                if (!x11 && info->priv->camino &&
+                    g_strcmp0 (g_getenv ("MATE_WM_NAME"), "Camino") == 0) {
+                        g_debug ("Plugin '%s' requires X11; loading it under Camino",
+                                 info->priv->name);
+                        x11 = TRUE;
+                }
                 if (!x11) {
                         g_debug ("Plugin '%s' requires X11; not loading on this display",
                                  info->priv->name);
