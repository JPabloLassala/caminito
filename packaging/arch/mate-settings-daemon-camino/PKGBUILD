  d0247bda6f14dca8317e25aef4980823e7a3151251f1de36fd3fb0ba15b9a58ebb21fb14a17495538cd90636d69beca1c3aa05a1433d6af10d0e46309652ce34
)

prepare() {
  cd $_pkgname

  local src
  for src in "${source[@]}"; do
    [[ $src = *.patch ]] || continue
    patch -Np1 -i "$srcdir/$src"
  done

  autoreconf -fiv
}

build() {
  cd $_pkgname
  # --enable-wayland makes a missing Wayland library an error. Without it, configure turns
  # the wlrandr plugin and the Wayland background and clipboard off and says nothing.
  ./configure \
    --prefix=/usr \
    --libexecdir="/usr/lib/$_pkgname" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-pulse \
    --enable-wayland
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
