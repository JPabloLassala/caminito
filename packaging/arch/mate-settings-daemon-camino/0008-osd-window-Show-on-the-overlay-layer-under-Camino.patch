From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Juan Pablo Lassala <jpablolassala@gmail.com>
Date: Wed, 7 Oct 2026 00:26:11 -0300
Subject: [PATCH] osd-window: Show on the overlay layer under Camino

The OSD window is an override-redirect window that the media-keys plugin
moves to the lower half of the monitor with the pointer. A Wayland client
can do neither: it cannot place a window, and its window would be under a
fullscreen one.

When MATE_WM_NAME is Camino, the Wayland compositor for MATE, and the
display is a Wayland one, make the window a gtk-layer-shell surface on the
overlay layer, with no keyboard, so that it is above a fullscreen window
and never takes the focus. It is anchored to the bottom edge with the
margin that puts it where it is on X11, and the compositor chooses the
output.

Without that variable, nothing changes.
---
 plugins/common/Makefile.am                  |  4 +-
 plugins/common/msd-osd-window.c             | 77 +++++++++++++++++++++
 plugins/common/msd-osd-window.h             |  2 +
 plugins/media-keys/msd-media-keys-manager.c |  6 ++
 4 files changed, 88 insertions(+), 1 deletion(-)

diff --git a/plugins/common/Makefile.am b/plugins/common/Makefile.am
index e5d86f6..29d2670 100644
--- a/plugins/common/Makefile.am
+++ b/plugins/common/Makefile.am
@@ -17,6 +17,7 @@ libcommon_la_CPPFLAGS = \
 libcommon_la_CFLAGS = \
 	$(SETTINGS_PLUGIN_CFLAGS)	\
 	$(XINPUT_CFLAGS)		\
+	$(GTK_LAYER_SHELL_CFLAGS)	\
 	$(AM_CFLAGS)			\
 	$(WARN_CFLAGS)
 
@@ -25,6 +26,7 @@ libcommon_la_LDFLAGS = \
 
 libcommon_la_LIBADD  = \
 	$(SETTINGS_PLUGIN_LIBS)		\
-	$(XINPUT_LIBS)
+	$(XINPUT_LIBS)			\
+	$(GTK_LAYER_SHELL_LIBS)
 
 -include $(top_srcdir)/git.mk
diff --git a/plugins/common/msd-osd-window.c b/plugins/common/msd-osd-window.c
index 5ac99a4..9caf403 100644
--- a/plugins/common/msd-osd-window.c
+++ b/plugins/common/msd-osd-window.c
@@ -38,6 +38,11 @@
 #include <gtk/gtk.h>
 #include <gdk/gdk.h>
 
+#ifdef HAVE_WAYLAND
+#include <gdk/gdkwayland.h>
+#include <gtk-layer-shell.h>
+#endif /* HAVE_WAYLAND */
+
 #include "msd-osd-window.h"
 
 #define DIALOG_TIMEOUT 2000     /* dialog timeout in ms */
@@ -351,6 +356,21 @@ msd_osd_window_get_preferred_height (GtkWidget *widget,
         *natural += padding.top;
 }
 
+/* Under Camino, the Wayland compositor for MATE, the window is a layer
+ * surface: a Wayland client cannot place a window of its own, nor keep it
+ * above a fullscreen one. */
+static gboolean
+use_layer_shell (void)
+{
+#ifdef HAVE_WAYLAND
+        return g_strcmp0 (g_getenv ("MATE_WM_NAME"), "Camino") == 0
+            && GDK_IS_WAYLAND_DISPLAY (gdk_display_get_default ())
+            && gtk_layer_is_supported ();
+#else
+        return FALSE;
+#endif /* HAVE_WAYLAND */
+}
+
 static GObject *
 msd_osd_window_constructor (GType                  type,
                             guint                  n_construct_properties,
@@ -368,6 +388,23 @@ msd_osd_window_constructor (GType                  type,
                       "focus-on-map", FALSE,
                       NULL);
 
+#ifdef HAVE_WAYLAND
+        if (use_layer_shell ()) {
+                /* On the overlay layer, above a fullscreen window, and with
+                 * no keyboard, so that it never takes the focus. With the
+                 * bottom edge alone anchored, the compositor centres it
+                 * across the output: the whole of it, panels and all, as
+                 * the exclusive zone of -1 asks. */
+                gtk_layer_init_for_window (GTK_WINDOW (object));
+                gtk_layer_set_namespace (GTK_WINDOW (object), "mate-osd");
+                gtk_layer_set_layer (GTK_WINDOW (object), GTK_LAYER_SHELL_LAYER_OVERLAY);
+                gtk_layer_set_keyboard_mode (GTK_WINDOW (object),
+                                             GTK_LAYER_SHELL_KEYBOARD_MODE_NONE);
+                gtk_layer_set_exclusive_zone (GTK_WINDOW (object), -1);
+                gtk_layer_set_anchor (GTK_WINDOW (object), GTK_LAYER_SHELL_EDGE_BOTTOM, TRUE);
+        }
+#endif /* HAVE_WAYLAND */
+
         GtkWidget *widget = GTK_WIDGET (object);
         GtkStyleContext *style_context = gtk_widget_get_style_context (widget);
         gtk_style_context_add_class (style_context, "osd");
@@ -432,6 +469,46 @@ msd_osd_window_is_valid (MsdOsdWindow *window)
             && scale_factor == window->priv->scale_factor;
 }
 
+/**
+ * msd_osd_window_place_on_layer:
+ * @window: a #MsdOsdWindow
+ * @height: the height @window is shown with
+ *
+ * Places @window where it is a layer surface, which is under Camino: in the
+ * middle of the lower half of its output, where the caller puts it on X11.
+ * The compositor chooses the output.
+ *
+ * Return value: FALSE if @window is not a layer surface, and the caller is
+ * to place it.
+ */
+gboolean
+msd_osd_window_place_on_layer (MsdOsdWindow *window,
+                               int           height)
+{
+#ifdef HAVE_WAYLAND
+        GdkMonitor  *monitor;
+        GdkRectangle geometry;
+
+        if (!gtk_layer_is_layer_window (GTK_WINDOW (window)))
+                return FALSE;
+
+        /* The output it was last shown on, or the first one. */
+        gtk_widget_realize (GTK_WIDGET (window));
+        monitor = gdk_display_get_monitor_at_window (gtk_widget_get_display (GTK_WIDGET (window)),
+                                                     gtk_widget_get_window (GTK_WIDGET (window)));
+        if (monitor != NULL) {
+                gdk_monitor_get_geometry (monitor, &geometry);
+                gtk_layer_set_margin (GTK_WINDOW (window),
+                                      GTK_LAYER_SHELL_EDGE_BOTTOM,
+                                      MAX (0, (geometry.height / 2 - height) / 2));
+        }
+
+        return TRUE;
+#else
+        return FALSE;
+#endif /* HAVE_WAYLAND */
+}
+
 static void
 msd_osd_window_init (MsdOsdWindow *window)
 {
diff --git a/plugins/common/msd-osd-window.h b/plugins/common/msd-osd-window.h
index 23651d2..6d04f59 100644
--- a/plugins/common/msd-osd-window.h
+++ b/plugins/common/msd-osd-window.h
@@ -79,6 +79,8 @@ GType                 msd_osd_window_get_type          (void);
 GtkWidget *           msd_osd_window_new               (void);
 gboolean              msd_osd_window_is_composited     (MsdOsdWindow      *window);
 gboolean              msd_osd_window_is_valid          (MsdOsdWindow      *window);
+gboolean              msd_osd_window_place_on_layer    (MsdOsdWindow      *window,
+                                                        int                height);
 void                  msd_osd_window_update_and_hide   (MsdOsdWindow      *window);
 
 #ifdef __cplusplus
diff --git a/plugins/media-keys/msd-media-keys-manager.c b/plugins/media-keys/msd-media-keys-manager.c
index 2d5428e..85aea84 100644
--- a/plugins/media-keys/msd-media-keys-manager.c
+++ b/plugins/media-keys/msd-media-keys-manager.c
@@ -460,6 +460,12 @@ dialog_show (MsdMediaKeysManager *manager)
                 orig_h = win_req.height;
         }
 
+        /* Under Camino it is a layer surface, which the compositor places. */
+        if (msd_osd_window_place_on_layer (MSD_OSD_WINDOW (manager->priv->dialog), orig_h)) {
+                gtk_widget_show (manager->priv->dialog);
+                return;
+        }
+
         pointer_screen = NULL;
         display = gdk_screen_get_display (manager->priv->current_screen);
         seat = gdk_display_get_default_seat (display);
