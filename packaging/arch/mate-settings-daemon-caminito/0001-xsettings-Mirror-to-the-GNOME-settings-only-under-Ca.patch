diff --git a/plugins/xsettings/msd-xsettings-manager.c b/plugins/xsettings/msd-xsettings-manager.c
index 879aa81..d37c722 100644
--- a/plugins/xsettings/msd-xsettings-manager.c
+++ b/plugins/xsettings/msd-xsettings-manager.c
@@ -47,6 +47,7 @@
 
 #include "mate-settings-profile.h"
 #include "msd-xsettings-manager.h"
+#include "msd-gnome-mirror.h"
 #include "xsettings-manager.h"
 #include "fontconfig-monitor.h"
 #include "wm-common.h"
@@ -119,6 +120,7 @@ struct MateXSettingsManagerPrivate
         GSettings *plugin_settings;
         fontconfig_monitor_handle_t *fontconfig_handle;
         gint window_scale;
+        MsdGnomeMirror *gnome_mirror;
 };
 
 #define MSD_XSETTINGS_ERROR msd_xsettings_error_quark ()
@@ -953,6 +955,18 @@ mate_xsettings_manager_start (MateXSettingsManager *manager,
         g_debug ("Starting xsettings manager");
         mate_settings_profile_start (NULL);
 
+        /* Caminito, the Wayland compositor for MATE, is the XSETTINGS manager of
+         * its XWayland server, so that the settings agree with its X11 scale
+         * and come back when XWayland starts again. What it cannot do for
+         * native Wayland applications is done here: the mirror into the GNOME
+         * keys that GTK reads. Nothing else of the manager starts. */
+        if (g_strcmp0 (g_getenv ("MATE_WM_NAME"), "Caminito") == 0) {
+                g_debug ("Under Caminito: mirroring to the GNOME settings only");
+                manager->priv->gnome_mirror = msd_gnome_mirror_new ();
+                mate_settings_profile_end (NULL);
+                return TRUE;
+        }
+
         if (!setup_xsettings_managers (manager)) {
                 g_set_error (error, MSD_XSETTINGS_ERROR,
                              MSD_XSETTINGS_ERROR_INIT,
@@ -1041,6 +1055,8 @@ mate_xsettings_manager_stop (MateXSettingsManager *manager)
 
         g_debug ("Stopping xsettings manager");
 
+        g_clear_pointer (&p->gnome_mirror, msd_gnome_mirror_free);
+
         if (p->managers != NULL) {
                 for (i = 0; p->managers [i]; ++i)
                         xsettings_manager_destroy (p->managers [i]);
