prepare() {
  cd $_pkgname

  local src
  for src in "${source[@]}"; do
    [[ $src = *.patch ]] || continue
    patch -Np1 -i "$srcdir/$src"
  done

  autoreconf -fiv
}

build() {
  cd $_pkgname
  # --enable-wayland makes a missing Wayland library an error. Without it, configure turns
  # the wlrandr plugin and the Wayland background and clipboard off and says nothing.
  ./configure \
    --prefix=/usr \
    --libexecdir="/usr/lib/$_pkgname" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-pulse \
    --enable-wayland
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
