# Arch's mate-settings-daemon PKGBUILD with the smallest diff (16), so a change there shows
# what to carry over. The differences: the name, the 1.29.1 tag, provides and conflicts, what
# the tag's Wayland code depends on, --enable-wayland, and the carried patches (ADR 0011).

pkgname=mate-settings-daemon-caminito
_pkgname=mate-settings-daemon
# The first tag with the Wayland background and clipboard. Its wlrandr plugin is off under
# Caminito, which keeps the saved layouts itself (0005, ADR 0014).
pkgver=1.29.1
pkgrel=6
pkgdesc="The MATE Settings daemon, with Caminito's carried patches"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-settings-daemon'
license=(GPL-2.0-or-later)
depends=(
  at-spi2-core
  cairo
  dbus
  dbus-glib
  dconf
  fontconfig
  gdk-pixbuf2
  glib2
  glibc
  gtk-layer-shell
  gtk3
  hicolor-icon-theme
  libayatana-appindicator
  libcanberra
  libgcc
  libmatekbd
  libmatemixer
  libnotify
  libpulse
  libx11
  libxi
  libxklavier
  mate-desktop
  nspr
  nss
  polkit
  wayland
)
makedepends=(
  git
  glib2-devel
  mate-common
  wayland-protocols
)
groups=(mate)
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# 0001 to 0003, 0005 and 0007 to 0011 are active only when MATE_WM_NAME=Caminito (ADR 0011).
# 0004 isn't Caminito's: it takes out the one upstream commit that needs mate-desktop 1.29,
# which Arch doesn't have. It goes when Arch's mate-desktop is 1.29. 0006 has no gate: it
# fixes the Wayland background's windows piling up at a hot-plug, on any compositor (88).
# 0007 to 0010 are the media keys and their OSD (99): 0007 lets an X11Only plugin that says
# Caminito=true load under Caminito, and 0010 is the plugin that says it. 0011 is the custom
# shortcuts (100), whose plugin says it too.
source=(
  "git+https://github.com/mate-desktop/mate-settings-daemon.git#tag=v$pkgver"
  0001-xsettings-Mirror-to-the-GNOME-settings-only-under-Ca.patch
  0002-background-Draw-under-Caja-s-desktop-under-Caminito.patch
  0003-typing-break-Do-not-start-under-Caminito.patch
  0004-Revert-xrandr-Handle-hotplug_mode_update-for-VM-gues.patch
  0005-wlrandr-Do-not-start-under-Caminito.patch
  0006-background-Do-not-rebuild-the-windows-from-inside-a-.patch
  0007-plugin-info-Start-an-X11Only-plugin-under-Caminito-w.patch
  0008-osd-window-Show-on-the-overlay-layer-under-Caminito.patch
  0009-input-helper-Take-a-touchpad-to-be-present-under-Cam.patch
  0010-media-keys-Grab-the-keys-through-Caminito.patch
  0011-keybindings-Grab-the-shortcuts-through-Caminito.patch
)
