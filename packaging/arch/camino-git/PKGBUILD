# Maintainer: jpablo <jpablolassala@gmail.com>

pkgname=camino-git
_pkgname=camino
pkgver=0
pkgrel=1
pkgdesc='Wayland compositor for the MATE desktop, the counterpart of Marco'
arch=(x86_64)
url='https://github.com/JPabloLassala/camino'
license=(GPL-2.0-or-later)
# Only what the binaries link (16), and what they load at run time. winit dlopens
# libwayland-client, libEGL and libxcb, which the desktop a nested run sits inside always
# has. On the tty (55), camino takes its seat through libseat (seatd's, which talks to
# logind too), finds the GPU with libudev (systemd-libs), drives it through mesa's GBM, reads
# EDIDs with libdisplay-info, reads its input devices with libinput (56), and dlopens
# libglvnd's libEGL. KMS itself is ioctls from Rust, so camino links no libdrm; mesa brings it
# for GBM. camino draws frames with cairo, pango and gdk-pixbuf2 (30), whose loaders need
# librsvg for SVG theme images; camino-gtk-palette links gtk3 and
# glib2 (28); camino reads marco's gsettings schemas (09), which marco provides; and
# mate-themes has Menta, the default theme, which marco doesn't pull in. camino spawns
# Xwayland (11, 34); its own X connection is x11rb's pure-Rust one, which links nothing, and
# the X11 test tier runs the same Xwayland from check().
#
# The last line is the session that `camino --session` starts (08, 17). The four patched
# packages are named by their real names, so the stock ones don't satisfy them (16, ADR
# 0011); caja draws the desktop, on the primary output (81), and mate-session autostarts the
# notification daemon and the polkit agent. camino links none of them.
#
# camino-displays (84) links gtk4, and through it cairo, pango and glib2. Its own Wayland
# connection needs nothing gtk4 doesn't bring. mate-control-center isn't a dependency: its
# Display capplet's entry is only shadowed, by the one Meson installs under
# /usr/share/camino/xdg.
depends=(glibc libgcc libxkbcommon glib2 cairo pango gdk-pixbuf2 librsvg gtk3 gtk4 marco mate-themes
  xorg-xwayland seatd systemd-libs mesa libdisplay-info libglvnd libinput
  mate-session-manager-camino mate-panel-camino mate-settings-daemon-camino caja-camino
  mate-notification-daemon mate-polkit)
makedepends=(cargo git meson)
# camino's tests link pixman for the headless backend, its test clients load
# libwayland-client (21), and they run on a private session bus (14).
checkdepends=(dbus pixman wayland)
provides=("$_pkgname")
conflicts=("$_pkgname")
# The local checkout's committed HEAD, so uncommitted work is never packaged. makepkg
# sources this from the PKGBUILD's directory, and namcap rejects naming that directory
# by its makepkg variable.
# This becomes the GitHub URL if the package is ever published (16).
source=("$_pkgname::git+file://$(git rev-parse --show-toplevel)")
sha256sums=('SKIP')
# The release build has no debug symbols to split out.
options=(!debug)

pkgver() {
  cd "$_pkgname"
  (
    set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  # makepkg keeps src/ between runs, and Meson keeps a build directory's flags when it's
  # set up again, so each build starts it afresh.
  rm -rf build
  arch-meson . build
  meson compile -C build
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # In release, so the tests reuse build()'s dependencies instead of compiling them again
  # in debug. CI runs them in debug.
  dbus-run-session -- cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  meson install -C build --destdir "$pkgdir"
  install -Dm755 target/release/camino target/release/camino-displays -t "$pkgdir/usr/bin"
}
