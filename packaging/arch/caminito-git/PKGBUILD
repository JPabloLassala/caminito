# Maintainer: jpablo <jpablolassala@gmail.com>

pkgname=caminito-git
_pkgname=caminito
pkgver=r1317.a55e1cf
pkgrel=1
pkgdesc='Wayland compositor for the MATE desktop, the counterpart of Marco'
arch=(x86_64)
url='https://github.com/JPabloLassala/caminito'
# The macOS Remap template, /usr/share/caminito/remap-templates/macos-pc.remaps, is converted
# from Toshy's config (https://github.com/RedBearAK/toshy, by RedBearAK), which is based on
# Kinto's (https://github.com/rbreaves/kinto, by Ben Reaves), and is GPL-3, as Toshy is
# (CMN-190).
license=(GPL-3.0-or-later GPL-3.0-only)
# Only what the binaries link (16), and what they load at run time. winit dlopens
# libwayland-client, libEGL and libxcb, which the desktop a nested run sits inside always
# has. On the tty (55), caminito takes its seat through libseat (seatd's, which talks to
# logind too), finds the GPU with libudev (systemd-libs), drives it through mesa's GBM, reads
# EDIDs with libdisplay-info, reads its input devices with libinput (56), and dlopens
# libglvnd's libEGL. KMS itself is ioctls from Rust, so caminito links no libdrm; mesa brings it
# for GBM. caminito draws frames with cairo, pango and gdk-pixbuf2 (30), whose loaders need
# librsvg for SVG theme images; caminito-gtk-palette links gtk3 and
# glib2 (28); caminito reads marco's gsettings schemas (09), which marco provides; and
# mate-themes has Menta, the default theme, which marco doesn't pull in. caminito spawns
# Xwayland (11, 34); its own X connection is x11rb's pure-Rust one, which links nothing, and
# the X11 test tier runs the same Xwayland from check(). caminito links libcanberra, which
# plays the bell and the workspace switch sounds (170, ADR 0027), and runs zenity for Marco's
# two dialogs: a command that can't run, and rename-workspace's (167).
#
# The last two lines are the session that `caminito --session` starts (08, 17). The seven
# patched packages are named by their real names, so the stock ones don't satisfy them (16,
# ADR 0011); caja draws the desktop, on the primary output (81), mate-utils has
# mate-screenshot, which the screenshot keys run (104), mate-power-manager has the
# brightness and power keys (107), and mate-session autostarts the polkit agent. caminito
# links none of them. mate-session-manager-caminito 1.28.0.r23.g57a9178-7 skips
# mate-notification-daemon's autostart, which caminito-notifications takes the place of.
#
# caminito-locker (131, ADR 0007) links gtk3, gtk-session-lock, mate-desktop and pam. It
# shows mate-screensaver's lock-dialog-*.ui themes and authenticates through its
# mate-screensaver PAM service, so it needs mate-screensaver's data though it links none of
# it; mate-screensaver's daemon exits under Caminito, which owns its name.
#
# caminito-displays (84) links gtk4, and through it cairo, pango and glib2. Its own Wayland
# connection needs nothing gtk4 doesn't bring. Its entry shadows the Display capplet's, from
# /usr/share/caminito/xdg. The control center's Windows and Keyboard Shortcuts dialogs are the
# patched package's (101), and Meson installs the keybinding manifests they list into its
# keybindings directory, which marco's own are in too; they list every action Caminito binds
# (173). Keyboard Shortcuts is System Shortcuts in a Session: its launcher is shadowed from
# /usr/share/caminito/xdg too, and the patched dialog takes its title from it (183). The
# logo (109) is in hicolor's scalable apps, a directory hicolor-icon-theme owns.
#
# caminito-about (182) links gtk4 and nothing else. Its entry is in /usr/share/caminito/xdg
# too.
#
# caminito-wallpaperd (210, ADR 0031), which the session starts to draw the wallpaper, links
# glib2 for its loop and GSettings, gdk-pixbuf2 to decode the pictures and cairo to draw them,
# and no GTK. Its Wayland connection is pure Rust. It reads org.mate.background, which
# mate-desktop has, on its first run. msd's background plugin is off under Caminito from
# mate-settings-daemon-caminito 1.29.1-8.
#
# caminito-wallpaper (212), the Wallpaper dialog that sets it, links gtk4. Its entry is in
# /usr/share/caminito/xdg too.
#
# caminito-behaviour (CMN-184), Workspace Behaviour, links gtk4, and writes the Hot corners'
# keys in Caminito's own schema. Its entry is in /usr/share/caminito/xdg too.
#
# glib-networking is GIO's TLS, which the drawer fetches a picture of the day with (214).
#
# caminito-bluetooth (255) links gtk4 and speaks to BlueZ over D-Bus, so the package depends on
# bluez, the daemon, and on nothing else for it. The Bluetooth applet (259, ADR 0035) is built
# against mate-panel's applet library, whose headers mate-panel-caminito has: the build
# depends on it through depends. The applet and caminito-bluetooth need nothing of Caminito,
# and work under X11 MATE too. The Thermal applet (267) reads its temperatures and fans
# through lm_sensors' libsensors. It's in Add to Panel only, not in the default panel (270).
# The Power applet (262), which is in the default panel (CMN-100), reads the batteries from
# upower, and the power profiles from power-profiles-daemon (or tuned-ppd, which has the same
# names) where one runs: without one, the popup has no profiles.
# The Network applet (CMN-193, ADR 0041), in the default panel beside the notification area
# (CMN-202), reads NetworkManager through libnm, and runs nm-connection-editor for its settings,
# an Enterprise network and a hidden one. caminito-network, its secret agent in a Session, links
# gtk4 and speaks to NetworkManager and the Secret Service over D-Bus, so it needs nothing more.
# The applet works under X11 MATE too, where caminito-network exits and nm-applet stays the
# agent.
# caminito-notifications (CMN-258, ADR 0051), the notification daemon that the session starts
# before mate-session, links gtk4, gtk4-layer-shell for the bubbles' layer surface, and
# libcanberra for their sounds. The package doesn't depend on mate-notification-daemon, nor
# conflict with it: X11 MATE keeps it.
# The Dock applet (CMN-219) reads the windows through libxfce4windowing, as mate-panel's window
# list does on Caminito (ADR 0013), and works under X11 MATE too. Its Trash is GIO's
# trash:///, which gvfs serves, as it does Caja (CMN-220).
depends=(glibc libgcc libxkbcommon glib2 cairo pango gdk-pixbuf2 librsvg gtk3 gtk4 marco mate-themes
  xorg-xwayland seatd systemd-libs mesa libdisplay-info libglvnd libinput libcanberra zenity
  gtk-session-lock mate-desktop pam mate-screensaver glib-networking
  'mate-session-manager-caminito>=1.28.0.r23.g57a9178-7' mate-panel-caminito
  'mate-settings-daemon-caminito>=1.29.1-8' caja-caminito
  mate-control-center-caminito mate-utils-caminito mate-power-manager-caminito
  mate-polkit hicolor-icon-theme bluez lm_sensors upower libnm
  nm-connection-editor libxfce4windowing gvfs gtk4-layer-shell)
# wayland's wayland-scanner makes the xdg-activation client the Dock applet asks for a launch's
# token with (CMN-221), from the XML it vendors.
makedepends=(cargo git meson wayland)
# The session puts the module in its command's GTK_MODULES when this package is installed,
# which it finds by the empty file the package installs, /usr/share/caminito/appmenu-gtk-module
# (111, 192). It's named by its real name, as the patched packages above are: the stock one
# tells Caminito nothing of a menubar in a plain GtkWindow.
# caminito-vscode-git is the global menu extension, linked into each editor (ADR 0022).
# caminito-firefox-global-menu sets Firefox's prefs and hides its empty Menu Bar toolbar (ADR 0053).
# libheif's heif-dec decodes a HEIC's pictures, run as a program, so nothing links it: without
# it the Wallpaper dialog greys HEICs out and says why (217).
optdepends=("appmenu-gtk-module-caminito: the menus of MATE's own apps in the panel's global menu"
  "libheif: Apple's HEIC dynamic wallpapers, decoded by its heif-dec (217)"
  "power-profiles-daemon: the power profiles in the Power applet's popup (264)"
  "caminito-vscode-git: the menus of VS Code, VSCodium, Code - OSS and Cursor in the panel's global menu"
  "caminito-firefox-global-menu: Firefox's menus in the panel's global menu")
# caminito's tests link pixman for the headless backend, its test clients load
# libwayland-client (21), and they run on a private session bus (14). caminito-bluetooth's
# run against python-dbusmock's BlueZ (255), and caminito-network's and the Network applet's
# against its NetworkManager. caminito-notifications's start a dbus-daemon of their own.
checkdepends=(dbus pixman wayland python-dbusmock)
provides=("$_pkgname")
conflicts=("$_pkgname")
# The GitHub repo, so the AUR repo, which has only this directory, builds too (ADR 0052).
source=("$_pkgname::git+https://github.com/JPabloLassala/caminito.git")
sha256sums=('SKIP')
# The release build has no debug symbols to split out.
options=(!debug)

pkgver() {
  cd "$_pkgname"
  (
    set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The revision in the version string (182), which `caminito --version` prints and
  # caminito-about shows: this package's, so they agree with `pacman -Q`.
  export CAMINITO_REVISION=$pkgver
  cargo build --frozen --release
  # makepkg keeps src/ between runs, and Meson keeps a build directory's flags when it's
  # set up again, so each build starts it afresh.
  rm -rf build
  arch-meson . build
  meson compile -C build
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # In release, so the tests reuse build()'s dependencies instead of compiling them again
  # in debug. tools/check runs them in debug.
  # The same revision as build()'s, or cargo would build caminito-version and what depends
  # on it again.
  export CAMINITO_REVISION=$pkgver
  dbus-run-session -- cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  meson install -C build --destdir "$pkgdir"
  install -Dm755 target/release/caminito target/release/caminito-displays \
    target/release/caminito-about target/release/caminito-wallpaperd \
    target/release/caminito-wallpaper target/release/caminito-bluetooth \
    target/release/caminito-behaviour target/release/caminito-network \
    target/release/caminito-notifications -t "$pkgdir/usr/bin"
}
