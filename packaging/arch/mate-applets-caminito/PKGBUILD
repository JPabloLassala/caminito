prepare() {
  cd $_pkgname

  # Geyes in-process: follow the mouse properly no matter where the applet is
  # https://github.com/mate-desktop/mate-applets/pull/675
  git cherry-pick -n e8e8d00cff2ade8e034681b2a3c8f5dd83fbb331

  # Set gettext domain for GtkBuilder
  # https://github.com/mate-desktop/mate-applets/pull/707
  git cherry-pick -n b9c7f05dca400eac0177f3e28d1c49895098841c

  # battstat: Fix reopening preferences after closing the window
  # https://github.com/mate-desktop/mate-applets/pull/713
  git cherry-pick -n d22877daff84a004fb555274afcff9e1675fa220

  # Don't set default icon if build as in-process
  # https://github.com/mate-desktop/mate-applets/pull/712
  git apply -3 ../mate-applets-default-icon.patch

  # command: Fix settings binding initialization
  # https://github.com/mate-desktop/mate-applets/pull/705
  git apply -3 ../mate-applets-command-settings-bind.patch

  # Replace ngettext() with dngettext()
  # https://github.com/mate-desktop/mate-applets/pull/706
  git apply -3 ../mate-applets-ngettext-replace.patch

  # Use standard icon names
  # https://github.com/mate-desktop/mate-applets/pull/708
  git apply -3 ../mate-applets-icon-names.patch

  # Set gettext domain for the template XMLs
  # https://github.com/mate-desktop/mate-applets/pull/709
  git apply -3 ../mate-applets-gettext-domain.patch

  # Don't use gtk_show_about_dialog
  # https://github.com/mate-desktop/mate-applets/pull/710
  git apply -3 ../mate-applets-about-dialog.patch

  # Fix translations in in-process mode
  # https://github.com/mate-desktop/mate-applets/pull/711
  git apply -3 ../mate-applets-gi18n-lib.patch

  # netspeed: Set window icon and title explicitly
  # https://github.com/mate-desktop/mate-applets/pull/714
  git apply -3 ../mate-applets-netspeed-details-window.patch

  # stickynotes: Fix reopening note properties after closing the window
  # https://github.com/mate-desktop/mate-applets/pull/715
  git apply -3 ../mate-applets-stickynotes-properties-reopen.patch

  # stickynotes: Fix click-hide behavior
  # https://github.com/mate-desktop/mate-applets/pull/716
  git apply -3 ../mate-applets-stickynotes-fix-hide.patch

  # Use 'edit-clear-all' icon for Empty Trash
  # https://github.com/mate-desktop/mate-applets/pull/717
  git apply -3 ../mate-applets-empty-trash-icon.patch

  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-in-process
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
