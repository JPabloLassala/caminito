# Maintainer: jpablo <jpablolassala@gmail.com>
# Contributor: Alexander Epaneshnikov <alex19ep@archlinux.org>
# Contributor: Brad Fanella <cesura@archlinux.org>
# Contributor: Martin Wimpress <code@flexion.org>

# Arch's mate-applets PKGBUILD with the smallest diff (16), so a change there shows what to
# carry over. The differences: the name, provides and conflicts, and mate-panel-caminito in
# place of mate-panel (ADR 0011). It has no carried patch: Arch builds the applets into the
# panel's process, against the 1.28 applet library, and there TrashApplet's class is smaller
# than master's MatePanelApplet, so GLib refuses it and the panel aborts (CMN-282). Built
# against mate-panel-caminito's, every applet links libmate-panel-applet-4.so.2.

pkgname=mate-applets-caminito
_pkgname=mate-applets
pkgver=1.28.1
pkgrel=1
pkgdesc="Applets for MATE panel, built for Caminito's mate-panel"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-applets'
license=(GPL-2.0-or-later)
depends=(
  at-spi2-core
  cairo
  cpupower
  dbus-glib
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgtop
  libmateweather
  libnl
  libnotify
  libwnck3
  libx11
  libxml2
  mate-desktop
  # By its real name: stock mate-panel has only the .so.1 the applets aren't linked to.
  mate-panel-caminito
  pango
  polkit
  upower
)
makedepends=(
  git
  glib2-devel
  mate-common
  yelp-tools
)
groups=(mate-extra)
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
# Arch's patches are its build patches, kept in packaging/patches/mate-applets/arch/ (ADR 0030),
# and tools/bootstrap copies them beside the PKGBUILD before makepkg (ADR 0052).
source=(
  "git+https://github.com/mate-desktop/mate-applets.git#tag=v$pkgver"
  mate-applets-default-icon.patch
  mate-applets-command-settings-bind.patch
  mate-applets-ngettext-replace.patch
  mate-applets-icon-names.patch
  mate-applets-gettext-domain.patch
  mate-applets-about-dialog.patch
  mate-applets-gi18n-lib.patch
  mate-applets-netspeed-details-window.patch
  mate-applets-stickynotes-properties-reopen.patch
  mate-applets-stickynotes-fix-hide.patch
  mate-applets-empty-trash-icon.patch
)
b2sums=(
