# Contributor: Brad Fanella <cesura@archlinux.org>
# Contributor: Martin Wimpress <code@flexion.org>

# Arch's mate-control-center PKGBUILD with the smallest diff (16), so a change there shows
# what to carry over. The differences: the name, the 1.29.1 tag, provides and conflicts, the
# carried patches in place of Arch's cherry-pick, which the tag has (ADR 0011), and
# libayatana-appindicator in libappindicator's place: configure takes it first, and the
# patched msd, which is always installed beside this, brings it.

pkgname=mate-control-center-camino
_pkgname=mate-control-center
pkgver=1.29.1
pkgrel=1
pkgdesc="The Control Center for MATE, with Camino's carried patches"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-control-center'
license=(GPL-2.0-or-later)
depends=(
  accountsservice
  at-spi2-core
  cairo
  dconf
  fontconfig
  freetype2
  gdk-pixbuf2
  glib2
  glibc
  gnome-themes-extra
  gtk3
  hicolor-icon-theme
  libayatana-appindicator
  libcanberra
  libgcc
  libgtop
  libmatekbd
  libx11
  libxcursor
  libxi
  libxklavier
  libxml2
  libxss
  marco
  mate-desktop
  mate-menus
  mate-panel
  mate-settings-daemon
  pango
  polkit
  udisks2
)
makedepends=(
  git
  glib2-devel
  mate-common
  yelp-tools
)
groups=(mate)
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
# 0001 and 0002 are active only when MATE_WM_NAME=Camino, off X11 (ADR 0011): wm-common
# names Camino and the keybindings in MATE_WM_KEYBINDINGS, and the Windows capplet opens for
# Camino as it does for Marco (06, 101). 0003 has no gate: it fixes Keyboard Shortcuts
# crashing at start-up on any display that isn't X11, which a gate would only keep for the
# other Wayland sessions. There the capplet opens now, and lists no window manager's
# shortcuts.
source=(
  "git+https://github.com/mate-desktop/mate-control-center.git#tag=v$pkgver"
  0001-wm-common-Know-Camino-from-the-environment-off-X11.patch
  0002-windows-Open-under-Camino.patch
  0003-keybindings-Do-not-crash-on-a-display-that-isn-t-X11.patch
)
b2sums=(
  5125854bee37563c54b9e22b23dc2b6670cc7453e2669b547c577394ea2250959fa76c0c7fe5df656a4b237a201835762ed7be4d49643ae99febe74ca9d7065a
  474a0094eb488d5d876a4de859046d5168572ab4db5f16430b109b839f2aafe836ed1ed63e16318f01b74207d21a24bc1f924c691f39260a89cdeb90b76dd76d
  e65ef8c2f20b4871d9410624d450ddcec48b9c53c04a6e825f339eb82913ec7be40bfd40dcc51314aeb0734ba70c9039b6ba601c89ef1dd3b0296a700a8e98fc
  168031cbf0abacb5e6148ea42a1a8615fdffe2db015ee28da5b139d354b123ea2e32130b27d17585d43afd08791e361af692cd6b00ed2a8814dcfd2bfea3ebce
)

prepare() {
  cd $_pkgname

  local src
  for src in "${source[@]}"; do
    [[ $src = *.patch ]] || continue
    patch -Np1 -i "$srcdir/$src"
  done

  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-update-mimedb
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
  rm "$pkgdir/usr/share/applications/mimeinfo.cache"
}
