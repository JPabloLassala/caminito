diff --git a/lib/appmenu-caminito.vala b/lib/appmenu-caminito.vala
new file mode 100644
index 0000000..f8727af
--- /dev/null
+++ b/lib/appmenu-caminito.vala
@@ -0,0 +1,207 @@
