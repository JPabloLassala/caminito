index 3a01327..3098ccd 100644
--- a/lib/menu-widget.vala
+++ b/lib/menu-widget.vala
@@ -83,6 +83,8 @@ namespace Appmenu
             scroller.set_propagate_natural_width(true);
             this.add(scroller);
             scroller.add(mwidget);
+            /* A chord's presses beside its item */
+            Chords.track(mwidget);
             mwidget.show();
             scroller.show();
             this.show();
