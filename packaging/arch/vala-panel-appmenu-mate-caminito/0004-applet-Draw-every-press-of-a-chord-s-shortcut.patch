+/*
+ * A chord's shortcut, drawn where a menu item's accelerator is.
+ *
+ * The translator makes a dbusmenu shortcut of several presses into each press's accelerator
+ * with a space between them, as "<Control>k <Control>o". A GTK accelerator is one press, so
+ * GtkModelMenuItem parses no key from it and its accel label draws nothing. Here every item
+ * GTK makes from the model is looked at as it's inserted in a menu, and one whose accelerator
+ * is a chord gets the presses drawn after its label, as GTK writes each ("Ctrl+K Ctrl+O"),
+ * right-aligned where an accel label draws a one-press accelerator. A one-press accelerator
+ * is left to GTK.
+ *
+ * GTK keeps the model's item on the widget it makes, under the data key "GtkMenuTrackerItem",
+ * and the item's "accel" property is the model's attribute as it is (gtkmenushell.c, line
+ * 2140, and gtkmenutrackeritem.c, line 693, at GTK's 3.24.43 tag).
+ */
+
+namespace Appmenu.Chords
+{
+    private const string TRACKED = "appmenu-chords-tracked";
+
+    /* Draws the chord of every item of the shell, its submenus' and those inserted later */
+    public void track(Gtk.MenuShell shell)
+    {
+        if (shell.get_data<bool>(TRACKED))
+            return;
+        shell.set_data<bool>(TRACKED, true);
+        shell.insert.connect_after((child, position) => {
+            look_at(child);
+        });
+        shell.foreach(look_at);
+    }
+
+    private void look_at(Gtk.Widget widget)
+    {
+        unowned Gtk.MenuItem? item = widget as Gtk.MenuItem;
+        if (item == null)
+            return;
+        unowned Gtk.MenuShell? submenu = item.get_submenu() as Gtk.MenuShell;
+        if (submenu != null)
+            track(submenu);
+        unowned GLib.Object? tracker = item.get_data<GLib.Object>("GtkMenuTrackerItem");
+        if (tracker == null || tracker.get_class().find_property("accel") == null)
+            return;
+        string? accel = null;
+        tracker.get("accel", out accel);
+        string? text = label_of(accel);
+        if (text != null)
+            add_to(item, text);
+    }
+
+    /* Each press's label as GTK writes it, with a space between them. Null for one press,
+     * which the accel label draws, and for a press GTK can't parse. */
+    private string? label_of(string? accel)
+    {
+        if (accel == null || !accel.contains(" "))
+            return null;
+        string[] labels = {};
+        foreach (unowned string press in accel.split(" "))
+        {
+            uint key;
+            Gdk.ModifierType mods;
+            Gtk.accelerator_parse(press, out key, out mods);
+            if (key == 0)
+                return null;
+            labels += Gtk.accelerator_get_label(key, mods);
+        }
+        return string.joinv(" ", labels);
+    }
+
+    /* After the label, in the box GtkModelMenuItem puts an icon in, which it makes the same
+     * way when it has none yet. Its text and icon go on being set through the box. */
+    private void add_to(Gtk.MenuItem item, string text)
+    {
+        Gtk.Widget? child = item.get_child();
+        if (child == null)
+            return;
+        unowned Gtk.Box? box = child as Gtk.Box;
+        if (box == null)
+        {
+            var made = new Gtk.Box(Gtk.Orientation.HORIZONTAL, 6);
+            item.remove(child);
+            made.pack_end(child, true, true, 0);
+            item.add(made);
+            made.show();
+            box = made;
+        }
+        /* First of the children packed at the end, which GTK lays out from the end. */
+        var chord = new Chord(text);
+        box.pack_end(chord, false, false, 0);
+        box.reorder_child(chord, 0);
+        chord.show();
+    }
+
+    /* The presses, drawn as an accel label draws its accelerator: in a node named
+     * "accelerator", so a theme styles them alike, and with its padding of 3 pixels after
+     * them (gtkaccellabel.c, lines 292 and 460, at GTK's 3.24.43 tag). */
+    private class Chord : Gtk.Widget
+    {
+        private const int PADDING = 3;
+        private string text;
+
+        static construct
+        {
+            set_css_name("accelerator");
+        }
+
+        public Chord(string text)
+        {
+            Object();
+            this.text = text;
+            set_has_window(false);
+        }
+
+        private Pango.Layout layout()
+        {
+            return create_pango_layout(text);
+        }
+
+        protected override void get_preferred_width(out int minimum, out int natural)
+        {
+            int width, height;
+            layout().get_pixel_size(out width, out height);
+            minimum = natural = width + PADDING;
+        }
+
+        protected override void get_preferred_height(out int minimum, out int natural)
+        {
+            int width, height;
+            layout().get_pixel_size(out width, out height);
+            minimum = natural = height;
+        }
+
+        protected override bool draw(Cairo.Context cr)
+        {
+            var layout = layout();
+            int width, height;
+            layout.get_pixel_size(out width, out height);
+            /* The padding is on the side away from the label in either direction, as an
+             * accel label draws at its edge with the padding after it, or at 0 right to left. */
+            int y = (get_allocated_height() - height) / 2;
+            get_style_context().render_layout(cr, 0, y, layout);
+            return false;
+        }
+    }
+}
