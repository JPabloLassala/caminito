# Maintainer: jpablo <jpablolassala@gmail.com>
# Contributor: Yamada Hayao <hayao@fascode.net>
# Contributor: rilian-la-te <ria.freelander@gmail.com>

# The AUR's vala-panel-appmenu PKGBUILD cut down to its vala-panel-appmenu-mate package
# (ADR 0017), since Arch has none. The differences: the name, provides and conflicts, only
# the MATE applet built, the menu translator linked into the applet in place of the AUR's
# appmenu-glib-translator package, which this one then needs none of, and the carried
# patches (ADR 0011).

pkgname=vala-panel-appmenu-mate-caminito
_pkgname=vala-panel-appmenu
# The AUR's version. Its Wayfire backend came after this tag, so the package has only the
# libwnck backend beside Caminito's, as the AUR's has it alone.
pkgver=25.04
pkgrel=7
pkgdesc="Global Menu plugin for mate-panel, with Caminito's patches"
url="https://gitlab.com/vala-panel-project/vala-panel-appmenu"
arch=('x86_64')
license=('LGPL-3.0-or-later')
# The panel loads the applet into its own process on Wayland, so the applet links the
# applet library the panel has: mate-panel-caminito's libmate-panel-applet-4.so.2 (73).
depends=('mate-panel-caminito' 'gtk3' 'glib2' 'gdk-pixbuf2' 'libwnck3')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'meson' 'vala')
# Firefox loads both at run time to export its menu (112). Qt needs neither.
optdepends=('libdbusmenu-glib: the global menu of Firefox'
            'libdbusmenu-gtk3: the global menu of Firefox')
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011). The AUR's translator package
# has the applet's settings schema and its locale package the translations, which are both
# in this one.
provides=("${_pkgname}-mate=${pkgver}")
conflicts=("${_pkgname}-mate" "${_pkgname}-locale" 'appmenu-glib-translator')
# 0001 is active only while org.mate.Caminito has an owner (ADR 0011), but for one line that
# is correct on any compositor: the applet says it runs on Wayland, without which a Wayland
# panel doesn't list it. Under Caminito the applet draws the menu Caminito publishes for the
# focused window, and owns org.mate.Caminito.GlobalMenuApplet, the name that makes Caminito
# tell the apps to give up their menubars (110). The menu is a GtkApplication's or, from a Qt
# app or Firefox, a dbusmenu (112). 0002 is active under Caminito only, too: there the
# application's name before the menus is bold, and the applet's preferences have whether it's
# shown, in place of whether it's bold (114). Its settings key is in the schema on any
# desktop, where nothing reads it. 0003 is in the menu translator and active everywhere:
# Firefox makes its whole menubar again, every item with a new id, when a menu changes, and
# the translator answered by making the menubar on screen again, which closed the open menu,
# and by telling Firefox its menus were opened, which changes them. So a menu opened from the
# panel flickered. A submenu that only has a new id now stays the item it was. 0004 is in
# the translator and the applet, and active everywhere: the translator made a GTK accelerator
# of a shortcut's first press and dropped the rest, so a chord was drawn as its first press
# alone. It now writes every press, and the applet draws them after the label, where a
# one-press accelerator is (145). pkgrel 5 is the first with it, which caminito-vscode-git's
# conflicts names. 0005 is active under Caminito only: a window's menubar comes over the bus
# and has no items until the app answers, so a switch of window showed the application's name
# alone and then its menus. The applet now keeps the menu on screen until the next one has
# items, or has none, or 300 ms have passed, and shows the name and the menus in one go.
# The patches are kept once for every distribution, in packaging/patches/ (ADR 0030), and
# tools/bootstrap copies them beside the PKGBUILD before makepkg (ADR 0052).
source=("${_pkgname}::git+${url}.git#tag=${pkgver}"
        "0001-applet-Add-a-Caminito-backend.patch"
        "0002-applet-Let-the-application-s-name-be-turned-off-unde.patch"
        "0003-translator-Keep-a-menu-open-while-Firefox-makes-its-.patch"
        "0004-applet-Draw-every-press-of-a-chord-s-shortcut.patch"
        "0005-applet-Show-a-window-s-menu-once-it-has-come-over-th.patch")
sha256sums=('843b24f98f02feb8cbfdda26630018ae95f8ac4959de9deb88cf1a13506f845f'
            'f3c5266093696fe12172e39a035c60ec24f01b72f525990847dc04fa344492ed'
            'e2c3146a9c86064b5aee9d57be2a57355a5e9916533e2bca344693357ad6c902'
            'ba7ebae29ae9be19213d5c0f00bb2965158dce85f14957ad5ddf6dd86cb96636'
            'f809dea6f9f467616cca377fed4520682299aa1c7b438bfab30ef2cf3572e09b'
            '7724f8c813caaa7c4fc144c1093226098e977b6411d4d5ef078adaa110cf5f8c')

prepare() {
    cd "${_pkgname}"

    # makepkg checks the tag out over the last build's tree, and leaves the files a patch
    # added there, which patch then refuses to create.
    git clean -dfq

    local src
    for src in "${source[@]}"; do
        [[ ${src} = *.patch ]] || continue
        patch -Np1 -i "${srcdir}/${src##*/}"
    done
}

build() {
    # Only the MATE applet, on libwnck. The translator from DBusMenu to GMenuModel is the
    # source's own subproject, built static so that it's part of the applet. Not arch-meson,
    # which turns every feature on.
    meson setup "${_pkgname}" build \
        --prefix=/usr \
        --libdir=lib \
        --libexecdir=lib \
        --buildtype=plain \
        --wrap-mode=nodownload \
        -Dauto_features=disabled \
        -Dmate=enabled \
        -Dwm_backend=wnck \
        --force-fallback-for=appmenu-glib-translator \
        -Dappmenu-glib-translator:default_library=static
    meson compile -C build
}

package() {
    meson install -C build --destdir "${pkgdir}"

    # What the translator installs for programs built against it, which nothing is.
    rm -r "${pkgdir}"/usr/include \
        "${pkgdir}"/usr/lib/pkgconfig \
        "${pkgdir}"/usr/lib/girepository-1.0 \
        "${pkgdir}"/usr/lib/libappmenu-glib-translator.a \
        "${pkgdir}"/usr/share/gir-1.0 \
        "${pkgdir}"/usr/share/vala
}
