# Contributor: Alexander Epaneshnikov <alex19ep@archlinux.org>
# Contributor: Brad Fanella <cesura@archlinux.org>
# Contributor: Martin Wimpress <code@flexion.org>

# Arch's caja PKGBUILD with the smallest diff (16), so a change there shows what to carry
# over. The differences: the name, provides and conflicts in place of replaces, and the
# carried patches (ADR 0011). The version is Arch's: caja's desktop is already a layer surface
# in 1.28.0, so nothing here needs a 1.29 tag.

pkgname=caja-caminito
_pkgname=caja
pkgver=1.28.0
pkgrel=5
pkgdesc="File manager for the MATE desktop, with Caminito's carried patches"
url="https://mate-desktop.org"
arch=('x86_64')
license=('GPL-2.0-or-later AND LGPL-2.0-or-later')
depends=('exempi' 'gvfs' 'libexif' 'libsm' 'mate-desktop' 'libnotify' 'gtk-layer-shell')
makedepends=('autoconf-archive' 'git' 'glib2-devel' 'gobject-introspection' 'intltool' 'mate-common' 'python-packaging')
optdepends=('gstreamer: automatic media playback when mouseover')
groups=('mate')
# The stock name at the same version, so version constraints on it still hold. No replaces:
# pacman never swaps stock and patched on its own (ADR 0011).
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}" 'caja-gtk3')
# Both are active only while org.mate.Caminito has an owner (ADR 0011). 0001: the desktop
# goes on Caminito's primary output and follows it (81, 89). 0002: a right click on another
# output pops up the desktop's menu (208). 0003: the desktop draws no wallpaper of its own, so
# Caminito's shows through, and is what the panels leave of the output (CMN-182).
# The patches are kept once for every distribution, in packaging/patches/ (ADR 0030).
# makepkg finds a local source only beside the PKGBUILD, so they're file:// sources.
_patches="file://$(realpath -m "$startdir/../../patches/caja")"
source=("git+https://github.com/mate-desktop/caja.git#tag=v${pkgver}"
        git+https://github.com/mate-desktop/mate-submodules.git
        "$_patches/0001-desktop-window-Put-the-desktop-on-Caminito-s-primary.patch"
        "$_patches/0002-desktop-window-Pop-up-the-desktop-s-menu-on-Caminito.patch"
        "$_patches/0003-desktop-window-Let-Caminito-s-wallpaper-show-through.patch")
sha256sums=('1d3387cdf0acc9d7c01a563143ab91e097e8201a183a0fcece37beb03e0009f6'
            'SKIP'
            'cb453b71e75751b2f302b8ef141a0710e6db76adfee8f9bf43d4fceda2458e90'
            '093f4f8fb5b644da29f270f61b932bc593a0b1400801e4f258798ad709f0e8e9'
            '34bb817ca00ef4b96376d7c43131597a673de5b42927642a0402de0757176952')


prepare() {
	cd "${_pkgname}"
	git submodule init
	git config submodule.mate-submodules.url "${srcdir}/mate-submodules"
	git -c protocol.file.allow=always submodule update

	local src
	for src in "${source[@]}"; do
		[[ ${src} = *.patch ]] || continue
		patch -Np1 -i "${srcdir}/${src##*/}"
	done

	./autogen.sh --prefix=/usr
}


build() {
	cd "${_pkgname}"
    	./configure \
        	--prefix=/usr \
		--libexecdir="/usr/lib/${_pkgname}" \
        	--enable-introspection \
		--disable-update-mimedb \
		--disable-self-check # self-check only checks for eel in make check, requires Xorg server
    	make
}

check() {
	cd "${_pkgname}"
	make check
}

package() {
	cd "${_pkgname}"
    	make DESTDIR="${pkgdir}" install

    	# Remove D-Bus activation file to avoid conflict with nautilus-desktop
	rm -r "${pkgdir}/usr/share/dbus-1/"
}
