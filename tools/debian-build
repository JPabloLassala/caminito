#!/usr/bin/env bash
# Builds Caminito's Debian source packages for Ubuntu 26.04 in a podman container of
# ubuntu:26.04, and leaves their .debs in packaging/debian/out/ (194).
#
#   tools/debian-build [package…]
#
# With no package, it builds every one under packaging/debian/, in dependency order. A patched
# or backported package has an `upstream` file beside its debian/, naming the tag it's built
# from. Each package's build dependencies are installed with mk-build-deps, its tests run
# (dh_auto_test), lintian fails it on an error, and its .debs are installed in the container
# before the next package is built, so the next one builds against them.
#
# The host needs podman alone. The checkout is mounted read-only, and Caminito's own packages
# are built from its committed HEAD, through `git archive` in the container, so uncommitted
# work is never packaged.
set -euo pipefail

# In dependency order. The patched packages and marco come before caminito (205).
all=(caja caminito)

image=ubuntu:26.04

# What runs in the container, as root: $1 is the checkout's path, the rest the packages.
in_container() {
  local root=$1 package work version
  shift
  export DEBIAN_FRONTEND=noninteractive
  # The maintainer of mk-build-deps's dummy package, which equivs otherwise makes of the
  # host's name, and which dpkg rejects when that has no domain.
  export DEBEMAIL=root@localhost
  apt-get update
  apt-get install -y --no-install-recommends build-essential ca-certificates devscripts equivs \
    git lintian passwd rustup
  # dpkg-buildpackage and lintian run as a user, as makepkg does on Arch, in its own home,
  # where rustup keeps the toolchain. setpriv, not runuser: runuser's PAM session drops the
  # open files' soft limit to 1024, which caminito's tests, run in parallel, go past.
  id builder >/dev/null 2>&1 || useradd -m builder
  as_builder() { setpriv --reuid builder --regid builder --init-groups env HOME=/home/builder "$@"; }
  # Xwayland's sockets' directory, which systemd-tmpfiles makes on a machine: the X11 tier's
  # tests spawn Xwayland, and smithay doesn't make it.
  mkdir -p -m 1777 /tmp/.X11-unix
  as_builder rustup toolchain install stable --profile minimal
  # A patched or backported package (200): upstream's tag, from the url packaging/debian/
  # <package>/upstream names, checked against its commit; the orig tarball is that tag's
  # git archive, as Ubuntu's are; and packaging/patches/<patches>/'s series, then its
  # debian/ build patches, become debian/patches/ (ADR 0030). The version is the changelog's.
  fetch_upstream() {
    local work=$1 package=$2 url tag commit patches name upstream patch
    # shellcheck disable=SC1090
    . "$work/caminito/packaging/debian/$package/upstream"
    git clone --quiet --depth 1 --branch "$tag" "$url" "$work/upstream"
    if [ "$(git -C "$work/upstream" rev-parse HEAD)" != "$commit" ]; then
      echo "debian-build: $package's $tag is not $commit" >&2
      return 1
    fi
    name=$(dpkg-parsechangelog -l "$work/caminito/packaging/debian/$package/debian/changelog" -S Source)
    upstream=$(dpkg-parsechangelog -l "$work/caminito/packaging/debian/$package/debian/changelog" -S Version)
    upstream=${upstream%-*}
    git -C "$work/upstream" archive --prefix="$name-$upstream/" HEAD | xz > "$work/${name}_$upstream.orig.tar.xz"
    tar -xJf "$work/${name}_$upstream.orig.tar.xz" -C "$work/src" --strip-components=1
    cp -r "$work/caminito/packaging/debian/$package/debian" "$work/src/"
    mkdir -p "$work/src/debian/patches"
    for patch in "$work/caminito/packaging/patches/$patches"/*.patch \
      "$work/caminito/packaging/patches/$patches/debian"/*.patch; do
      [ -f "$patch" ] || continue
      cp "$patch" "$work/src/debian/patches/"
      echo "${patch##*/}" >> "$work/src/debian/patches/series"
    done
  }
  for package; do
    echo "==> $package"
    work=/build/$package
    rm -rf "$work"
    mkdir -p "$work/src"
    # The checkout belongs to another user in the container, which git refuses unless told.
    if git -c safe.directory='*' -C "$root" cat-file -e "HEAD:packaging/debian/$package/upstream" 2>/dev/null; then
      # Its debian/ and the patches are the committed HEAD's too.
      mkdir -p "$work/caminito"
      git -c safe.directory='*' -C "$root" archive HEAD | tar -x -C "$work/caminito"
      fetch_upstream "$work" "$package"
    else
      # Caminito's own packages are its committed HEAD, versioned 0.0~r<count>.g<hash>-1
      # until v0.1.0 is tagged.
      git -c safe.directory='*' -C "$root" archive HEAD | tar -x -C "$work/src"
      version="0.0~r$(git -c safe.directory='*' -C "$root" rev-list --count HEAD)"
      version+=".g$(git -c safe.directory='*' -C "$root" rev-parse --short=7 HEAD)-1"
      cp -r "$work/src/packaging/debian/$package/debian" "$work/src/"
      sed -i "1s/([^)]*)/($version)/" "$work/src/debian/changelog"
    fi
    (
      cd "$work"
      mk-build-deps -i -r -t 'apt-get -y --no-install-recommends' src/debian/control
      rm -f ./*-build-deps_*
    )
    chown -R builder: "$work"
    (cd "$work/src" && as_builder dpkg-buildpackage -b -us -uc)
    as_builder lintian --fail-on error "$work"/*.changes
    apt-get install -y "$work"/*.deb
    cp "$work"/*.deb /out/
  done
}

if [ "${1-}" = --in-container ]; then
  shift
  in_container "$@"
  exit
fi

root=$(realpath "$(dirname "$(realpath "$0")")/..")

packages=("$@")
[ ${#packages[@]} -gt 0 ] || packages=("${all[@]}")
for package in "${packages[@]}"; do
  if [[ ! " ${all[*]} " =~ " $package " ]]; then
    echo "debian-build: no package $package; there are: ${all[*]}" >&2
    exit 1
  fi
done
# In dependency order whatever the order of the arguments.
ordered=()
for package in "${all[@]}"; do
  [[ " ${packages[*]} " =~ " $package " ]] && ordered+=("$package")
done

out=$root/packaging/debian/out
mkdir -p "$out"

# The checkout at its own path, so that a worktree's .git, which names the main checkout's
# by its path, still leads git there; and then the main checkout's .git too.
mounts=(-v "$root:$root:ro")
if [ -f "$root/.git" ]; then
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
  mounts+=(-v "$common:$common:ro")
fi

podman run --rm "${mounts[@]}" -v "$out:/out" "$image" \
  "$root/tools/debian-build" --in-container "$root" "${ordered[@]}"
