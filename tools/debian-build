#!/usr/bin/env bash
# Builds Caminito's Debian source packages for Ubuntu 26.04 in a podman container of
# ubuntu:26.04, and leaves their .debs in packaging/debian/out/ (194).
#
#   tools/debian-build [package…]
#
# With no package, it builds every one under packaging/debian/, in dependency order. Each
# package's build dependencies are installed with mk-build-deps, its tests run
# (dh_auto_test), lintian fails it on an error, and its .debs are installed in the container
# before the next package is built, so the next one builds against them.
#
# The host needs podman alone. The checkout is mounted read-only, and Caminito's own packages
# are built from its committed HEAD, through `git archive` in the container, so uncommitted
# work is never packaged. A backported or patched package has an `upstream` file beside its
# debian/. It names a release tarball and its sha256 (marco, 195), which is fetched and
# checked, or upstream's git and commit (196), which is cloned; and the package's carried
# patches, which are copied from packaging/patches/ into debian/patches/ (ADR 0030), from HEAD
# too.
set -euo pipefail

# In dependency order. marco comes first, for mate-control-center (195), and the patched
# packages come before caminito (205).
all=(marco mate-panel caja caminito)

image=ubuntu:26.04

# What runs in the container, as root: $1 is the checkout's path, the rest the packages.
in_container() {
  local root=$1 package work version git commit patches patch url sha256 orig
  shift
  export DEBIAN_FRONTEND=noninteractive
  # The maintainer of mk-build-deps's dummy package, which equivs otherwise makes of the
  # host's name, and which dpkg rejects when that has no domain.
  export DEBEMAIL=root@localhost
  apt-get update
  apt-get install -y --no-install-recommends build-essential ca-certificates curl devscripts \
    equivs git lintian passwd rustup
  # dpkg-buildpackage and lintian run as a user, as makepkg does on Arch, in its own home,
  # where rustup keeps the toolchain. setpriv, not runuser: runuser's PAM session drops the
  # open files' soft limit to 1024, which caminito's tests, run in parallel, go past.
  id builder >/dev/null 2>&1 || useradd -m builder
  as_builder() { setpriv --reuid builder --regid builder --init-groups env HOME=/home/builder "$@"; }
  # Xwayland's sockets' directory, which systemd-tmpfiles makes on a machine: the X11 tier's
  # tests spawn Xwayland, and smithay doesn't make it.
  mkdir -p -m 1777 /tmp/.X11-unix
  as_builder rustup toolchain install stable --profile minimal
  for package; do
    echo "==> $package"
    work=/build/$package
    rm -rf "$work"
    mkdir -p "$work/head"
    # The checkout's committed HEAD, which has every package's debian/ and the patches. The
    # checkout belongs to another user in the container, which git refuses unless told.
    git -c safe.directory='*' -C "$root" archive HEAD | tar -x -C "$work/head"
    if [ -f "$work/head/packaging/debian/$package/upstream" ]; then
      # A backported or patched package: upstream's release tarball or its commit with its
      # submodules, then the shared series and this distribution's build patches, if it has
      # carried patches, after its own. Its version is its changelog's.
      git='' commit='' patches='' url='' sha256=''
      # shellcheck source=/dev/null
      . "$work/head/packaging/debian/$package/upstream"
      if [ -n "$url" ] && [ -n "$sha256" ]; then
        # Kept beside the source as <source>_<upstream version>.orig.tar.*, for dpkg-source.
        version=$(dpkg-parsechangelog -S Version \
          -l "$work/head/packaging/debian/$package/debian/changelog")
        version=${version#*:}
        orig=$work/${package}_${version%-*}.orig.tar.${url##*.tar.}
        curl -fsSL -o "$orig" "$url"
        echo "$sha256  $orig" | sha256sum -c -
        mkdir -p "$work/src"
        tar -x -f "$orig" -C "$work/src" --strip-components=1
      elif [ -n "$git" ] && [ -n "$commit" ]; then
        git init -q "$work/src"
        git -C "$work/src" fetch -q --depth 1 "$git" "$commit"
        git -C "$work/src" checkout -q FETCH_HEAD
        git -C "$work/src" submodule -q update --init --recursive --depth 1
        rm -rf "$work/src/.git"
      else
        echo "debian-build: $package's upstream needs url and sha256, or git and commit" >&2
        exit 1
      fi
      cp -r "$work/head/packaging/debian/$package/debian" "$work/src/"
      if [ -n "$patches" ]; then
        mkdir -p "$work/src/debian/patches"
        for patch in "$work/head/packaging/patches/$patches"/*.patch \
          "$work/head/packaging/patches/$patches"/debian/*.patch; do
          [ -f "$patch" ] || continue
          cp "$patch" "$work/src/debian/patches/"
          basename "$patch" >>"$work/src/debian/patches/series"
        done
      fi
    else
      # Caminito's own packages are its committed HEAD, versioned 0.0~r<count>.g<hash>-1
      # until v0.1.0 is tagged.
      mv "$work/head" "$work/src"
      version="0.0~r$(git -c safe.directory='*' -C "$root" rev-list --count HEAD)"
      version+=".g$(git -c safe.directory='*' -C "$root" rev-parse --short=7 HEAD)-1"
      cp -r "$work/src/packaging/debian/$package/debian" "$work/src/"
      sed -i "1s/([^)]*)/($version)/" "$work/src/debian/changelog"
    fi
    (
      cd "$work"
      mk-build-deps -i -r -t 'apt-get -y --no-install-recommends' src/debian/control
      rm -f ./*-build-deps_*
    )
    chown -R builder: "$work"
    (cd "$work/src" && as_builder dpkg-buildpackage -b -us -uc)
    as_builder lintian --fail-on error "$work"/*.changes
    apt-get install -y "$work"/*.deb
    cp "$work"/*.deb /out/
  done
}

if [ "${1-}" = --in-container ]; then
  shift
  in_container "$@"
  exit
fi

root=$(realpath "$(dirname "$(realpath "$0")")/..")

packages=("$@")
[ ${#packages[@]} -gt 0 ] || packages=("${all[@]}")
for package in "${packages[@]}"; do
  if [[ ! " ${all[*]} " =~ " $package " ]]; then
    echo "debian-build: no package $package; there are: ${all[*]}" >&2
    exit 1
  fi
done
# In dependency order whatever the order of the arguments.
ordered=()
for package in "${all[@]}"; do
  [[ " ${packages[*]} " =~ " $package " ]] && ordered+=("$package")
done

out=$root/packaging/debian/out
mkdir -p "$out"

# The checkout at its own path, so that a worktree's .git, which names the main checkout's
# by its path, still leads git there; and then the main checkout's .git too.
mounts=(-v "$root:$root:ro")
if [ -f "$root/.git" ]; then
  common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
  mounts+=(-v "$common:$common:ro")
fi

podman run --rm "${mounts[@]}" -v "$out:/out" "$image" \
  "$root/tools/debian-build" --in-container "$root" "${ordered[@]}"
