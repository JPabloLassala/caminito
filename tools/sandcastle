#!/usr/bin/env bash
# Runs agents over an epic's tickets in Docker sandboxes (OrbStack's on a Mac), with Sandcastle
# (.sandcastle/main.ts).
#
#   tools/sandcastle build-image
#   tools/sandcastle start --epic <epic> [--max <n>] [--parallel <n>] [--no-merge]
#     [--implement-model <model>] [--review-model <model>]
#
# build-image builds the sandbox from .sandcastle/Containerfile; rerun it when tools/check's
# packages change. start needs .sandcastle/.env and .sandcastle/host.env, from their examples.
set -euo pipefail

cd "$(dirname "$(realpath "$0")")/.."

[ -d .sandcastle/node_modules ] || npm --prefix .sandcastle install

case ${1-} in
  build-image)
    exec npm --prefix .sandcastle exec -- sandcastle docker build-image --image-name camino-sandcastle \
      --dockerfile .sandcastle/Containerfile
    ;;
  start)
    exec .sandcastle/node_modules/.bin/tsx .sandcastle/main.ts "$@"
    ;;
  *)
    sed -n '5,7s/^# //p' "$0" >&2
    exit 2
    ;;
esac
