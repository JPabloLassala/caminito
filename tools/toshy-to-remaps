# name: {keyboard.name}
# {keyboard.summary}
#
# Converted by tools/toshy-to-remaps from Toshy's default-toshy-config/toshy_config.py, at
# commit {TOSHY_COMMIT} of https://github.com/RedBearAK/toshy,
# by RedBearAK. Toshy's config is based on Kinto's, https://github.com/rbreaves/kinto, by Ben
# Reaves. Like Toshy, this file is under the GNU General Public License, version 3.
#
# Don't edit it: run the script again.
"""


# Caminito's modifiers, in the order its templates write them.
MODIFIERS = ("Ctrl", "Alt", "Shift", "Super")


def trigger_modifiers(keyboard):
    """The keys the user presses for each of Toshy's modifiers in a combination it matches, in
    most apps (gui) and in terminals (term): its modmaps turn Cmd's key into RC, leave Option's
    Alt, and turn Ctrl into Super in most apps and LC in terminals. C- is either Ctrl. A modifier
    no key gives there has none, and its rules never match there."""
    cmd, option = keyboard.cmd, keyboard.option
    return {
        "gui": {
            "RC": [cmd], "C": [cmd], "Ctrl": [cmd], "LC": [],
            "Alt": [option], "LAlt": [option], "RAlt": [option],
            "Super": ["Ctrl"], "Meta": ["Ctrl"], "Win": ["Ctrl"],
            "Shift": ["Shift"], "Fn": [],
        },
        "term": {
            "RC": [cmd], "C": [cmd, "Ctrl"], "Ctrl": [cmd, "Ctrl"], "LC": ["Ctrl"],
            "Alt": [option], "LAlt": [option], "RAlt": [option],
            "Super": [], "Meta": [], "Win": [],
            "Shift": ["Shift"], "Fn": [],
        },
    }


