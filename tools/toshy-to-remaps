class Unsupported(Exception):
    """Something in Toshy's config the conversion doesn't know, which it stops on."""


class LeftOut(Exception):
    """A rule left out of the template, of one of KINDS."""

    def __init__(self, kind):
        super().__init__(kind)
        self.kind = kind


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--toshy", type=Path, help=f"toshy_config.py at {TOSHY_COMMIT}")
    parser.add_argument("--check", action="store_true", help="compare with the committed file")
    args = parser.parse_args()

    try:
        if args.toshy:
            data = args.toshy.read_bytes()
        else:
            with urllib.request.urlopen(TOSHY_URL) as response:
                data = response.read()
    except (OSError, urllib.error.URLError) as err:
        raise Unsupported(f"can't read Toshy's config: {err}") from err
    if hashlib.sha256(data).hexdigest() != TOSHY_SHA256:
        raise Unsupported(f"that toshy_config.py isn't the one at {TOSHY_COMMIT}")
    source = data.decode()

    for keyboard in KEYBOARDS:
        config = Config(source, keyboard)
        text = config.template()
        output = keyboard.output.relative_to(ROOT)
        print(f"{output}, {keyboard.name}:\n")
        print(config.report(), end="")

        if args.check:
            committed = keyboard.output.read_text() if keyboard.output.exists() else None
            if committed != text:
                sys.exit(f"toshy-to-remaps: {output} isn't what the conversion writes")
            print(f"\n{output} is what the conversion writes.\n")
        else:
            keyboard.output.write_text(text)
            print(f"\nWrote {output}.\n")


# One of matchProps' alternatives: the patterns of the class, whether it's not_clas, and
# whether it needs a window's title too.
Alternative = namedtuple("Alternative", "patterns negated titled")


class Classes:
    """App classes a `when` matches, as Toshy's matchProps does: alternatives, each by its class
    and maybe its window's title, matched in any case."""

    def __init__(self, alternatives):
        self.alternatives = alternatives

    def matches(self, app):
        """Whether it matches app, a class, or None for an app it names nowhere. An alternative
        that needs a title never does."""
        for patterns, negated, titled in self.alternatives:
            if titled:
                continue
            hit = app is not None and any(fullmatch(p, app) for p in patterns)
            if hit != negated:
                return True
        return False

    def titled(self):
        return any(a.titled for a in self.alternatives)

    def patterns(self):
        """The patterns it names apps by, no app id known for."""
        return [
            p for a in self.alternatives if not a.negated
            for p in a.patterns if is_pattern(p) and p not in PATTERN_APP_IDS
        ]

    def names(self):
        """The apps it names: its classes, and the app ids of its patterns."""
        names = []
        for a in self.alternatives:
            for p in a.patterns:
                names += PATTERN_APP_IDS.get(p, []) if is_pattern(p) else [p]
        return names


def fullmatch(pattern, app):
    return re.fullmatch(pattern, app, re.IGNORECASE) is not None


def is_pattern(name):
    """Whether a class names more than one app: a `.` alone is taken for itself."""
    return re.search(r"[*+?()\[\]{}\\]", name) is not None


def class_names(text):
    """A matchProps class, `^a$|^b$`, as its alternatives."""
    return [part.strip("^$") for part in text.split("|") if part.strip("^$")]


class Keymap:
    """One of Toshy's keymaps or modmaps, in the order the file has them."""

    def __init__(self, call, node, conditional):
        self.call = call
        self.name = node.args[0].value
        self.rules = list(zip(node.args[1].keys, node.args[1].values))
        when = [k.value for k in node.keywords if k.arg == "when"]
        self.when = when[0] if when else None
        # Whether it's under an `if`, which is of the desktop or the distro in Toshy's config.
        self.conditional = conditional


class Config:
    """Toshy's config, read as data."""

    def __init__(self, source, keyboard):
        self.keyboard = keyboard
        self.trigger_modifiers = trigger_modifiers(keyboard)
        self.context_names = CONTEXT | {keyboard.context: True}
        self.tree = ast.parse(source)
        # Each module-level name's assignments, by line.
        self.assignments = {}
        self.keymaps = []
        self.walk(self.tree.body, conditional=False)
        self.terminals = self.resolve_classes("hmp_is_terminal")
        self.remotes = self.resolve_classes("hmp_is_remote")
        for pattern, app_ids in PATTERN_APP_IDS.items():
            for app_id in app_ids:
                if not fullmatch(pattern, app_id):
                    raise Unsupported(f"{app_id} isn't one of {pattern}")
        # What's left out of the template, by kind, and what it changes: {item: rules}.
        self.left_out = {kind: {} for kind in KINDS}
        self.changed = {}
        self.candidates = self.app_classes()

    def walk(self, body, conditional):
        for statement in body:
            if isinstance(statement, ast.Assign):
                for target in statement.targets:
                    if isinstance(target, ast.Name):
                        self.assignments.setdefault(target.id, []).append(statement)
            elif isinstance(statement, ast.Expr) and isinstance(statement.value, ast.Call):
                func = statement.value.func
                if isinstance(func, ast.Name) and func.id in KEYMAP_CALLS:
                    self.keymaps.append(Keymap(func.id, statement.value, conditional))
            elif isinstance(statement, ast.If):
                self.walk(statement.body + statement.orelse, conditional=True)

    def assignment(self, name, before=None):
        """The value name has at a line, or its last."""
        assignments = [
            a for a in self.assignments.get(name, []) if before is None or a.lineno < before
        ]
        if not assignments:
            raise Unsupported(f"{name} isn't assigned")
        return assignments[-1].value, assignments[-1].lineno

    def resolve_list(self, node, line):
        """A list of strings, through names, `+` and comprehensions over it."""
        if isinstance(node, ast.Name):
            value, at = self.assignment(node.id, line)
            return self.resolve_list(value, at)
        if isinstance(node, ast.List):
            names = []
            for element in node.elts:
                if isinstance(element, ast.Starred):
                    names += self.resolve_list(element.value, line)
                elif isinstance(element, ast.Constant) and isinstance(element.value, str):
                    names.append(element.value)
                else:
                    break
            else:
                return names
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
            return self.resolve_list(node.left, line) + self.resolve_list(node.right, line)
        if isinstance(node, (ast.ListComp, ast.GeneratorExp)) and len(node.generators) == 1:
            return self.resolve_list(node.generators[0].iter, line)
        raise Unsupported(f"line {node.lineno}: not a list of classes: {ast.unparse(node)}")

    def resolve_pattern(self, node, line):
        """A matchProps class: a string, or a name made by toRgxStr or "|".join of a list."""
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return class_names(node.value)
        if isinstance(node, ast.Name):
            value, at = self.assignment(node.id, line)
            return self.resolve_pattern(value, at)
        if isinstance(node, ast.Call):
            func = node.func
            joined = isinstance(func, ast.Attribute) and func.attr == "join"
            if (isinstance(func, ast.Name) and func.id == "toRgxStr") or joined:
                names = self.resolve_list(node.args[0], line)
                return [part for name in names for part in class_names(name)]
        raise Unsupported(f"line {node.lineno}: not a class: {ast.unparse(node)}")

    def alternative(self, keywords, line):
        """One matchProps call's, or one dict's of a list of them."""
        patterns, negated, titled = [], False, False
        for key, value in keywords:
            if key in ("clas", "not_clas"):
                patterns = self.resolve_pattern(value, line)
                negated = key == "not_clas"
            elif key in ("name", "not_name"):
                titled = True
            elif key in ("devn", "not_devn", "numlk"):
                raise LeftOut("device")
            else:
                raise Unsupported(f"line {line}: matchProps' {key}")
        return Alternative(patterns, negated, titled)

    def resolve_classes(self, name):
        """What an hmp_ name matches: a matchProps call, or a lambda over closures of a list of
        dicts of them."""
        value, line = self.assignment(name)
        if isinstance(value, ast.Call) and getattr(value.func, "id", None) == "matchProps":
            keywords = [(k.arg, k.value) for k in value.keywords]
            return Classes([self.alternative(keywords, line)])
        if isinstance(value, ast.Lambda):
            # lambda ctx: any(c(ctx) for c in _closures), _closures = [matchProps(**d) for d in lod]
            closures = value.body.args[0].generators[0].iter.id
            comprehension, at = self.assignment(closures)
            lod, lod_line = self.assignment(comprehension.generators[0].iter.id, at)
            alternatives = []
            for entry in lod.elts:
                keywords = [(k.id, v) for k, v in zip(entry.keys, entry.values)]
                alternatives.append(self.alternative(keywords, lod_line))
            return Classes(alternatives)
        raise Unsupported(f"line {line}: {name} isn't matchProps")

    def app_classes(self):
        """Every class a keymap's `when` names, once in any case, in the order they're named."""
        seen, classes = set(), []
        for name in self.assignments:
            if not name.startswith("hmp_"):
                continue
            try:
                found = self.resolve_classes(name)
            except LeftOut:
                continue
            for app in found.names():
                if app.casefold() not in seen:
                    seen.add(app.casefold())
                    classes.append(app)
        return classes

    def context(self, app):
        if app is not None and self.remotes.matches(app):
            return "remote"
        if app is not None and self.terminals.matches(app):
            return "term"
        return "gui"

    def evaluate(self, node, app, any_keyboard=False):
        """A `when`'s value for an app, or None for an app it names nowhere, on the keyboard or
        with any_keyboard on every keyboard at once."""

        def evaluate(node):
            return self.evaluate(node, app, any_keyboard)

        if isinstance(node, ast.Lambda):
            return evaluate(node.body)
        if isinstance(node, ast.BoolOp):
            values = [evaluate(v) for v in node.values]
            return all(values) if isinstance(node.op, ast.And) else any(values)
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
            return not evaluate(node.operand)
        if isinstance(node, ast.Constant):
            return node.value
        if isinstance(node, ast.Name):
            if node.id == "ctx_app_is_terminal":
                return self.context(app) == "term"
            if node.id == "ctx_app_is_remote":
                return self.context(app) == "remote"
            if node.id.startswith("ctx_ovl_"):
                return not node.id.startswith("ctx_ovl_user_flag_")
            if node.id in self.context_names:
                if any_keyboard and node.id.startswith("ctx_kbd_"):
                    return True
                return self.context_names[node.id]
            if node.id in ("DESKTOP_ENV", "DE_MAJ_VER", "DISTRO_ID"):
                raise LeftOut("desktop")
            if node.id in ("ac_Chr_main", "deadkeys_list"):
                raise LeftOut("deadkeys")
            raise Unsupported(f"line {node.lineno}: {node.id}")
        if isinstance(node, ast.Attribute) and getattr(node.value, "id", None) == "cnfg":
            if node.attr == "optspec_layout":
                raise LeftOut("optspec")
            return SETTINGS[node.attr]
        if isinstance(node, ast.Compare) and len(node.ops) == 1:
            left = evaluate(node.left)
            right = evaluate(node.comparators[0])
            if isinstance(node.ops[0], ast.Eq):
                return left == right
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
            if node.func.id.startswith("hmp_"):
                return self.resolve_classes(node.func.id).matches(app)
        if isinstance(node, ast.Call) and getattr(node.func, "func", None) is not None:
            # setDK(None)(): the dead keys' tripwire.
            if getattr(node.func.func, "id", None) == "setDK":
                raise LeftOut("deadkeys")
        raise Unsupported(f"line {node.lineno}: a when of {ast.unparse(node)}")

    def kind_off(self, keymap):
        """Why a keymap that applies to no app does: keyboard type, an option or classes."""
        names = {n.id for n in ast.walk(keymap.when) if isinstance(n, ast.Name)}
        settings = {
            n.attr for n in ast.walk(keymap.when)
            if isinstance(n, ast.Attribute) and getattr(n.value, "id", None) == "cnfg"
        }
        apps = [None] + self.candidates
        if any(self.evaluate(keymap.when, app, any_keyboard=True) for app in apps):
            return "keyboard"
        if any(n.startswith("ctx_caps_") for n in names) or settings - {"screen_has_focus"}:
            return "option"
        hmps = [n for n in names if n.startswith("hmp_")]
        if any(self.resolve_classes(h).titled() for h in hmps):
            return "title"
        return "pattern"

    def applying(self):
        """Each keymap with the apps it applies to, after leaving out those that apply to none
        on the keyboard."""
        apps = [None] + self.candidates
        for keymap in self.keymaps:
            if keymap.call != "keymap" or not isinstance(keymap.when, ast.Lambda):
                # The modmaps are read in modmap_left_out. A `when` that isn't a lambda is
                # Toshy's context pre-check, which has no rules.
                continue
            if keymap.conditional:
                self.leave_out("desktop", keymap)
                continue
            try:
                applies = {app for app in apps if self.evaluate(keymap.when, app)}
            except LeftOut as left_out:
                self.leave_out(left_out.kind, keymap)
                continue
            if not applies:
                self.leave_out(self.kind_off(keymap), keymap)
                continue
            self.note_unmatched(keymap)
            yield keymap, applies

    def note_unmatched(self, keymap):
        """The windows a keymap that's converted matches by title or by a pattern, which it's
        left out for."""
        hmps = {n.func.id for n in ast.walk(keymap.when)
                if isinstance(n, ast.Call) and getattr(n.func, "id", "").startswith("hmp_")}
        for hmp in sorted(hmps - {"hmp_is_terminal", "hmp_is_remote"}):
            classes = self.resolve_classes(hmp)
            if classes.titled():
                self.leave_out("title", keymap, "for its windows matched by title")
            if classes.patterns():
                self.leave_out("pattern", keymap, "for " + ", ".join(classes.patterns()))

    def leave_out(self, kind, keymap, what=None, rules=None):
        """Notes a keymap left out of the template, or what of it is, `what`, of `rules` rules:
        all of the keymap's unless given."""
        note(self.left_out[kind], keymap, what, rules)

    def modmap_left_out(self):
        """Toshy's modmaps: the keyboard's Cmd is written out as rules, and the rest left out."""
        for keymap in self.keymaps:
            if keymap.call == "keymap" or not isinstance(keymap.when, ast.Lambda):
                continue
            if keymap.call == "multipurpose_modmap":
                self.leave_out("tap-or-hold", keymap)
                continue
            terminal = next(app for app in self.candidates if self.context(app) == "term")
            try:
                applies = self.evaluate(keymap.when, None) or self.evaluate(keymap.when, terminal)
            except LeftOut as left_out:
                self.leave_out(left_out.kind, keymap)
                continue
            if not applies:
                self.leave_out(self.kind_off(keymap), keymap)
                continue
            # The keyboard's: those that make a key Cmd, RIGHT_CTRL, are the rules written
            # out, and the others swap Option and Control.
            for key, value in keymap.rules:
                key, value = ast.unparse(key), ast.unparse(value)
                if value != "Key.RIGHT_CTRL" and key != value:
                    self.leave_out("modmap", keymap, f"{key} as {value}", rules=1)

    def triggers(self, node, context):
        """The combinations the user presses that one of Toshy's matches in a context."""
        text = self.combo_text(node)
        *modifiers, key = text.split("-")
        held = [[]]
        for modifier in modifiers:
            if modifier not in self.trigger_modifiers[context]:
                raise Unsupported(f"line {node.lineno}: the modifier {modifier}")
            held = [h + [m] for h in held for m in self.trigger_modifiers[context][modifier]]
        return [combination(h, key_name(key, node)) for h in held]

    def combo_text(self, node):
        if (
            isinstance(node, ast.Call) and getattr(node.func, "id", None) == "C"
            and isinstance(node.args[0], ast.Constant)
        ):
            return node.args[0].value
        raise Unsupported(f"line {node.lineno}: not a combination: {ast.unparse(node)}")

    def target(self, node):
        """What a rule sends, as steps, none for nothing."""
        if isinstance(node, ast.Name) and node.id == "ignore_combo":
            return []
        if isinstance(node, ast.Constant) and node.value is None:
            # A rule to None blocks the combination, as ignore_combo does.
            return []
        if isinstance(node, ast.Call) and getattr(node.func, "id", None) == "C":
            return [self.step(node)]
        if isinstance(node, ast.List):
            steps = []
            for element in node.elts:
                if isinstance(element, ast.Name) and element.id == "bind":
                    raise LeftOut("bind")
                func = getattr(element, "func", None)
                name = getattr(func, "id", None)
                if name == "sleep":
                    raise LeftOut("sleep")
                if name == "ST":
                    raise LeftOut("text")
                if name == "iEF2NT":
                    # It resets Enter to rename's latch, and Enter to rename is left out.
                    continue
                if isinstance(element, ast.Attribute) and getattr(element.value, "id", "") == "Key":
                    steps.append(key_name(element.attr, element))
                    continue
                steps.append(self.step(element))
            return steps
        if isinstance(node, ast.Call) and getattr(node.func, "id", None) == "MultiTap":
            raise LeftOut("tap-or-hold")
        if isinstance(node, (ast.Name, ast.Call)):
            raise LeftOut("stateful")
        raise Unsupported(f"line {node.lineno}: a rule of {ast.unparse(node)}")

    def step(self, node):
        *modifiers, key = self.combo_text(node).split("-")
        held = []
        for modifier in modifiers:
            if modifier not in TARGET_MODIFIERS:
                raise Unsupported(f"line {node.lineno}: the modifier {modifier}")
            held.append(TARGET_MODIFIERS[modifier])
        return combination(held, key_name(key, node))

    def effective(self, app, applying):
        """The rules an app gets: {combination: (steps or None if left out, keymap's name)}."""
        context = self.context(app)
        if context == "remote":
            return {}
        rules = {}
        for keymap, applies in applying:
            if app not in applies:
                continue
            for key, value in keymap.rules:
                for trigger in self.triggers(key, context):
                    if trigger in rules:
                        continue
                    change = CHANGES.get((keymap.name, self.combo_text(key)))
                    if change is not None:
                        what = f"{self.combo_text(key)} as {', '.join(change)}"
                        note(self.changed, keymap, what, 1)
                        rules[trigger] = (change, keymap.name)
                        continue
                    try:
                        rules[trigger] = (self.target(value), keymap.name)
                    except LeftOut as left_out:
                        # The combination is the left-out rule's, as in Toshy: no later
                        # keymap's and not the modmap's.
                        rules[trigger] = (None, keymap.name)
                        self.leave_out(left_out.kind, keymap, self.combo_text(key), rules=1)
        for key in TYPING_KEYS:
            for shift in ([], ["Shift"]):
                trigger = combination([self.keyboard.cmd] + shift, key)
                if trigger not in rules:
                    rules[trigger] = ([combination(["Ctrl"] + shift, key)], None)
        return rules

    def template(self):
        applying = list(self.applying())
        self.modmap_left_out()
        everyone = self.effective(None, applying)

        groups = {}
        for app in self.candidates:
            if is_pattern(app):
                continue
            if " " in app:
                self.left_out["space"][f'app class "{app}"'] = 0
                continue
            own = self.effective(app, applying)
            if not own:
                key = ("no remaps",)
            else:
                # A rule left out of the app's keymaps leaves it All applications'.
                differ = []
                for trigger, (steps, origin) in own.items():
                    if steps is not None and list(steps) != sends(everyone, trigger):
                        differ.append((trigger, tuple(steps), origin))
                for trigger in everyone:
                    pressed = as_pressed(trigger, self.keyboard)
                    if trigger not in own and [pressed] != sends(everyone, trigger):
                        differ.append((trigger, (pressed,), AS_PRESSED))
                if not differ:
                    continue
                key = tuple(differ)
            groups.setdefault(key, []).append(app)

        names = set()
        sections = []
        for key, apps in groups.items():
            base = self.group_name(apps, applying, key == ("no remaps",))
            name, count = base, 1
            while name in names:
                count += 1
                name = f"{base} ({apps[0]})" if count == 2 else f"{base} ({apps[0]}, {count})"
            names.add(name)
            sections.append((name, apps, key))

        lines = [header(self.keyboard), "[All applications]"]
        lines += rule_lines(
            (t, s, o) for t, (s, o) in everyone.items() if s is not None and list(s) != [t]
        )
        for name, apps, key in sections:
            app_ids = []
            for app in apps:
                for app_id in (app, app.lower()):
                    if app_id not in app_ids:
                        app_ids.append(app_id)
            lines.append("")
            lines.append(f"[{name}] {' '.join(app_ids)}")
            if key == ("no remaps",):
                lines.append("no remaps")
            else:
                lines += rule_lines(key)
        return "\n".join(lines) + "\n"

    def group_name(self, apps, applying, no_remaps):
        """A group's name: the remote desktops', or that of the keymap for the fewest apps
        that all its apps get, and not every app does, which isn't a fix across kinds of apps."""
        if no_remaps:
            return "Remote desktops"
        shared = [
            (len(applies), index, keymap) for index, (keymap, applies) in enumerate(applying)
            if None not in applies and all(app in applies for app in apps)
            and not keymap.name.startswith(CROSS_CUTTING)
        ]
        if shared:
            _, _, keymap = min(shared, key=lambda each: each[:2])
            name = re.sub(
                r"^Overrides for |\s*(- Finder Mods|[Oo]verrides( for not Chromebook/IBM)?"
                r"|- not tab nav|tab switching)$",
                "", keymap.name,
            ).strip()
            return GROUP_NAMES.get(name, name)
        return apps[0]

    def report(self):
        lines = ["Changed from Toshy's:"]
        lines += [f"  {item}" for item in self.changed]
        lines += ["", "Left out of the template, by kind, with the number of Toshy's rules:"]
        for kind, why in KINDS.items():
            items = self.left_out[kind]
            count = f"{len(items)} app classes" if kind == "space" else rules(sum(items.values()))
            lines.append("")
            why = why.format(name=self.keyboard.name, option=self.keyboard.option)
            lines.append(f"{why} ({count}):")
            lines += [f"  {item}" for item in items]
        return "\n".join(lines) + "\n"


def note(items, keymap, what, count):
    """Adds a keymap, or `what` of it, of `count` rules, to items, once."""
    if count is None:
        count = len(keymap.rules)
    if what is None:
        what = rules(count)
    items.setdefault(f'{keymap.call} "{keymap.name}": {what}', count)


def rules(count):
    return f"{count} rule{'s' if count != 1 else ''}"


def key_name(key, node):
    lower = key.lower()
    if lower.startswith("key_"):
        lower = lower[len("key_"):]
    if len(lower) == 1 and lower.isalnum():
        return lower.upper()
    if re.fullmatch(r"f\d{1,2}", lower):
        return lower.upper()
    if re.fullmatch(r"kp\d", lower):
        return f"KP_{lower[2]}"
    if lower in KEY_NAMES:
        return KEY_NAMES[lower]
    raise Unsupported(f"line {node.lineno}: the key {key}")


def combination(modifiers, key):
    """A combination as Caminito's templates write one: its modifiers in order, then its key."""
    return "+".join([m for m in MODIFIERS if m in modifiers] + [key])


def sends(rules, trigger):
    """The steps a combination is sent as with rules: its rule's, or itself if it has none or
    its rule was left out."""
    steps = rules.get(trigger, (None,))[0]
    return [trigger] if steps is None else list(steps)


def as_pressed(trigger, keyboard):
    """What Toshy sends for a combination no rule takes in a group: Cmd's modmap's alone."""
    *modifiers, key = trigger.split("+")
    return combination(["Ctrl" if m == keyboard.cmd else m for m in modifiers], key)


def rule_lines(rules):
    """A section's rules, each keymap's after a comment that names it, and the modmap's last."""
    rules = list(rules)
    lines = []
    for origin in dict.fromkeys(o for _, _, o in rules if o is not None):
        lines.append(f"# {origin}")
        lines += [rule_line(t, s) for t, s, o in rules if o == origin]
    rest = [(t, s) for t, s, o in rules if o is None]
    if rest:
        lines.append("# Cmd as Ctrl")
        lines += [rule_line(t, s) for t, s in rest]
    return lines


def rule_line(trigger, steps):
    return f"{trigger} = {', '.join(steps) if steps else 'nothing'}"


if __name__ == "__main__":
    try:
        main()
    except Unsupported as err:
        sys.exit(f"toshy-to-remaps: {err}")
