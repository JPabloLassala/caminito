# name: macOS (PC keyboard)
# macOS's shortcuts on a PC keyboard: Alt, where Cmd sits, does what Ctrl does, Alt+Right goes
# to the end of a line, and terminals, browsers and other apps have shortcuts of their own.
#
# Converted by tools/toshy-to-remaps from Toshy's default-toshy-config/toshy_config.py, at
# commit a07f6f69b0cac2d29eeb91d29d9a1128efb9bf09 of https://github.com/RedBearAK/toshy,
# by RedBearAK. Toshy's config is based on Kinto's, https://github.com/rbreaves/kinto, by Ben
# Reaves. Like Toshy, this file is under the GNU General Public License, version 3.
#
# Don't edit it: run the script again.

[All applications]
# Wordwise - not vscode
Super+Left = Ctrl+Left
Super+Right = Ctrl+Right
Shift+Super+Left = Ctrl+Shift+Left
Shift+Super+Right = Ctrl+Shift+Right
Shift+Super+G = Ctrl+Shift+G
# Cmd+Dot not in terminals
Alt+period = Escape
# GenGUI overrides: not Chromebook
Super+BackSpace = Ctrl+BackSpace
# General GUI
Alt+Shift+bracketleft = Ctrl+Page_Up
Alt+Shift+bracketright = Ctrl+Page_Down
Alt+space = Alt+F1
Alt+F3 = Super+D
Ctrl+Alt+F = Alt+F10
Alt+Q = Alt+F4
Super+Tab = nothing
Alt+H = nothing
Super+Return = Insert
Ctrl+A = Home
Ctrl+E = End
Ctrl+B = Left
Ctrl+F = Right
Ctrl+N = Down
Ctrl+P = Up
Ctrl+K = Shift+End, BackSpace
Ctrl+D = Delete
Alt+Left = Home
Alt+Right = End
Alt+Up = Ctrl+Home
Alt+Down = Ctrl+End
Alt+Shift+Left = Shift+Home
Alt+Shift+Right = Shift+End
Alt+Shift+Up = Ctrl+Shift+Home
Alt+Shift+Down = Ctrl+Shift+End
Shift+Super+BackSpace = Ctrl+BackSpace
Shift+Super+Delete = Ctrl+Delete
Super+Delete = Ctrl+Delete
Alt+BackSpace = Shift+Home, BackSpace
# Cmd as Ctrl
Alt+A = Ctrl+A
Alt+Shift+A = Ctrl+Shift+A
