# name: macOS (Mac keyboard)
# macOS's shortcuts on a Mac keyboard, or one in its Mac mode: Cmd, which is Super, does what
# Ctrl does, Cmd+Right goes to the end of a line, Option, which is Alt, moves by words, and
# terminals, browsers and other apps have shortcuts of their own.
#
# Converted by tools/toshy-to-remaps from Toshy's default-toshy-config/toshy_config.py, at
# commit a07f6f69b0cac2d29eeb91d29d9a1128efb9bf09 of https://github.com/RedBearAK/toshy,
# by RedBearAK. Toshy's config is based on Kinto's, https://github.com/rbreaves/kinto, by Ben
# Reaves. Like Toshy, this file is under the GNU General Public License, version 3.
#
# Don't edit it: run the script again.

[All applications]
# Wordwise - not vscode
Alt+Left = Ctrl+Left
Alt+Right = Ctrl+Right
Alt+Shift+Left = Ctrl+Shift+Left
Alt+Shift+Right = Ctrl+Shift+Right
Alt+Shift+G = Ctrl+Shift+G
# Cmd+Dot not in terminals
Super+period = Escape
# GenGUI overrides: not Chromebook
Alt+BackSpace = Ctrl+BackSpace
# General GUI
Shift+Super+bracketleft = Ctrl+Page_Up
Shift+Super+bracketright = Ctrl+Page_Down
Super+space = Alt+F1
Super+F3 = Super+D
Ctrl+Super+F = Alt+F10
Super+Q = Alt+F4
Alt+Tab = nothing
Super+H = nothing
Alt+Return = Insert
Ctrl+A = Home
Ctrl+E = End
Ctrl+B = Left
Ctrl+F = Right
Ctrl+N = Down
Ctrl+P = Up
Ctrl+K = Shift+End, BackSpace
Ctrl+D = Delete
Super+Left = Home
Super+Right = End
Super+Up = Ctrl+Home
Super+Down = Ctrl+End
Shift+Super+Left = Shift+Home
Shift+Super+Right = Shift+End
Shift+Super+Up = Ctrl+Shift+Home
Shift+Super+Down = Ctrl+Shift+End
Alt+Shift+BackSpace = Ctrl+BackSpace
Alt+Shift+Delete = Ctrl+Delete
Alt+Delete = Ctrl+Delete
Super+BackSpace = Shift+Home, BackSpace
Ctrl+Super+F1 = Ctrl+Alt+F1
Ctrl+Super+F2 = Ctrl+Alt+F2
Ctrl+Super+F3 = Ctrl+Alt+F3
Ctrl+Super+F4 = Ctrl+Alt+F4
Ctrl+Super+F5 = Ctrl+Alt+F5
Ctrl+Super+F6 = Ctrl+Alt+F6
Ctrl+Super+F7 = Ctrl+Alt+F7
