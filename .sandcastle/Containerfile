# The sandbox the agents build Caminito in: Arch, with every package tools/check --deps
# installs, so the checks a ticket needs run as on the developer's machine. Built by
# `tools/sandcastle build-image`. The official archlinux image is x86_64 only; Menci's is built
# from Arch Linux ARM as well, so the sandbox is native on an Apple Silicon Mac.
FROM docker.io/menci/archlinuxarm:base-devel

# pacman's download sandbox needs Landlock, which the container doesn't give it.
RUN sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf

# tools/check --deps's list, and mate-panel for the applets' builds.
RUN pacman -Syu --noconfirm --needed git curl jq \
    gcc pkgconf rustup cargo-deny libxkbcommon pixman wayland dbus libcanberra \
    pango gdk-pixbuf2 meson gtk3 gtk4 xorg-server-xvfb xorg-xauth xorg-xwayland seatd \
    systemd-libs mesa libdisplay-info libinput gtk-session-lock mate-desktop pam pam_wrapper \
    nodejs npm desktop-file-utils python-dbusmock libnm mate-panel libxfce4windowing gtk-layer-shell gvfs \
  && pacman -Scc --noconfirm

# build-image sets these to the host user's UID and GID, and Docker runs the sandbox as that
# user, so the files the agent writes in the bind-mounted worktree are the host user's.
ARG AGENT_UID=1000
ARG AGENT_GID=1000
RUN groupadd -o -g $AGENT_GID agent && useradd -o -m -u $AGENT_UID -g $AGENT_GID -d /home/agent agent
USER ${AGENT_UID}:${AGENT_GID}

RUN rustup toolchain install stable --profile minimal --component rustfmt,clippy
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/home/agent/.local/bin:$PATH"

WORKDIR /home/agent
ENTRYPOINT ["sleep", "infinity"]
