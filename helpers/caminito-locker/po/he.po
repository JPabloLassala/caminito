msgid "%A, %B %e"
msgstr ""

msgid "You have the Caps Lock key on."
msgstr "מקש ה־Caps Lock לחוץ."

msgid "<span size=\"small\">%U on %h</span>"
msgstr "<span size=\"small\">%U ב־%h</span>"

msgid "_Switch User"
msgstr "_החלף משתמש"

msgid "_Log Out"
msgstr "_התנתק"

msgid "_Cancel"
msgstr "_ביטול"

msgid "_Unlock"
msgstr "_התחבר"

