[Applet Factory]
Id=CaminitoDockAppletFactory
InProcess=true
Location=@APPLET_LOCATION@
Name=Dock Applet Factory
Description=Caminito's Dock applet

[CaminitoDockApplet]
Name=Dock
Description=The programs that are running, and the ones you keep, in a row of icons
Icon=user-desktop
MateComponentId=OAFIID:Caminito_DockApplet;
Platforms=X11;Wayland;
