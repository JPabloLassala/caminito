+            policy.switch_list(SEAT, SwitchList::Windows),
+            [id(2), id(3), id(1), id(4)]
+        );
+    }
+}
+
+#[test]
+fn urgent_placement_start_still_lists_a_minimised_urgent_window_last() {
+    let mut policy = urgent_fourth(UrgentPlacement::Start);
+    policy.minimize(id(4));
+    assert_eq!(
+        policy.switch_list(SEAT, SwitchList::Windows),
+        [id(2), id(3), id(1), id(4)]
+    );
+}
