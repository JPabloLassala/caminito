{
  "name": "global-menu",
  "publisher": "caminito",
  "displayName": "Caminito Global Menu",
  "description": "Shows the editor's menu in the global menu applet of a Caminito Session.",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/JPabloLassala/camino"
  },
  "private": true,
  "engines": {
    "vscode": "^1.68.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test --test-concurrency=1 'test/**/*.test.mts'",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@jellybrick/dbus-next": "0.11.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.68.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
