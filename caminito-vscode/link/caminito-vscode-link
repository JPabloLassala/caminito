#!/bin/sh
# Links the global menu extension into each editor's built-in extensions directory, or
# unlinks it (ADR 0022). It's both distributions' (193): on Arch, the alpm hooks and the
# package's install script run it; on Debian, the package's maintainer scripts will, for its
# triggers too (204).
#
#   caminito-vscode-link link                 link in each of the six directories that holds an
#                                             editor's built-ins, and unlink from each that
#                                             holds nothing else, its editor gone
#   caminito-vscode-link unlink               remove the link from each of them
#   caminito-vscode-link unlink --targets     remove it only from the directories that the
#                                             paths on stdin, a hook's targets, lie in (Arch's)
#   caminito-vscode-link directories          print the six, from which the packages write
#                                             their hooks' and triggers' directories
#
# A path that holds anything but this package's own link is left alone, so a user's own link
# or copy survives. Neither package manager owns the links. CAMINITO_VSCODE_ROOT is put before
# each directory, for the tests (117).
set -eu

extension=/usr/share/caminito-vscode/global-menu
name=caminito.global-menu

# The one list of the editors' built-in directories: visual-studio-code-bin's (and Microsoft's
# .deb's), code's, vscodium-bin's, vscodium's, cursor-bin's, and VSCodium's .deb's.
directories() {
  cat <<'EOF'
/usr/share/code/resources/app/extensions
/usr/lib/code/extensions
/opt/vscodium-bin/resources/app/extensions
/usr/share/vscodium/resources/app/extensions
/usr/share/cursor/resources/app/extensions
/usr/share/codium/resources/app/extensions
EOF
}

root=${CAMINITO_VSCODE_ROOT:-}

make_link() {
  path=$root$1/$name
  if [ -L "$path" ] && [ "$(readlink "$path")" = "$extension" ]; then
    return
  fi
  if [ -e "$path" ] || [ -L "$path" ]; then
    echo "caminito-vscode-link: $path is not this package's, so it's left as it is" >&2
    return
  fi
  ln -s "$extension" "$path"
}

# Whether the directory holds anything but this package's link: an editor's built-ins. An
# editor's removal leaves the directory behind with the link alone in it, since dpkg won't
# remove a directory that isn't empty.
has_editor() {
  dir=$root$1
  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    if [ "$entry" != "$dir/$name" ] && { [ -e "$entry" ] || [ -L "$entry" ]; }; then
      return 0
    fi
  done
  return 1
}

remove_link() {
  path=$root$1/$name
  if [ -L "$path" ] && [ "$(readlink "$path")" = "$extension" ]; then
    rm "$path"
  fi
}

# The directories that one of a hook's targets on stdin lies in. pacman gives the targets with
# no leading slash, and a directory with a trailing one.
targeted() {
  targets=$(cat)
  directories | while read -r directory; do
    if printf '%s\n' "$targets" |
      awk -v prefix="${directory#/}/" 'index($0, prefix) == 1 { found = 1 } END { exit !found }'; then
      echo "$directory"
    fi
  done
}

case ${1-} in
link)
  directories | while read -r directory; do
    if [ ! -d "$root$directory" ]; then
      continue
    fi
    if has_editor "$directory"; then
      make_link "$directory"
    else
      remove_link "$directory"
    fi
  done
  ;;
unlink)
  if [ "${2-}" = --targets ]; then
    list=targeted
  else
    list=directories
  fi
  $list | while read -r directory; do
    remove_link "$directory"
  done
  ;;
directories)
  directories
  ;;
*)
  echo "usage: caminito-vscode-link link | unlink [--targets] | directories" >&2
  exit 2
  ;;
esac
